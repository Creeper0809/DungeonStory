  },
  "qualityCapCaveat": "0.50~0.90은 Editor 허용 범위, 현재 작성값은 전부0.75. 실제 적용은 확인되지 않았다.",
  "mechanics": {
    "initial": {
      "mode": "Manual",
      "maintenance": 100,
      "fault": 0
    },
    "condition": "C = clamp((M>=60 ? 1 : 0.45+0.55*M/60)*(1-0.65*F/100),0.1,1)",
    "assisted": "전원 공급 및 F<100일 때 작성 배율*C, 그 외 자동화 배율1",
    "automaticSubmittedWu": "작성 WU/시뮬레이션초*C*deltaTime; 실제 승인량과 별개",
    "maintenanceDrain": "작성 시간당 소모*clamp(이정표 정비 배율,0.1,1)*deltaTime/7.5",
    "faultIncrease": "감소 후 M<=25일 때 (25-M)*0.006*deltaTime, F는0~100",
    "idle": "비수동·전원 공급 상태면 주문/재료/출력 확인보다 앞서 정비 소모",
    "repairEligibility": "mode!=Manual && (M<85 || F>0.01)",
    "repairRemainingWu": "max(max(0,85-M),max(0,2*F))",
    "repairPerWu": {
      "maintenance": 1,
      "fault": -0.5
    },
    "repairMaterialCost": "자동화 정비 분기에서는 자재 소비 없음. 다른 수리 유형으로 확대하지 않음.",
    "save": "모드/M/F 저장, 복원 값 검증; 실제 저장왕복 미실행"
  },
