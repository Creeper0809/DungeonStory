{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DungeonStory V25 grounded narrative example",
  "type": "object",
  "required": ["exampleId", "scenarioFamilyId", "category", "profileId", "cultureStyleId", "factPacket", "motifPacket", "prompt", "chosen"],
  "properties": {
    "exampleId": { "type": "string", "minLength": 1 },
    "scenarioFamilyId": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "multi_perspective",
        "equipment_facility_skill_names",
        "character_records_monologues",
        "rumors_petitions_dialogue",
        "cliche_hallucination_corrections"
      ]
    },
    "profileId": { "type": "string", "minLength": 1 },
    "cultureStyleId": { "type": "string", "minLength": 1 },
    "factPacket": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["ref", "stableId", "text", "visibility"],
        "properties": {
          "ref": { "type": "string", "pattern": "^F[0-9]{2}$" },
          "stableId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "visibility": { "enum": ["speaker", "player", "public"] }
        },
        "additionalProperties": false
      }
    },
    "motifPacket": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["ref", "stableId", "text"],
        "properties": {
          "ref": { "type": "string", "pattern": "^M[0-9]{2}$" },
          "stableId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "prompt": { "type": "string", "minLength": 1 },
    "chosen": { "type": "string", "minLength": 1 },
    "rejected": { "type": "string" },
    "viewpointCharacterId": { "type": "string" },
    "eventId": { "type": "string" },
    "split": { "enum": ["sft_train", "preference_train", "held_out"] },
    "provenance": { "enum": ["rule_generated", "human_rewritten", "human_approved"] },
    "sourceAssetIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
