  m_SharedData: {fileID: 11400000, guid: e35a33f9183c68c4186aeb6d15ce08e8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1135955968
    m_Localized: "\uD544\uC694 \uC5F0\uAD6C \uB610\uB294 \uC2DC\uC124\uC774 \uC900\uBE44\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C: {0}, \uC2DC\uC124: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704704
    m_Localized: "\uC7A5\uBE44 \uC815\uC758\uB97C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704705
    m_Localized: "\uC7A5\uBE44 \uC778\uC2A4\uD134\uC2A4\uB97C \uCC3E\uC744 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704706
    m_Localized: "\uC7A5\uBE44 \uBD80\uD488\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704707
    m_Localized: "\uC7A5\uBE44 \uB610\uB294 \uBD80\uD488\uC744 \uCC3E\uC744 \uC218
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704708
    m_Localized: "\uAC10\uC815\uD560 \uC218 \uC788\uB294 \uBBF8\uD655\uC778 \uBD80\uD488\uC774
      \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704709
    m_Localized: "\uBCF5\uC6D0\uD560 \uC218 \uC788\uB294 \uBD84\uB9AC\uB41C \uAC10\uC815
      \uBD80\uD488\uC774 \uC544\uB2D9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704710
    m_Localized: "\uBCF5\uC6D0 \uC644\uB8CC\uB41C 4\uB4F1\uAE09 \uBD80\uD488\uB9CC
      \uC870\uC728\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704711
    m_Localized: "\uD574\uB2F9 \uC7A5\uBE44\uC5D0 \uBD80\uD488 \uC2AC\uB86F {0}\uC774(\uAC00)
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704712
    m_Localized: "\uBD80\uD488 \uC2AC\uB86F {0}\uC5D0 \uC81C\uAC70\uD560 \uBD80\uD488\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704713
    m_Localized: "\uBB34\uAE30\xB7\uBC29\uC5B4\uAD6C\xB7\uBC29\uD328 \uACC4\uC5F4\uC774
      \uAC19\uC740 \uC7A5\uBE44\uB07C\uB9AC\uB9CC \uACC4\uC2B9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704714
    m_Localized: "\uBD80\uD488\uACFC \uC7A5\uBE44\uC758 \uACF5\uACA9\xB7\uBC29\uC5B4
      \uACC4\uC5F4\uC774 \uC77C\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704715
    m_Localized: "\uC0C1\uD0DC 75% \uC774\uC0C1\uC758 \uBCF5\uC6D0\uB41C \uBD80\uD488\uB9CC
      \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704716
    m_Localized: "4\uB4F1\uAE09 \uBD80\uD488\uC740 \uB8EC \uC870\uC728\uC744 \uB9C8\uCCD0\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704717
    m_Localized: "\uC774\uBBF8 \uB2E4\uB978 \uC7A5\uBE44\uC5D0 \uC7A5\uCC29\uB41C
      \uBD80\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704718
    m_Localized: "\uC6D0\uBCF8 \uC7A5\uBE44\uC758 \uBD80\uD488\uC744 \uBA3C\uC800
      \uBAA8\uB450 \uC81C\uAC70\uD574\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704719
    m_Localized: "\uC120\uD0DD\uD55C \uC7A5\uBE44\uC5D0 \uC774\uBBF8 \uC9C4\uD589
      \uC911\uC778 \uACC4\uBCF4 \uC791\uC5C5\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704720
    m_Localized: "\uC9C0\uC5ED \uCD5C\uC885 \uBCF4\uC2A4\uC5D0\uAC8C \uC5BB\uC740
      \uACC4\uBCF4 \uC778\uC7A5\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704721
    m_Localized: "\uC9C4\uD589\uD560 \uACC4\uBCF4 \uC774\uC804 \uC791\uC5C5\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704722
    m_Localized: "\uACC4\uBCF4 \uC791\uC5C5\uC5D0 \uD544\uC694\uD55C \uC7A5\uBE44\uAC00
      \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704723
    m_Localized: "\uACC4\uBCF4 \uC778\uC7A5\uC774 \uC0AC\uB77C\uC838 \uC791\uC5C5\uC744
      \uC644\uB8CC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704724
    m_Localized: "\uC218\uC2B5\uD560 \uC801\uB300\uC801 \uC18C\uBB38\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704725
    m_Localized: "\uC601\uC5C5\uC77C\uC774 \uC2DC\uC791\uB41C \uB4A4 \uC2E4\uD589\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704726
    m_Localized: "Day {0}\uC5D0\uB294 \uC774\uBBF8 \uC18C\uBB38\uC744 \uC218\uC2B5\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704727
    m_Localized: "\uBA85\uC131\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4. \uBCF4\uC720
      {0} / \uD544\uC694 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704728
    m_Localized: "\uACE8\uB4DC\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4. \uBCF4\uC720
      {0} / \uD544\uC694 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704729
    m_Localized: "\uB2E4\uC74C \uCE68\uC785\uC5D0 \uC801\uC6A9\uD560 \uACF5\uD3EC
      \uBC29\uC5B4\uAC00 \uC774\uBBF8 \uC900\uBE44\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704730
    m_Localized: "\uACF5\uD3EC\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4. \uBCF4\uC720
      {0} / \uD544\uC694 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704731
    m_Localized: "\uC6D0\uC815\uC9C0 ID\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704732
    m_Localized: "\uC815\uCC30 \uB178\uB3D9\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.
      \uBCF4\uC720 {0} / \uD544\uC694 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704733
    m_Localized: "\uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uAE38\uC7A1\uC774 \uBD80\uC801\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704734
    m_Localized: "\uAC70\uC810\uC774 Day {0}\uC5D0 \uB9CC\uB8CC\uB418\uC5B4 \uACB0\uC81C\uB97C
      \uCDE8\uC18C\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704735
    m_Localized: "\uC678\uBD80 \uC601\uD5A5 \uACB0\uC81C\uAC00 \uC2B9\uC778\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704736
    m_Localized: "\uBC1C\uACAC\uB418\uC9C0 \uC54A\uC740 \uC6D0\uC815 \uB300\uC0C1\uC785\uB2C8\uB2E4:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704737
    m_Localized: "\uC6D0\uC815 \uC815\uBCF4 \uAD50\uD658 \uCCB4\uACC4\uAC00 \uC5F0\uACB0\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704738
    m_Localized: "\uC11C\uBE44\uC2A4\uAC00 \uD734\uC5C5 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704739
    m_Localized: "\uC11C\uBE44\uC2A4 \uACF5\uC815 ID\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704740
    m_Localized: "\uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uC11C\uBE44\uC2A4 \uC2DC\uC124\uC744
      \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704741
    m_Localized: "\uC11C\uBE44\uC2A4 \uC6A9\uB7C9\uC774 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704742
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC774\uBBF8 \uC9C4\uD589 \uC911\uC778
      \uC11C\uBE44\uC2A4 \uC138\uC158\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704743
    m_Localized: "\uACF5\uC815 {0}\uC5D0 {1} \uC6B4\uC601 \uACC4\uC57D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704744
    m_Localized: "\uD65C\uC131 \uC11C\uBE44\uC2A4 \uC138\uC158\uC744 \uCC3E\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704745
    m_Localized: "\uD604\uC7AC \uACC4\uC57D\uC5D0\uC11C \uB2E8\uACC4 {0}\uC744 \uC9C4\uD589\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704746
    m_Localized: "\uC11C\uBE44\uC2A4 \uC774\uC6A9\uC774 \uB05D\uB098\uAE30 \uC804\uC5D0\uB294
      \uACB0\uC81C\uB97C \uD655\uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704747
    m_Localized: "\uC2DC\uC124\uC774 \uC120\uD0DD\uD55C \uC6B4\uC601 \uBAA8\uB4DC\uB97C
      \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704748
    m_Localized: "\uAC19\uC740 \uBC29\uC5D0 \uC5F0\uACB0\uB41C \uD544\uC218 \uC2DC\uC124\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704749
    m_Localized: "\uBCF4\uC870 \uC2DC\uC124\uC5D0 \uC804\uB825\uC774 \uC5C6\uC2B5\uB2C8\uB2E4:
      {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704750
    m_Localized: "\uC218\uC220 \uB300\uC0C1\uC774 \uC720\uD6A8\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704751
    m_Localized: "\uC218\uC220 \uC808\uCC28\uB97C \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC808\uCC28: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704752
    m_Localized: "{0}\uC740(\uB294) \uC0DD\uBB3C \uC218\uC220 \uB300\uC2E0 \uC815\uBE44
      \uC808\uCC28\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704753
    m_Localized: "\uC9C0\uC815\uD55C \uC9D1\uB3C4\uC758\uB97C \uCC3E\uAC70\uB098
      \uBC30\uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC9D1\uB3C4\uC758: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704754
    m_Localized: "\uD658\uC790\uB294 \uC790\uC2E0\uC758 \uC218\uC220\uC744 \uC9D1\uB3C4\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704755
    m_Localized: "\uB300\uC0C1\uC5D0\uAC8C \uC774\uBBF8 \uC9C4\uD589 \uC911\uC778
      \uC218\uC220 \uC8FC\uBB38\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uB300\uC0C1: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704756
    m_Localized: "\uC218\uC220 \uC2DC\uC124\uC744 \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC2DC\uC124: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704757
    m_Localized: "\uC218\uC220 \uC2DC\uC124\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC2DC\uC124: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704758
    m_Localized: "\uC9C4\uD589 \uAC00\uB2A5\uD55C \uC218\uC220 \uC8FC\uBB38\uC744
      \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC8FC\uBB38: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704759
    m_Localized: "\uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uC7A5\uAE30 \uB610\uB294 \uBCF4\uC870
      \uBD80\uD488\uC744 \uC120\uD0DD\uD574\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704760
    m_Localized: "\uC120\uD0DD\uD55C \uBD80\uD488 \uC885\uB958\uAC00 \uC218\uC220
      \uC808\uCC28\uC640 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704761
    m_Localized: "\uC120\uD0DD\uD55C \uBD80\uD488\uC774 \uB300\uC0C1 \uD574\uBD80
      \uBD80\uC704\uC640 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704762
    m_Localized: "\uC774 \uC218\uC220\uC740 \uD574\uB2F9 \uB300\uC0C1 \uC885\uB958\uB97C
      \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704763
    m_Localized: "\uC774 \uC218\uC220\uC740 \uD574\uB2F9 \uD574\uBD80 \uACC4\uC5F4\uC744
      \uC9C0\uC6D0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uACC4\uC5F4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704764
    m_Localized: "\uC774 \uC218\uC220\uC740 \uD574\uB2F9 \uC885\uC871\uC744 \uC9C0\uC6D0\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC885\uC871: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704765
    m_Localized: "\uAD6C\uC131\uCCB4 \uB300\uC0C1\uC5D0\uB294 \uC815\uBE44 \uC808\uCC28\uAC00
      \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704766
    m_Localized: "\uAD6C\uC131\uCCB4 \uC815\uBE44 \uC808\uCC28\uB294 \uC0DD\uBB3C
      \uB300\uC0C1\uC5D0\uAC8C \uC801\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704767
    m_Localized: "\uB300\uC0C1 \uD574\uBD80 \uBD80\uC704\uB97C \uC120\uD0DD\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704768
    m_Localized: "\uC218\uC220 \uC5F0\uAD6C \uC0C1\uD0DC\uB97C \uD655\uC778\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704769
    m_Localized: "\uD544\uC694\uD55C \uC218\uC220 \uC5F0\uAD6C\uAC00 \uC644\uB8CC\uB418\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704770
    m_Localized: "\uC218\uC220 \uB300\uC0C1 \uC0AC\uCCB4 \uBB3C\uD488\uC744 \uCC3E\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC0AC\uCCB4: {0}"
