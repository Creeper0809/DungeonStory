      m_Items: []
  - m_Id: 1173704771
    m_Localized: "\uC0AC\uCCB4\uAC00 \uCD94\uCD9C\uC5D0 \uC0AC\uC6A9\uD560 \uC218
      \uC5C6\uC744 \uB9CC\uD07C \uBD80\uD328\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704772
    m_Localized: "\uB300\uC0C1 \uD574\uBD80 \uBD80\uC704\uB294 \uC774\uBBF8 \uCD94\uCD9C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
