      m_Items: []
  - m_Id: 1173704776
    m_Localized: "\uC9D1\uB3C4\uC758\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1173704777
    m_Localized: "\uC9D1\uB3C4 \uB2A5\uB825\uCE58\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4.
      \uB2A5\uB825\uCE58: {0}, \uD544\uC694: {1}, \uD604\uC7AC: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704778
    m_Localized: "\uC9D1\uB3C4 \uC219\uB828\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.
      \uD544\uC694: {0}, \uD604\uC7AC: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1173704779
    m_Localized: "\uD604\uC7AC \uC791\uC5C5\uC790\uB294 \uC218\uC220\uC744 \uC9D1\uB3C4\uD560
