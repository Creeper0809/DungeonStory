      m_Items: []
  - m_Id: 1173710102
    m_Localized: "\uBCF4\uD638\uC7A5\uBE44\uB97C \uCC29\uC6A9\uD574\uB3C4 \uC608\uC0C1
      \uD658\uACBD \uB178\uCD9C\uC774 \uC704\uAE09\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
