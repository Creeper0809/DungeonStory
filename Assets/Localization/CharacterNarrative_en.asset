  - m_Id: 418730017
    m_Localized: 'Plain field note: a short, clear sentence moving from place to
      action.'
    m_Metadata:
      m_Items: []
  - m_Id: 418730018
    m_Localized: 'Action-led note: lead with the action and express beginning or
      completion briskly.'
    m_Metadata:
      m_Items: []
  - m_Id: 418730019
    m_Localized: 'Movement-led note: connect heading, entering, and finishing naturally.'
    m_Metadata:
      m_Items: []
  - m_Id: 418730020
    m_Localized: 'Result-led note: lead with the change, then close with place and
      action.'
