    m_Metadata:
      m_Items: []
  - m_Id: 418730014
    m_Localized: "\uC7A0\uAE50 \uD5C8\uB465\uB304 \uB4A4 \uD0DC\uC5F0\uD55C \uCC99\uD558\uB294
      \uBC84\uB987."
    m_Metadata:
      m_Items: []
  - m_Id: 418730015
    m_Localized: "\uD55C \uBC15\uC790 \uBA48\uCE6B\uD588\uB2E4\uAC00 \uBA38\uC4F1\uD558\uAC8C
      \uB2E4\uC2DC \uB098\uC11C\uB294 \uBC18\uC751."
    m_Metadata:
      m_Items: []
  - m_Id: 418730016
    m_Localized: "\uB534\uC0DD\uAC01\uC5D0\uC11C \uD37C\uB729 \uAE68\uC5B4\uB098
      \uC6D0\uB798 \uD589\uB3D9\uC744 \uC787\uB294 \uBC18\uC804."
    m_Metadata:
      m_Items: []
  - m_Id: 418730017
    m_Localized: "\uB2F4\uBC31\uD55C \uD604\uC7A5 \uAE30\uB85D: \uC7A5\uC18C\uC5D0\uC11C
      \uD589\uB3D9\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294 \uC9E7\uACE0 \uB610\uB837\uD55C
      \uBB38\uC7A5."
    m_Metadata:
      m_Items: []
  - m_Id: 418730018
    m_Localized: "\uD589\uB3D9 \uC911\uC2EC \uAE30\uB85D: \uD589\uB3D9\uC744 \uBA3C\uC800
      \uAEBC\uB0B4\uACE0 \uCC29\uC218\xB7\uB05D\uB0C4\uC744 \uACBD\uCF8C\uD558\uAC8C
      \uD45C\uD604."
    m_Metadata:
      m_Items: []
  - m_Id: 418730019
    m_Localized: "\uC774\uB3D9\uAC10 \uC788\uB294 \uAE30\uB85D: \uD5A5\uD558\uB2E4\xB7\uB4E4\uC5B4\uAC00\uB2E4\xB7\uB9C8\uBB34\uB9AC\uD558\uB2E4\uB97C
      \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uC5F0\uACB0."
    m_Metadata:
      m_Items: []
  - m_Id: 418730020
    m_Localized: "\uACB0\uACFC \uC911\uC2EC \uAE30\uB85D: \uACB0\uACFC\uB098 \uBCC0\uD654\uB97C
      \uBA3C\uC800 \uC138\uC6B0\uACE0 \uB9C8\uC9C0\uB9C9\uC5D0 \uC7A5\uC18C\uC640
      \uD589\uB3D9\uC744 \uB9E4\uB4ED."
    m_Metadata:
      m_Items: []
  - m_Id: 418730021
    m_Localized: "{subject} \uB2F9\uC9C1\uD45C\uB97C \uD655\uC778\uD558\uACE0 \uC790\uB9AC\uB97C
      \uC7A1\uC558\uB2E4.\n{subject} \uBE44\uBC88\uC744 \uB9DE\uC544 \uAE34\uC7A5\uC744
      \uD480\uC5C8\uB2E4.\n{subject} \uB2E4\uC74C \uADFC\uBB34\uB97C \uC704\uD574
      \uC7A5\uBE44\uB97C \uCC59\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 418730022
    m_Localized: "{subject} {place}\uC5D0 \uB4E4\uC5B4\uAC00 \uC8FC\uBCC0\uC744 \uC0B4\uD3C8\uB2E4.\n{subject}
