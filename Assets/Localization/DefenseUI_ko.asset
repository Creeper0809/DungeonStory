      m_Items: []
  - m_Id: 401952827
    m_Localized: "\uBB34\uC7A5 \uC815\uCC45\uC744 \uBCC0\uACBD\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
