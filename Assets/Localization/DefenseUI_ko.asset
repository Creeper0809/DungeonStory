    m_Localized: "\uBC30\uC815\uD560 \uACBD\uBE44\uB97C \uCC3E\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952839
    m_Localized: "\uD604\uC7AC {0} / {1} / \uACBD\uBE44 \uC6B0\uC120\uC21C\uC704
