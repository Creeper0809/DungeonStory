    m_Metadata:
      m_Items: []
  - m_Id: 401952840
    m_Localized: "{0}: \uC815\uCC45 \uBC30\uC815 \uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 401952841
    m_Localized: "\uC815\uCC45\uC744 \uBC30\uC815\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952842
    m_Localized: "\uC9C1\uC6D0 {0}\uBA85 / \uBC30\uC815\uD560 \uC815\uCC45 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 401952843
    m_Localized: "\uB2F9\uC9C1 \uC911\uC774\uACE0 \uACBD\uBE44 \uC6B0\uC120\uC21C\uC704\uAC00
      \uCF1C\uC9C4 \uC9C1\uC6D0\uC5D0\uAC8C\uB9CC \uC801\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952844
    m_Localized: "\uD55C \uBC88 \uB354 \uB20C\uB7EC \uC0AD\uC81C\uB97C \uD655\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952845
    m_Localized: "\uBC30\uC815\uB41C \uACBD\uBE44\uB294 \uD45C\uC900 \uC815\uCC45\uC73C\uB85C
      \uC7AC\uBC30\uC815\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952846
    m_Localized: "\uD604\uC7AC \uC815\uCC45\uC744 \uC0C8 \uC0AC\uC6A9\uC790 \uC815\uCC45\uC73C\uB85C
      \uBCF5\uC81C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952847
    m_Localized: "\uC608\uBE44 \uACBD\uBE44\uAC00 \uC5C6\uC744 \uB54C \uC120\uB450
      \uACBD\uBE44\uC758 \uD589\uB3D9\uC744 \uACB0\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952848
    m_Localized: "\uD604\uC7AC \uAE30\uBCF8\uAC12\uC73C\uB85C \uC0AC\uC6A9\uC790
      \uC815\uCC45\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952849
    m_Localized: "0%\uB294 \uC790\uB3D9 \uD6C4\uD1F4 \uC5C6\uC74C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952850
    m_Localized: "\uD6C4\uD1F4\uD55C \uACBD\uBE44\uAC00 \uB2E4\uC2DC \uCD9C\uB3D9\uD560
      \uCD5C\uC18C \uCCB4\uB825\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 401952851
