      m_Items: []
  - m_Id: 552947771
    m_Localized: "{0}: \uD3C9\uC2DC \uB85C\uB4DC\uC544\uC6C3\uC73C\uB85C \uC804\uD658"
    m_Metadata:
      m_Items: []
  - m_Id: 552947772
    m_Localized: "\uD604\uC7AC \uC7A5\uBE44 \uC870\uD569\uC73C\uB85C\uB294 \uD574\uB2F9
      \uB85C\uB4DC\uC544\uC6C3\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 552947773
    m_Localized: "\uC7AC\uC7A5\uC804\uD560 \uD65C\uC131 \uBB34\uAE30\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 552947774
    m_Localized: "\uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uC0AC\uACA9 \uBAA8\uB4DC\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 552947775
    m_Localized: "\uAD50\uCCB4\uD560 \uC18C\uC9C0 \uBB34\uAE30\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 552947776
    m_Localized: "\uC218\uB9AC\uAC00 \uD544\uC694\uD55C \uBC29\uC5B4\uAD6C\uB098
