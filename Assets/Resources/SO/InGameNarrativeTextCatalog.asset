    inGameDescription: "\ube0c\ub9ac\uac04\ub518 \uc548\uac10\uc744 \uc7a5\ube44 \uc548\ucabd\uc5d0 \ub367\ub300 \ucda9\uaca9\uacfc \ub9c8\ucc30\uc774 \ucc29\uc6a9\uc790\uc5d0\uac8c \ubc14\ub85c \ub2ff\uc9c0 \uc54a\uac8c \ud55c\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \ube0c\ub9ac\uac04\ub518 \uc548\uac10\uc5d0\ub294 \uc218\uc120\ud560 \uba74\uacfc \uad50\uccb4\ud560 \ubc29\ud5a5\uc744 \uac00\ub9ac\ud0a4\ub294 \uc9e7\uc740 \uc0c9\uc2e4\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:climate-control-manifold
    inGameDescription: "\uae30\ud6c4 \uc81c\uc5b4 \ub9e4\ub2c8\ud3f4\ub4dc\ub294 \ubcf5\uc7a1\ud55c \uc124\ube44\uc758 \uc791\ub3d9 \uc21c\uc11c\uc640 \ud750\ub984\uc744 \ub9e1\ub294 \ud575\uc2ec \uc870\ub9bd\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \uae30\ud6c4 \uc81c\uc5b4 \ub9e4\ub2c8\ud3f4\ub4dc\ub97c \ub07c\uc6b0\uae30 \uc804 \uc790\uae30 \uae30\uc5b5\ud310\uacfc \ub9de\ub2ff\ub294 \uba74\uc744 \uc9c1\uc811 \ub2e6\ub294\ub2e4."
