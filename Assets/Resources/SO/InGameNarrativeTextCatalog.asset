    inGameDescription: "\uc0c1\uc218 \ud0f1\ud06c\uc5d0 \ubb3c\uc744 \ubaa8\uc544 \ub450\uace0 \ud544\uc694\ud55c \uacf3\uc73c\ub85c \ub0b4\ubcf4\ub0b4\ub294 \uc124\ube44\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9818
    inGameDescription: "\uc624\uc218 \ud0f1\ud06c\uc5d0 \ubb3c\uc744 \ubaa8\uc544 \ub450\uace0 \ud544\uc694\ud55c \uacf3\uc73c\ub85c \ub0b4\ubcf4\ub0b4\ub294 \uc124\ube44\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9819
    inGameDescription: "\ubb3c\ud1b5 \ucda9\uc804\uc18c\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9820
    inGameDescription: "\uc624\uc218 \uce68\uc804\uc870\uc5d0\uc11c \uc624\uc218\ub97c \uac78\ub7ec \ub2e4\uc2dc \uc4f0\uac70\ub098 \uc548\uc804\ud558\uac8c \ubc30\ucd9c\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9821
    inGameDescription: "\uc18c\ub3c5 \uc815\uc218\uae30\uc5d0\uc11c \uc624\uc218\ub97c \uac78\ub7ec \ub2e4\uc2dc \uc4f0\uac70\ub098 \uc548\uc804\ud558\uac8c \ubc30\ucd9c\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc18c\ub3c5 \uc815\uc218\uae30\uc5d0\uc11c \uac70\ub978 \ubb3c\uc740 \uae68\ub057\ud558\uba74 \ucd08\ub85d \ud3ec\uc790\ub9c9\uc774 \ud53c\uace0, \uc624\uc5fc\uc774 \ub0a8\uc73c\uba74 \uac80\uac8c \uac00\ub77c\uc549\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9822
    inGameDescription: "\ub8ec \uc815\ud654 \uc2dc\uc124\uc5d0\uc11c \uc624\uc218\ub97c \uac78\ub7ec \ub2e4\uc2dc \uc4f0\uac70\ub098 \uc548\uc804\ud558\uac8c \ubc30\ucd9c\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub8ec \uc815\ud654 \uc2dc\uc124\uc758 \uc30d\uc778\uc7a5\uc740 \ub9c8\ub098\ub97c \ub304 \uc0ac\ub78c\uacfc \uc4f0\ub294 \uc0ac\ub78c\uc758 \uc190 \ubaa8\uc591\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9823
    inGameDescription: "\ud750\ub974\ub294 \ubb3c\ub85c \ubab8\uc758 \uc624\uc5fc\uc744 \uc53b\uace0 \uc704\uc0dd\uc744 \ud68c\ubcf5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc0e4\uc6cc \uc2dc\uc124 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9824
    inGameDescription: "\uc804\uae30 \uc544\ud06c\ub4f1\uc5d0\uc11c \ube5b\uc744 \ub0b4 \ud1b5\ub85c\uc640 \uc791\uc5c5 \uacf5\uac04\uc744 \ubc1d\ud788\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9825
    inGameDescription: "\uc804\uae30 \uc81c\ub828 \ub3c4\uac00\ub2c8\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c \uc8fc\ubbfc\uc740 \uc804\uae30 \uc81c\ub828 \ub3c4\uac00\ub2c8\ub97c \uc5b4\ub290 \ud55c \ub3c4\uc2dc\uc758 \uc18c\uc720\ub85c \ub450\uc9c0 \uc54a\uace0 \uc815\ube44 \uad50\ub300\ub97c \ub098\ub220 \ub9e1\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9826
    inGameDescription: "\ub8ec \uc870\uc728\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc2dd \ub8ec \uc870\uc728\uc2e4\uc5d0\ub294 \uc0ac\uc6a9 \uae30\ud55c\uc774 \uc9c0\ub098\uba74 \uc2a4\uc2a4\ub85c \ud480\ub9ac\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9827
    inGameDescription: "\uacc4\ubcf4 \uae30\ub85d\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9840
    inGameDescription: "\ucee8\ubca0\uc774\uc5b4 \uc6b0\ud5a5\uc744 \ub530\ub77c \uc7ac\ub8cc\uc640 \uc644\uc131\ud488\uc744 \ub2e4\uc74c \uc124\ube44\ub85c \ubcf4\ub0b4\ub294 \uc6b4\ubc18 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
