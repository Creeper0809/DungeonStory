    inGameDescription: "\ub545\uc5d0 \uc138\uc6cc \uc0ac\uc218\uc640 \uc7a5\uc804\uc218\ub97c \uac00\ub9b4 \uc218 \uc788\ub294 \ub113\uace0 \uae34 \ubc29\ud328\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc624\ud06c\ub294 \ubb34\uae30 \ucca0\uc57c\uc5d0 \ud30c\ube44\uc2a4\ub97c \ubc84\ub9ac\uae30 \uc804 \ud760\uc9d1\uc744 \uc190\ub05d\uc73c\ub85c \uc9da\uc73c\uba70 \ub9c8\uc9c0\ub9c9 \uc8fc\uc778\uc758 \uc2f8\uc6c0\uc744 \ub4e4\ub824\uc900\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:shield:powered
    inGameDescription: "\uad6c\ub3d9 \uc7a5\uce58\uac00 \ubc29\ud328\uba74\uc744 \ubc00\uc5b4 \uc8fc\uc5b4 \ud070 \ucda9\uaca9\uc744 \ubc84\ud2f0\uac8c \ud558\ub294 \ub3d9\ub825 \ubc29\ud328\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc81c \ub3d9\ub825 \ubc29\ud328\uc758 \uc791\uc740 \ud648\uc740 \ubab8\uc744 \ubc14\uafc0 \ub54c \ub9de\ucd94\ub294 \uc218\ub9ac \ub208\uae08\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:shield:rune
    inGameDescription: "\ubc29\ud328\uba74\uc5d0 \uc218\ud638 \ub8ec\uc744 \uc0c8\uaca8 \ub9c8\ub098\uac00 \ud750\ub974\ub294 \uacf5\uaca9\uae4c\uc9c0 \ubc1b\uc544 \ub0b4\ub294 \ubc29\ud328\ub2e4. \ud2b9\ud788 \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub8ec \ubc29\ud328\uc5d0\ub294 \ub9c8\ub098\uac00 \uc0c8\uba74 \uba3c\uc800 \ub04a\uc5b4\uc9c0\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uac10\uaca8 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:shield:tower
    inGameDescription: "\ubab8 \ub300\ubd80\ubd84\uc744 \uac00\ub9ac\uace0 \uc881\uc740 \ud1b5\ub85c\uc5d0 \uc804\uc5f4\uc744 \uc138\uc6b0\ub294 \ub300\ud615 \ubc29\ud328\ub2e4. \ud558\ub974\ub098\ud06c \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c \uc774\ub984\uc744 \uc5bb\uc740 \ub300\ud615 \ubc29\ud328\ub294 \uc0c8 \uc8fc\uc778\uc774 \ub4e4\uc5b4\ub3c4 \uc61b \ud760\uc9d1\uc744 \uac08\uc544\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:shield:wood
    inGameDescription: "\uc5ec\ub7ec \uc7a5\uc758 \ud310\uc790\ub97c \uacb0 \ubc29\ud5a5\uc774 \uc5c7\uac08\ub9ac\uac8c \ubb36\uc740 \uac00\ubcbc\uc6b4 \uae30\ubcf8 \ubc29\ud328\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c \uace0\uce5c \ub098\ubb34 \ubc29\ud328 \uc548\ucabd\uc5d0\ub294 \uc774\uc804 \uc8fc\uc778\uc758 \ud45c\uc2dd\uacfc \ub2e4\uc74c \ud589\uc120\uc9c0\uac00 \uacb9\uccd0 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:arquebus
    inGameDescription: "\ubc1b\uce68 \uc5c6\uc774 \uc6b4\uc6a9\ud560 \uc218 \uc788\uac8c \uc904\uc778 \ud654\uc2b9\uc2dd \uc7a5\ucd1d\uc73c\ub85c, \ud0c4\uc885\uc744 \ubc14\uafd4 \uc5ec\ub7ec \uc0c1\ud669\uc5d0 \ub300\uc751\ud55c\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \uc544\ucffc\ubc84\uc2a4\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:blacksteel-poleaxe
    inGameDescription: "\ud751\uac15 \ub0a0\uacfc \ub9dd\uce58\uba74\uc744 \ud55c \uc790\ub8e8\uc5d0 \ub2e8 \uc7a5\ubcd1\uae30\ub85c, \uac11\uc637 \ud2c8\uacfc \ub2e8\ub2e8\ud55c \ud45c\uba74\uc744 \ud568\uaed8 \ub178\ub9b0\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ud751\uac15 \ud3f4\uc561\uc2a4\uc5d0\ub294 \ucda9\uaca9 \uc2dc\ud5d8 \uc790\uad6d\uc744 \uc77c\ubd80\ub7ec \ub0a8\uae34\ub2e4. \ud760\uc9d1\uc774 \uc5c6\ub294 \ubb3c\uac74\uc740 \uc544\uc9c1 \uac80\uc0ac\ub97c \ub9c8\uce58\uc9c0 \ubabb\ud55c \uac83\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:composite-bow
    inGameDescription: "\uc11c\ub85c \ub2e4\ub978 \ud0c4\uc131 \uc7ac\ub8cc\ub97c \uacb9\uccd0 \uc9e7\uc740 \ud65c\ubab8\uc5d0\uc11c\ub3c4 \uac15\ud55c \uc7a5\ub825\uc744 \ub0b4\ub294 \ud65c\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c \uc0ac\uc218\ub294 \ubcf5\ud569\uad81\uc744 \uc3d8\uae30 \uc804 \ubc14\ub78c\uc758 \ubc29\ud5a5\uc744 \uc9e7\uac8c \ub178\ub798\ud55c\ub2e4. \ub9c8\uc9c0\ub9c9 \uc74c\uc774 \ubc1c\uc0ac \uc2e0\ud638\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:crossbow
    inGameDescription: "\uc2dc\uc704\uac00 \uac78\ub9b0 \uc0c1\ud0dc\ub85c \uc870\uc900\ud560 \uc218 \uc788\uc5b4 \uc219\ub828\uc774 \ub0ae\uc544\ub3c4 \uc77c\uc815\ud55c \uc0ac\uaca9\uc744 \ub0b4\ub294 \uc1e0\ub1cc\ub2e4. \ud06c\ub9ad \uc81c7\uad74 \uacbd\ube44\ub294 \uc11d\uad81\uc744 \ubcbd\uc5d0 \uae30\ub300\uc9c0 \uc54a\uace0\ub3c4 \ub2e4\uc2dc \uac10\uc744 \uc218 \uc788\uc5b4\uc57c \uad11\uc0b0\uc6a9\uc73c\ub85c \uc778\uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:dagger
    inGameDescription: "\uc881\uc740 \ud1b5\ub85c\uc640 \ubab8\uc2f8\uc6c0\uc5d0\uc11c \ube60\ub974\uac8c \ucc0c\ub97c \uc218 \uc788\ub294 \ud55c\uc190 \ub2e8\uac80\uc774\ub2e4. \ud558\ub974\ub098\ud06c \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c \uc774\ub984\uc744 \uc5bb\uc740 \ub2e8\uac80\uc740 \uc0c8 \uc8fc\uc778\uc774 \ub4e4\uc5b4\ub3c4 \uc61b \ud760\uc9d1\uc744 \uac08\uc544\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:estoc
    inGameDescription: "\ub450\uaebc\uc6b4 \uac11\uc637\uc758 \ud2c8\uc744 \ucc0c\ub974\ub3c4\ub85d \uac00\ub298\uace0 \ub2e8\ub2e8\ud558\uac8c \ubcbc\ub9b0 \uc7a5\uac80\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc624\ud06c\ub294 \ubb34\uae30 \ucca0\uc57c\uc5d0 \uc5d0\uc2a4\ud130\ud06c\ub97c \ubc84\ub9ac\uae30 \uc804 \ud760\uc9d1\uc744 \uc190\ub05d\uc73c\ub85c \uc9da\uc73c\uba70 \ub9c8\uc9c0\ub9c9 \uc8fc\uc778\uc758 \uc2f8\uc6c0\uc744 \ub4e4\ub824\uc900\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:falchion
    inGameDescription: "\uc55e\ucabd\uc5d0 \ubb34\uac8c\uac00 \uc2e4\ub9b0 \ub113\uc740 \ub0a0\ub85c \uae4a\uc740 \ubca0\uae30\ub97c \ub0b4\ub294 \ud55c\uc190 \ub3c4\uac80\uc774\ub2e4. \ud558\ub974\ub098\ud06c \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c \uc774\ub984\uc744 \uc5bb\uc740 \ud314\uc2dc\uc628\uc740 \uc0c8 \uc8fc\uc778\uc774 \ub4e4\uc5b4\ub3c4 \uc61b \ud760\uc9d1\uc744 \uac08\uc544\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:greatsword
    inGameDescription: "\ub113\uc740 \uacf5\uac04\uc5d0\uc11c \uc591\uc190\uc73c\ub85c \ud718\ub458\ub7ec \uc804\uc5f4\uc744 \ubc00\uc5b4\ub0b4\ub294 \ub300\ud615 \ub3c4\uac80\uc774\ub2e4. \ud558\ub974\ub098\ud06c \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c \uc774\ub984\uc744 \uc5bb\uc740 \ub300\uac80\uc740 \uc0c8 \uc8fc\uc778\uc774 \ub4e4\uc5b4\ub3c4 \uc61b \ud760\uc9d1\uc744 \uac08\uc544\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:halberd
    inGameDescription: "\ub3c4\ub07c\ub0a0\uacfc \uac08\uace0\ub9ac, \ucc3d\ub05d\uc744 \ud55c \uc790\ub8e8\uc5d0 \ubb36\uc5b4 \uc804\uc5f4\uc744 \ubd99\uc7a1\uace0 \ucc0c\ub974\ub294 \uc7a5\ubcd1\uae30\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \ud560\ubc84\ub4dc\ub97c \uc218\ub9ac\ud560 \ub54c \uac89\ud310\ubcf4\ub2e4 \uc548\ucabd \uae30\uc5b5\ud310\uc744 \uba3c\uc800 \ub5bc\uc5b4 \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:handgonne
    inGameDescription: "\uc9e7\uc740 \uae08\uc18d \ucd1d\uc2e0\uc5d0 \ud654\uc57d\uc744 \ub2e4\uc838 \ub123\uace0 \uc190\uc73c\ub85c \ubc1b\uccd0 \uc3d8\ub294 \ucd08\uae30 \ud654\uae30\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \uc218\ucd1d\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:heavy-matchlock
    inGameDescription: "\ubb34\uac70\uc6b4 \ucd1d\uc2e0\uacfc \ud070 \ud654\uc57d\ub7c9\uc73c\ub85c \ub2e8\ub2e8\ud55c \ud45c\uc801\uc744 \ub178\ub9ac\ub294 \ud654\uc2b9\ucd1d\uc774\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \uc911\ud654\uc2b9\ucd1d\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:javelin
    inGameDescription: "\ub2ec\ub824\ub4dc\ub294 \uc801\uc5d0\uac8c \ub358\uc9c0\uac70\ub098 \uac00\uae4c\uc774\uc11c \ucc0c\ub97c \uc218 \uc788\uac8c \uac00\ubccd\uac8c \ub9cc\ub4e0 \ucc3d\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c \uc0ac\uc218\ub294 \ud22c\ucc3d\uc744 \uc3d8\uae30 \uc804 \ubc14\ub78c\uc758 \ubc29\ud5a5\uc744 \uc9e7\uac8c \ub178\ub798\ud55c\ub2e4. \ub9c8\uc9c0\ub9c9 \uc74c\uc774 \ubc1c\uc0ac \uc2e0\ud638\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:longbow
    inGameDescription: "\uae34 \ud65c\ubab8\uc758 \uc7a5\ub825\uc744 \uc628\ubab8\uc73c\ub85c \ub2f9\uaca8 \uba3c \uac70\ub9ac\uae4c\uc9c0 \ud654\uc0b4\uc744 \ubcf4\ub0b4\ub294 \uc591\uc190 \ud65c\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud478\ub978 \uae43\ub9e4\ub4ed\uc740 \uc7a5\uad81\uc774 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \ubc84\ud17c\ub2e4\ub294 \ud45c\uc2dc\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:longsword
    inGameDescription: "\ubca0\uae30\uc640 \ucc0c\ub974\uae30\ub97c \ubaa8\ub450 \ub2e4\ub8f0 \uc218 \uc788\ub3c4\ub85d \uade0\ud615\uc744 \uc7a1\uc740 \uc591\uc190 \uc7a5\uac80\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ubb34\uae30 \ucca0\uc57c\ub97c \uc9c0\ub0b8 \uc7a5\uac80\uc5d0\ub294 \uc0b4\uc544 \ub3cc\uc544\uc628 \uc2f8\uc6c0\ub9c8\ub2e4 \uc595\uc740 \ud760\uc9d1\uc774 \ud558\ub098\uc529 \ub354\ud574\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:mace
    inGameDescription: "\ub0a0 \ub300\uc2e0 \ubb34\uac70\uc6b4 \uba38\ub9ac\ub85c \ucda9\uaca9\uc744 \uc9d1\uc911\ud574 \uac11\uc637 \uc704\ub97c \ub450\ub4dc\ub9ac\ub294 \ud55c\uc190 \ubb34\uae30\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc81c \ucca0\ud1f4\uc758 \uc791\uc740 \ud648\uc740 \ubab8\uc744 \ubc14\uafc0 \ub54c \ub9de\ucd94\ub294 \uc218\ub9ac \ub208\uae08\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:mana-lance
    inGameDescription: "\ub9c8\ub098 \ub3c4\uccb4\ub97c \ucc3d\ub0a0\uae4c\uc9c0 \uc774\uc5b4 \ucc0c\ub974\ub294 \uc21c\uac04 \ud798\uc744 \ubaa8\uc73c\ub294 \uc7a5\ucc3d\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub294 \ub9c8\ub098 \ub79c\uc2a4\uc758 \ub9c8\ub098\uac00 \ub9c8\ub97c \ub54c\uae4c\uc9c0 \uacc4\uc57d\uc790\uc758 \uadf8\ub9bc\uc790\uac00 \ub0a0\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\uc9c0 \uc54a\ub294\ub2e4\uace0 \ub9d0\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:matchlock-long-gun
    inGameDescription: "\uae34 \ucd1d\uc2e0\uacfc \ud654\uc2b9 \uc7a5\uce58\ub85c \uba3c \ud45c\uc801\uc744 \uaca8\ub204\ub294 \ubcf4\ubcd1\uc6a9 \ud654\uae30\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \ud654\uc2b9 \uc7a5\ucd1d\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
