  - kind: 0
    stableId: facility-kit:9850
    inGameDescription: "\uce35\uac04 \ubb3c\ub958 \ub9ac\ud504\ud2b8\ub97c \ub530\ub77c \uc7ac\ub8cc\uc640 \uc644\uc131\ud488\uc744 \ub2e4\uc74c \uc124\ube44\ub85c \ubcf4\ub0b4\ub294 \uc6b4\ubc18 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9851
    inGameDescription: "\uc624\ubc84\ud50c\ub85c \ubc30\ucd9c \uac8c\uc774\ud2b8\ub97c \ub530\ub77c \uc7ac\ub8cc\uc640 \uc644\uc131\ud488\uc744 \ub2e4\uc74c \uc124\ube44\ub85c \ubcf4\ub0b4\ub294 \uc6b4\ubc18 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9852
    inGameDescription: "\uace0\uc18d \ucee8\ubca0\uc774\uc5b4\ub97c \ub530\ub77c \uc7ac\ub8cc\uc640 \uc644\uc131\ud488\uc744 \ub2e4\uc74c \uc124\ube44\ub85c \ubcf4\ub0b4\ub294 \uc6b4\ubc18 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9860
    inGameDescription: "\uc790\ub3d9\ud654 \uc81c\uc5b4\ubc18\uc740 \uc5f0\uacb0\ub41c \uc124\ube44\uc758 \uc791\ub3d9 \uc21c\uc11c\uc640 \uc815\uc9c0 \uc870\uac74\uc744 \ud55c\uacf3\uc5d0\uc11c \uc870\uc815\ud558\ub294 \uc2dc\uc124\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc81c\uc5b4\ubc18\uc740 \ubc1c\ud1b1\uacfc \uc7a5\uac11 \ub080 \uc190\uc73c\ub85c\ub3c4 \ub204\ub97c \uc218 \uc788\ub294 \uc2a4\uc704\uce58\uc640 \uc0c9\u00b7\uc18c\ub9ac\ub97c \ud568\uaed8 \uc4f0\ub294 \uacbd\ubcf4\ub97c \uac16\ucd98\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9961
    inGameDescription: "\uae08\uace0\uac01\uc778 \uc1e0\ub1cc\ub300\ub85c \uce68\uc785 \uacbd\ub85c\ub97c \ub9c9\uace0 \ubc29\uc5b4\uc120\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: feed:dog-food
    inGameDescription: "\uace1\ubb3c\uc5d0 \ub3d9\ubb3c\uc131 \ubd80\uc0b0\ubb3c\uc744 \uc11e\uc5b4 \uc721\uc2dd\uacfc \uc7a1\uc2dd \ub3d9\ubb3c\uc774 \ud568\uaed8 \uba39\ub3c4\ub85d \ub9cc\ub4e0 \uc0ac\ub8cc\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc6b4\uc1a1\ub300\ub294 \ub0a8\uc740 \uac1c\ubc25\uc73c\ub85c \ub2e4\uc74c \uc57c\uc601\uc9c0\uae4c\uc9c0 \uac08 \uc218 \uc788\ub294 \uac70\ub9ac\ub97c \uac00\ub2a0\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: feed:dog-food-fresh
    inGameDescription: "\uc0dd\uace0\uae30\uc640 \uace1\ubb3c\uc744 \ubc14\ub85c \uc11e\uc5b4 \ubcf4\uc874\uc131\ubcf4\ub2e4 \uc2e0\uc120\ud55c \ub0c4\uc0c8\uc640 \uc2dd\uac10\uc744 \uc0b4\ub9b0 \uc0ac\ub8cc\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc2e0\uc120 \uac1c\ubc25\uc740 \ub2e4\uce5c \uc0ac\ub0e5\uac1c\uc640 \uc0c8\ub07c\uc5d0\uac8c \uba3c\uc800 \ub3cc\uc544\uac00\uba70, \ud574\uac00 \uc9c0\uae30 \uc804\uc5d0 \ubaa8\ub450 \uba39\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: feed:hay
    inGameDescription: "\ud480\uc744 \ucda9\ubd84\ud788 \ub9d0\ub824 \ucd08\uc2dd\ub3d9\ubb3c\uc774 \uc0ac\uacc4\uc808 \uba39\uc744 \uc218 \uc788\uac8c \uc313\uc544 \ub454 \uae30\ubcf8 \uc0ac\ub8cc\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \ubaa9\uc7a5\uc740 \ube44\uac00 \uc801\uc740 \ucca0\uc5d0 \ubca4 \ud480\uc744 \uac74\ucd08 \uc0ac\ub8cc\ub85c \ub9d0\ub824 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc9d0\uc2b9\uae4c\uc9c0 \uba39\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: feed:silage
    inGameDescription: "\ud480\uacfc \uc78e\uc744 \ub20c\ub7ec \ub2f4\uc544 \ubc1c\ud6a8\uc2dc\ucf1c \uac74\ucd08\uac00 \ubd80\uc871\ud55c \uacc4\uc808\uc5d0 \uaebc\ub0b4\ub294 \uc0ac\ub8cc\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \ubaa9\uc7a5\uc740 \uc7a5\ub9c8\ucca0 \ud480\uc744 \uc0ac\uc77c\ub9ac\uc9c0\ub85c \ub20c\ub7ec \ub2f4\uc544 \uaca8\uc6b8\uacfc \uac00\ub3c4 \ubd09\uc1c4\uc5d0 \ub300\ube44\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:cave-silk
    inGameDescription: "\ub3d9\uad74 \ube44\ub2e8\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ub3d9\uad74 \ube44\ub2e8 \uc6d0\uc12c\uc720\uc5d0\ub294 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \uacac\ub3a0\ub2e4\ub294 \ud478\ub978 \uae43\ub9e4\ub4ed\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:deep-goat-wool
    inGameDescription: "\uc2ec\uce35 \uc5fc\uc18c\ubaa8\uc9c1\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uaca8\uc6b8 \uc9c1\uc870\uc7a5\uc740 \uc2ec\uce35 \uc5fc\uc18c\ud138 \uc12c\uc720\ub97c \ub450\uaed8\ubcc4\ub85c \ub098\ub204\uace0, \ub208 \ub179\uc740 \ubb3c \ub0c4\uc0c8\uac00 \ube60\uc9c8 \ub54c\uae4c\uc9c0 \ubc14\ub78c\uc5d0 \ub9d0\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:ember-cotton
    inGameDescription: "\uc7bf\ubd88 \ubaa9\ud654\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uaca8\uc6b8 \uc9c1\uc870\uc7a5\uc740 \uc7bf\ubd88 \ubaa9\ud654 \uc12c\uc720\ub97c \ubd88\uc528 \uac00\uae4c\uc774\uc5d0 \ud3b4 \ub193\uace0 \uadf8\uc744\uc74c\uc774 \ubc88\uc9c0\ub294 \uc815\ub3c4\ub85c \uac74\uc870 \uc0c1\ud0dc\ub97c \uac00\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:frost-flax
    inGameDescription: "\uc11c\ub9ac \uc544\ub9c8\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0b0\uae30\uc2ad\uc758 \uc9c1\uc870\uac00\ub294 \uc11c\ub9ac \uc544\ub9c8 \uc6d0\uc12c\uc720\ub97c \uc5ec\ub7ec \uccb4\ud615\uc758 \uc637\uc73c\ub85c \uace0\uccd0 \uc4f0\ub3c4\ub85d \ud3ed\uacfc \ub298\uc5b4\ub098\ub294 \ubc29\ud5a5\uc744 \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:frost-wool
    inGameDescription: "\uc11c\ub9ac \uc591\ubaa8\uc9c1\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0b0\uae30\uc2ad\uc758 \uc9c1\uc870\uac00\ub294 \uc11c\ub9ac \uc591\ubaa8\uc9c1 \uc6d0\uc12c\uc720\ub97c \uc5ec\ub7ec \uccb4\ud615\uc758 \uc637\uc73c\ub85c \uace0\uccd0 \uc4f0\ub3c4\ub85d \ud3ed\uacfc \ub298\uc5b4\ub098\ub294 \ubc29\ud5a5\uc744 \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:mire-reed
    inGameDescription: "\uc2b5\uc9c0 \uac08\ub300\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc2b5\uc9c0 \uac08\ub300 \uc6d0\uc12c\uc720\ub294 \uc816\uc740 \ucc44 \ubb36\uc73c\uba74 \uc369\uae30 \ub54c\ubb38\uc5d0 \uac80\ubb38\uc18c\ub9c8\ub2e4 \ub9e4\ub4ed\uc744 \ud480\uc5b4 \uc18d\uae4c\uc9c0 \ub9d0\ub838\ub294\uc9c0 \ud655\uc778\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: fiber:spore-hemp
    inGameDescription: "\ud3ec\uc790 \uc0bc\uc5d0\uc11c \ubf51\uc544 \uc138\ucc99\ud55c \uc12c\uc720\ub2e4. \uc2e4\ub85c \uc7a3\uae30 \uc804\uae4c\uc9c0 \uc5c9\ud0b4\uacfc \uc624\uc5fc\uc744 \ud53c\ud574\uc11c \ubcf4\uad00\ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc9e7\uc544 \uc2e4\ub85c \uc7a3\uc9c0 \ubabb\ud55c \ud3ec\uc790 \uc0bc \uc12c\uc720\ub97c \uc7ac\ubc30\uc0c1 \ub36e\uac1c\ub85c \uc368 \uc218\ubd84\uc744 \uc9c0\ud0a8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:boar-stew
    inGameDescription: "\uba67\ub3fc\uc9c0 \uace0\uae30\uc640 \ubfcc\ub9ac\ucc44\uc18c\ub97c \uc624\ub798 \ub053\uc5ec \uad6d\ubb3c\uae4c\uc9c0 \ub4e0\ub4e0\ud558\uac8c \ub9cc\ub4e0 \uace0\uae09\uc2dd\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc5d0\uc11c\ub294 \uba67\ub3fc\uc9c0 \uc2a4\ud29c\uc758 \uc0b4\ucf54\uae30\uc640 \uad6d\ubb3c\uc744 \uc5b4\ub9b0 \uc8fc\ubbfc\uacfc \ubd80\uc0c1\uc790\uc5d0\uac8c \uba3c\uc800 \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:cheese-mushroom
    inGameDescription: "\ub3d9\uad74\ubc84\uc12f\uc5d0 \ub179\uc778 \uce58\uc988\ub97c \uacc1\ub4e4\uc5ec \ud5a5\uacfc \ud3ec\ub9cc\uac10\uc744 \uc0b4\ub9b0 \ucc44\uc2dd \uc694\ub9ac\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uce58\uc988\uac00 \uade0\uc0ac \ud5a5\uc744 \ub36e\uc9c0 \uc54a\ub3c4\ub85d \ubc84\uc12f\uac13 \uc548\ucabd\uc5d0\ub9cc \uc587\uac8c \ubd93\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:egg-pancake
    inGameDescription: "\uc54c\uacfc \uace1\ubb3c \ubc18\uc8fd\uc744 \ub113\uac8c \ubd80\uccd0 \ube60\ub974\uac8c \ub098\ub220 \uba39\uae30 \uc88b\uc740 \ucc44\uc2dd\uc2dd\uc774\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \ub2ec\uac40\uc804\uc740 \ub0b4\ud574 \ub18d\uac00\uac00 \uadf8\ub0a0 \uac70\ub454 \uc54c\uc744 \uc7a5\ub0a0 \uc804\uc5d0 \ub098\ub220 \uba39\ub294 \uc74c\uc2dd\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:expedition-ration-pack
    inGameDescription: "\uac77\ub294 \uc911\uc5d0\ub3c4 \uaebc\ub0b4 \uba39\uc744 \uc218 \uc788\ub3c4\ub85d \ubcf4\uc874\uc2dd\uacfc \uc791\uc740 \uc2dd\uae30\ub97c \ud55c \ub07c\uc529 \ubb36\uc740 \uc6d0\uc815 \uc2dd\ub7c9\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uadc0\ud658\uc790\uc758 \uc2dd\ud0c1\uc5d0\ub294 \uc6d0\uc815 \ubc30\uae09 \uafb8\ub7ec\ubbf8\uc758 \ube48 \ud3ec\uc7a5\ub3c4 \ub193\uc778\ub2e4. \ube48 \ud3ec\uc7a5 \ud558\ub098\uac00 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c \ud55c \ub07c\ub97c \ub73b\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:fermented-pickle
    inGameDescription: "\ucc44\uc18c\ub97c \uc18c\uae08\ubb3c\uc5d0 \uc0ad\ud600 \uc624\ub798 \ub450\uace0 \uba39\uc744 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc0c8\ucf64\ud55c \uc808\uc784\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ubc1c\ud6a8 \uc808\uc784\uc740 \uc624\ub798\ub41c \uc18c\uae08\ubb3c\uc744 \ub2e4\uc74c \ud56d\uc544\ub9ac\uc758 \ubc1c\ud6a8 \ubc11\ubb3c\ub85c \uc870\uae08\uc529 \uc774\uc5b4 \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:fresh-curd
    inGameDescription: "\uac13 \uad73\ud78c \uc751\uc720\ub97c \ubd80\ub4dc\ub7ec\uc6b4 \uc0c1\ud0dc\ub85c \ub2f4\uc544 \ub0b4\ub294 \uc2e0\uc120\ud55c \uc720\uc81c\ud488 \uc694\ub9ac\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \uc2e0\uc120 \uc751\uc720\uc2dd\uc740 \ub0b4\ud574 \ubaa9\uc7a5\uc758 \uc544\uce68 \uc6b0\uc720\uac00 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc5d0 \uc624\ub974\uae30 \uc804 \uba39\ub294 \uc74c\uc2dd\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:garden-meal
    inGameDescription: "\uace1\ubb3c\uacfc \ubfcc\ub9ac, \ubc84\uc12f\uc744 \ud568\uaed8 \uc870\ub9ac\ud574 \uc721\ub958 \uc5c6\uc774\ub3c4 \ud55c \ub07c\ub97c \ucc44\uc6b0\ub294 \uc815\uc6d0 \uc694\ub9ac\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uac19\uc740 \uc815\uc6d0\uc5d0\uc11c \uac70\ub454 \uc7ac\ub8cc\ub97c \ud55c \uadf8\ub987\uc5d0 \ub2f4\uc544 \uadf8\ub0a0 \uc815\uc6d0\uc758 \ub9db\uc744 \ud655\uc778\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:grain-porridge
    inGameDescription: "\ud669\ud63c\uace1\uc744 \ubb3c\uc5d0 \uc624\ub798 \ub053\uc5ec \uc7ac\ub8cc\uac00 \ubd80\uc871\ud55c \ub0a0\uc5d0\ub3c4 \uc18d \ud3b8\ud558\uac8c \uba39\ub294 \ubb3d\uc740 \uc8fd\uc774\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \ud669\ud63c\uace1\uc8fd\uc740 \uc218\ud655\uc77c \uc544\uce68\uc5d0 \ubc2d\uc77c\uafbc\uacfc \uac00\ub3c4 \uc9d0\uafbc\uc774 \ud568\uaed8 \uba39\ub294 \uccab \ub07c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:grape-syrup
    inGameDescription: "\ubc24\ud3ec\ub3c4 \uc999\uc744 \uc878\uc5ec \ub2e8\ub9db\uacfc \ud5a5\uc744 \ub18d\ucd95\ud55c \uc2dc\ub7fd\uc73c\ub85c, \uc74c\ub8cc\uc640 \ud6c4\uc2dd\uc5d0 \uacc1\ub4e4\uc778\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \ubc24\ud3ec\ub3c4\ub97c \uc7a5\uac70\ub9ac \uc6b4\uc1a1\ud558\ub824\uace0 \uc878\uc5ec \ub9cc\ub4e0 \uc800\uc7a5\uc2dd\uc5d0\uc11c \uc2dc\uc791\ub410\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:jerky
    inGameDescription: "\uace0\uae30\ub97c \uc587\uac8c \uc800\uba70 \ub9d0\ub9ac\uace0 \uac04\uc744 \ud574 \uc6d0\uc815 \uc911\uc5d0\ub3c4 \uc624\ub798 \ubcf4\uad00\ud560 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc721\ud3ec\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uadc0\ud658\uc790\uc758 \uc2dd\ud0c1\uc5d0\ub294 \uc721\ud3ec \ubb36\uc74c\ub3c4 \ub193\uc778\ub2e4. \ube48 \ud3ec\uc7a5 \ud558\ub098\uac00 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c \ud55c \ub07c\ub97c \ub73b\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:lavish-meat
    inGameDescription: "\uace0\uae30\uc640 \uc720\uc81c\ud488, \uacfc\uc77c\uc744 \uc544\ub07c\uc9c0 \uc54a\uace0 \ucc28\ub824 \uc190\ub2d8\uacfc \uc8fc\ubbfc\uc744 \ub300\uc811\ud558\ub294 \ud638\ud654\uc2dd\uc774\ub2e4. \ud558\ub974\ub098\ud06c \ubc24\uad81\uc815\uc758 \ud54f\ube5b \ud638\ud654\uc2dd\uc5d0\ub294 \ud53c\ub97c \ub0b4\uc900 \uc774\uc640 \ucd08\ub300\ud55c \uc190\ub2d8\uc758 \ub3d9\uc758\uc758 \uc794\uc774 \ub098\ub780\ud788 \ub193\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:lavish-vegan
    inGameDescription: "\uc11c\ub85c \ub2e4\ub978 \uc138 \uac00\uc9c0 \uc2dd\ubb3c \uc7ac\ub8cc\ub97c \uc5ec\ub7ec \uc870\ub9ac\ubc95\uc73c\ub85c \ucc28\ub824 \ub0b8 \ube44\uac74 \ub9cc\ucc2c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc6d4\uc57c \ube44\uac74 \ub9cc\ucc2c\uc740 \ud55c \uc7ac\ub8cc\ub3c4 \uac19\uc740 \ubc29\uc2dd\uc73c\ub85c \ub450 \ubc88 \uc870\ub9ac\ud558\uc9c0 \uc54a\uc544 \ubfcc\ub9ac\ubd80\ud130 \ud3ec\uc790\uae4c\uc9c0 \uc11c\ub85c \ub2e4\ub978 \uc2dd\uac10\uc744 \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:malt-porridge
    inGameDescription: "\ubd88\ub9b0 \ub9e5\uc544\ub97c \ubd80\ub4dc\ub7fd\uac8c \ub053\uc5ec \ub2e8\ub9db\uc744 \ub04c\uc5b4\ub0b8 \ub530\ub73b\ud55c \uc8fd\uc774\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \ub9e5\uc544\uc8fd\uc740 \uc2f9\uc774 \ub108\ubb34 \uae38\uac8c \ub09c \uace1\ubb3c\ub3c4 \ubc84\ub9ac\uc9c0 \uc54a\uc73c\ub824 \ub9cc\ub4e0 \ub18d\uac00 \uc74c\uc2dd\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:meat-pie
    inGameDescription: "\ub2e4\uc9c4 \uace0\uae30\uc640 \uc721\uc999\uc744 \ubc00\uac00\ub8e8 \ubc18\uc8fd \uc548\uc5d0 \ubd09\ud574 \uad6c\uc6b4 \ub4e0\ub4e0\ud55c \ud30c\uc774\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \uace0\uae30 \ud30c\uc774\ub294 \ub0b4\ud574 \uace1\ubb3c\uacfc \ud558\ub974\ub098\ud06c\uc5d0\uc11c \uc628 \uc5fc\uc7a5\uc721\uc774 \ub9cc\ub098\ub294 \uac00\ub3c4 \uc74c\uc2dd\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:mushroom-soup
    inGameDescription: "\ub3d9\uad74\ubc84\uc12f\uc744 \ud479 \ub053\uc5ec \uc9c4\ud55c \ud5a5\uacfc \ub2e8\ubc31\uc9c8\uc744 \uad6d\ubb3c\uc5d0 \uc6b0\ub824\ub0b8 \ube44\uac74\uc2dd\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ub3d9\uad74\ubc84\uc12f\uad6d\uc740 \uade0\uc0ac\uac00 \uad6d\ubb3c \uc704\ub85c \ub2e4\uc2dc \ub5a0\uc624\ub974\uae30 \uc9c1\uc804\uc5d0 \ubd88\uc744 \ub0b4\ub824 \ud5a5\uc744 \uc9c0\ud0a8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:night-spirit
    inGameDescription: "\ubc24\ud3ec\ub3c4\ub97c \ubc1c\ud6a8\ud55c \ub4a4 \ub2e4\uc2dc \uc99d\ub958\ud574 \ud5a5\uc740 \ub0a8\uae30\uace0 \ub3c4\uc218\ub97c \ub192\uc778 \uc220\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ubc24 \uc99d\ub958\uc8fc\ub294 \ub3d9\uc758\uc758 \uc794\uc744 \ub9de\ub304 \ub4a4\uc5d0\uc57c \ud53c\uc640 \uc11e\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:preserved-ration
    inGameDescription: "\uc804\ubd84\uacfc \uc18c\uae08\uc73c\ub85c \uc218\ubd84\uc744 \uc904\uc5ec \uba3c \uc6d0\uc815\uc5d0\ub3c4 \ubc84\ud2f0\ub3c4\ub85d \ub9cc\ub4e0 \ub2e8\ub2e8\ud55c \ubc30\uae09\uc2dd\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uadc0\ud658\uc790\uc758 \uc2dd\ud0c1\uc5d0\ub294 \ubcf4\uc874 \ubc30\uae09\uc2dd\uc758 \ubd09\uc778\ub3c4 \ub193\uc778\ub2e4. \ube48 \ud3ec\uc7a5 \ud558\ub098\uac00 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c \ud55c \ub07c\ub97c \ub73b\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:preserved-vegetable
    inGameDescription: "\ucc44\uc18c\ub97c \uc53b\uace0 \uc808\uc5ec \uc218\ud655\ucca0\uc774 \uc9c0\ub098\ub3c4 \uaebc\ub0b4 \uba39\uc744 \uc218 \uc788\uac8c \uc800\uc7a5\ud55c \ucc44\uc2dd\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac \ud55c\uc1a5\uc5d0\uc11c\ub294 \ubcf4\uc874 \ucc44\uc2dd\uc744 \uc5b4\ub9b0 \uc8fc\ubbfc\uacfc \uba3c \uae38\uc744 \uc628 \uc190\ub2d8\uc5d0\uac8c \uba3c\uc800 \uac74\ub128\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:roasted-meat
    inGameDescription: "\uc190\uc9c8\ud55c \uace0\uae30\ub97c \ubd88\uc5d0 \ubc14\ub85c \uad6c\uc6cc \ube60\ub974\uac8c \ub0b4\ub294 \ub2e8\uc21c\ud55c \uc721\uc2dd \uc694\ub9ac\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc744 \uce58\ub974\ub294 \ub0a0\uc5d0\ub294 \uace0\uae30\uad6c\uc774\ub97c \uad7d\ub358 \ubd88\uc744 \uaebc\ub728\ub9ac\uae30 \uc804\uae4c\uc9c0 \ub204\uad6c\ub3c4 \ud63c\uc790 \uba39\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:root-stew
    inGameDescription: "\uc7bf\ubd88\ubfcc\ub9ac\ub97c \ud07c\uc9c1\ud558\uac8c \uc370\uc5b4 \ud479 \ub053\uc778 \uc5f4\ub7c9 \ub192\uc740 \ube44\uac74 \uc2a4\ud29c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc7bf\ubd88\ubfcc\ub9ac \uc2a4\ud29c\ub294 \ubfcc\ub9ac\ub97c \uad6c\uc6b4 \uc7ac\ub97c \ud55c \uaf2c\uc9d1 \ub123\uc5b4 \ub2e8\ub9db\uc744 \ub04c\uc5b4\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:salted-meat-stew
    inGameDescription: "\uc5fc\uc7a5\uc721\uc758 \uc18c\uae08\uae30\ub97c \uad6d\ubb3c\uc5d0 \ud480\uace0 \ucc44\uc18c\uc640 \ud568\uaed8 \ub053\uc778 \ubcf4\uc874\uc2dd \uc2a4\ud29c\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc5d0\uc11c\ub294 \uc5fc\uc7a5\uc721 \uc2a4\ud29c\uc758 \uccab \uadf8\ub987\uc744 \ubc24 \uacbd\ube44\ub97c \ub9c8\uce5c \uc8fc\ubbfc\uc5d0\uac8c \uac74\ub128\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:stuffed-mushroom
    inGameDescription: "\ud070 \ubc84\uc12f\uac13 \uc548\uc5d0 \uace1\ubb3c\uacfc \uc591\ub150\ud55c \uc18d\uc7ac\ub8cc\ub97c \ucc44\uc6cc \uad6c\uc6b4 \ucc44\uc2dd \uc694\ub9ac\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc791\uc740 \ubc84\uc12f\uc740 \uc77c\uafbc \ubaab\uc73c\ub85c, \ud070 \ubc84\uc12f\uc740 \uc190\ub2d8\uc0c1\uc5d0 \uc62c\ub9ac\ub3c4\ub85d \uc18d\uc744 \ub2ec\ub9ac \ucc44\uc6b4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:twilight-beer
    inGameDescription: "\ud669\ud63c\uace1 \ub9e5\uc544\ub97c \ubc1c\ud6a8\ud574 \uc77c\uacfc \ub4a4\uc5d0 \uac00\ubccd\uac8c \ub098\ub220 \ub9c8\uc2dc\ub294 \ub9e5\uc8fc\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \ud669\ud63c \ub9e5\uc8fc\ub294 \ub0b4\ud574\uc758 \uace1\ubb3c\uac12\uacfc \uac00\ub3c4 \uc0ac\uc815\uc744 \uc804\ud558\ub294 \uc7a5\ud130 \uc220\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: food:vegetable-pie
    inGameDescription: "\uc190\uc9c8\ud55c \ucc44\uc18c\uc640 \uc591\ub150 \uc18d\uc744 \ubc18\uc8fd\uc73c\ub85c \uac10\uc2f8 \ud55c \uc870\uac01\uc529 \ub098\ub204\uae30 \uc88b\uc740 \ud30c\uc774\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \ucc44\uc18c \ud30c\uc774\ub294 \ub0b4\ud574 \ub18d\uac00\uac00 \uc7a5\uac70\ub9ac \uc6b4\uc1a1\uc5d0 \uc0c1\ucc98 \ub09c \uc791\ubb3c\uc744 \ub0a8\uae30\uc9c0 \uc54a\uc73c\ub824 \uad7d\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: husbandry:bedding
    inGameDescription: "\ucd95\uc0ac \uc704\uc0dd\uacfc \ud734\uc2dd\uc744 \uc720\uc9c0\ud558\ub294 \ubc14\ub2e5\uc7ac\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc9d0\uc2b9\uc9c0\uae30\ub294 \uae54\uc9da\uc744 \uac08\uc544 \ub0b8 \ub0a0\uacfc \uc9d0\uc2b9\uc774 \ubb34\ub9ac\uc5d0\uc11c \ub5a8\uc5b4\uc838 \uc7a0\ub4e0 \ub0a0\uc744 \uac19\uc740 \ucd95\uc0ac \uc7a5\ubd80\uc5d0 \uc801\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: industrial:sludge
    inGameDescription: "\ud3d0\uc218 \ucc98\ub9ac\uc5d0\uc11c \ub0a8\uc740 \uce68\uc804\ubb3c. \ud1f4\ube44, \uc800\uae09 \uc5f0\ub8cc, \ub3c5\uc131 \uc5f0\uae08 \uc7ac\ub8cc\ub85c \uac00\uacf5\ud560 \uc218 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c\ub294 \uc624\uc218 \uc2ac\ub7ec\uc9c0\uc758 \uae08\uc18d, \ub3c5\uc131\uacfc \uc720\uae30\ubb3c\uc744 \ub098\ub220 \uacf5\ub3d9 \uc815\uc6d0\uc73c\ub85c \ub3cc\ub824\ubcf4\ub0bc \ubaab\ub9cc \ub530\ub85c \uc219\uc131\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: item:equipment-module
    inGameDescription: "\ubb34\uae30\uc640 \ubc29\uc5b4\uad6c\uc758 \uae30\uc874 \uacb0\ud569\ubd80\uc5d0 \ub07c\uc6cc \uc131\ub2a5 \uc870\uc728\uc744 \ubc14\uafb8\ub294 \uaddc\uaca9\ud654\ub41c \uac1c\ub7c9 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\ub294 \uac1c\ub7c9 \ubd80\ud488\uc744 \ubc14\uafbc \ub4a4\uc5d0\ub3c4 \uc6d0\ub798 \uc7a5\ube44\uc758 \uc81c\uc791\uc790\uc640 \uc218\ub9ac \uacc4\ubcf4\ub97c \uae30\uc5b5\ud310\uc5d0 \uc774\uc5b4 \uc801\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: item:lineage-seal
    inGameDescription: "\uac00\uacc4\uc640 \uc0c1\uc18d \uae30\ub85d\uc774 \uc5b4\ub290 \uacc4\ud1b5\uc5d0\uc11c \uc774\uc5b4\uc84c\ub294\uc9c0 \ud655\uc778\ud558\ub3c4\ub85d \ubb38\uc11c\uc5d0 \ucc0d\ub294 \uacc4\ubcf4 \uc778\uc7a5\uc774\ub2e4. \uc624\ub974\ub370\ub098 \ub4f1\uae30\uc6d0\uc758 \uacc4\ubcf4 \uc778\uc7a5\uc740 \ud608\uc5f0, \uc591\uc721\uacfc \uc0c1\uc18d \uac00\uc6b4\ub370 \ubc95\uc774 \uc778\uc815\ud560 \uad00\uacc4\ub97c \ud55c \uce78\uc73c\ub85c \uace0\uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:alchemical-solvent
    inGameDescription: "\uc57d\ud6a8 \uc131\ubd84\uacfc \ub9c8\ub098\ub97c \uc548\uc815\uc801\uc73c\ub85c \uc11e\ub294 \uc6a9\ub9e4\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5f0\uae08 \uc6a9\ub9e4\ub294 \uacc4\uc57d\ud55c \uc81c\uc870\uc790\ub9cc \ub9c8\uac1c\ub97c \ud480\ub3c4\ub85d \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \uac00\uc838\uc628 \uac80\uc740 \uc2e4\uc744 \ubd09\uc778 \uc544\ub798\uc5d0 \ub450 \ubc88 \uac10\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:alcohol
    inGameDescription: "\uc220, \uc18c\ub3c5\uc81c\uc640 \uc5f0\uae08 \uc6a9\ub9e4\uc758 \uae30\ubc18\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc54c\ucf54\uc62c \ubcd1\uc740 \uc2dd\uc6a9\u00b7\uc18c\ub3c5\uc6a9\u00b7\uc5f0\uae08\uc6a9\uc744 \ubd09\uc778\uc0c9\uc73c\ub85c \uad6c\ubd84\ud558\uace0, \ud53c\ub97c \uc11e\uc740 \uac83\uc740 \ub3d9\uc758\uc758 \uc794 \ud45c\uc2dd\uc744 \ub354\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:barrel-steel
    inGameDescription: "\ucd1d\uc5f4\uac15\uc740 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc0b0 \ucd1d\uc5f4\uac15\uc5d0\ub294 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uacfc \ub418\ub179\uc778 \ud69f\uc218\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:black-powder
    inGameDescription: "\ud751\uc0c9\ud654\uc57d\uc740 \ud654\uc57d\uacfc \uc5f0\uae08 \uacf5\uc815\uc5d0\uc11c \ubc18\uc751\uc744 \uc77c\uc73c\ud0a4\ub3c4\ub85d \uac74\uc870\ud574 \ub454 \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \ud751\uc0c9\ud654\uc57d \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:blacksteel-ingot
    inGameDescription: "\ub9c8\ub098\ub97c \uba38\uae08\uc740 \ucd5c\uace0\uae09 \uae08\uc18d\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ud751\uac15\uc758 \uc606\uba74\uc5d0\ub294 \ub9c8\ub098\uac00 \ud750\ub978 \uc628\ub3c4\uac00 \uc595\uc740 \ud648\uc73c\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:bowstring
    inGameDescription: "\ud65c\uacfc \uc11d\uad81 \uc81c\uc791\uc5d0 \uc4f0\ub294 \uace0\uc7a5\ub825 \uc12c\uc720\uc774\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ud65c\uc2dc\uc704\uc5d0\ub294 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \uacac\ub3a0\ub2e4\ub294 \ud478\ub978 \uae43\ub9e4\ub4ed\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:brined-vegetable
    inGameDescription: "\uc5fc\uc9c0 \ucc44\uc18c\ub294 \uc624\ub798 \ubcf4\uad00\ud558\uac70\ub098 \ub2e4\uc74c \uc870\ub9ac\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub3c4\ub85d \ubbf8\ub9ac \uc190\uc9c8\ud55c \uc2dd\uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc0b0 \uc5fc\uc9c0 \ucc44\uc18c\ub294 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc624\ub798 \uc9c0\ub098\ub3c4 \uc0c1\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc791\uc740 \ud3ec\ub300\ub85c \ub098\ub25c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:cartridge-paper
    inGameDescription: "\ud0c4\uc57d\uc9c0\ub294 \uae30\ub85d, \ud0c4\uc57d\uacfc \ub3c4\uba74 \uc81c\uc791\uc5d0 \ud544\uc694\ud55c \uc587\uc740 \uac00\uacf5 \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \ud0c4\uc57d\uc9c0 \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:cave-silk
    inGameDescription: "\ub3d9\uad74 \ube44\ub2e8\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ub3d9\uad74 \ube44\ub2e8\uc5d0\ub294 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \uacac\ub3a0\ub2e4\ub294 \ud478\ub978 \uae43\ub9e4\ub4ed\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:chain-mesh
    inGameDescription: "\uc791\uc740 \uae08\uc18d \uace0\ub9ac\ub97c \ucd18\ucd18\ud788 \uc774\uc5b4 \ubc29\uc5b4\uad6c\uc758 \uc720\uc5f0\ud55c \ub36e\uac1c\ub85c \uc4f0\ub294 \uc0ac\uc2ac \ub9dd\uc774\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc0b0 \uc0ac\uc2ac \ub9dd\uc5d0\ub294 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uacfc \ub418\ub179\uc778 \ud69f\uc218\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:charcoal
    inGameDescription: "\uc81c\uac15\uacfc \uace0\uc628 \uac00\uacf5\uc5d0 \uc801\ud569\ud55c \uc815\uc81c \uc5f0\ub8cc\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \uc22f \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:cheese
    inGameDescription: "\ubcf4\uc874\uc131\uc774 \uc88b\uc740 \ucc44\uc2dd \ub2e8\ubc31\uc9c8 \uc2dd\uc7ac\ub8cc\uc774\ub2e4. \ud558\ub974\ub098\ud06c \uc7a5\ud130\uc758 \uce58\uc988 \uac12\uc740 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \uc218\uc704\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ud1b5\ud589\uc138\uc5d0 \ub530\ub77c \uba3c\uc800 \uc6c0\uc9c1\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:cloth
    inGameDescription: "\uc758\ubcf5, \ubd95\ub300\uc640 \uac00\ubcbc\uc6b4 \ubc29\uc5b4\uad6c\uc758 \uc8fc\uc7ac\ub8cc\uc774\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0c1\ub2e8\uc740 \ucc9c\uc744 \ud558\ub974\ub098\ud06c \uc7ac\ub2e8\uc18c\uc5d0 \ub118\uae38 \ub54c \ubfd4, \ub0a0\uac1c\uc640 \uaf2c\ub9ac\uc6a9 \uc7ac\ub2e8 \uc5ec\uc720\ub97c \ub530\ub85c \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:common-wool
    inGameDescription: "\uc77c\ubc18 \ubaa8\uc9c1\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0c1\ub2e8\uc740 \uc77c\ubc18 \ubaa8\uc9c1\uc744 \ud558\ub974\ub098\ud06c \uc7ac\ub2e8\uc18c\uc5d0 \ub118\uae38 \ub54c \ubfd4, \ub0a0\uac1c\uc640 \uaf2c\ub9ac\uc6a9 \uc7ac\ub2e8 \uc5ec\uc720\ub97c \ub530\ub85c \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:compost
    inGameDescription: "\ubc2d\uacfc \uc2e4\ub0b4 \uc7ac\ubc30\uc5d0 \uc4f0\ub294 \ud1a0\uc591 \uc601\uc591\uc81c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ud1f4\ube44\ub294 \uc18d\uc774 \ub530\ub73b\ud558\ub418 \uc2dc\ud07c\ud55c \ub0c4\uc0c8\uac00 \ub098\uc9c0 \uc54a\uc544\uc57c \uacf5\ub3d9 \uc815\uc6d0\uc5d0 \ud3bc\uce60 \uc218 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:curd
    inGameDescription: "\uc751\uc720\ub294 \uc2dd\uc7ac\ub8cc\ub97c \ud55c \ucc28\ub840 \uac00\uacf5\ud574 \uc870\ub9ac\uc640 \ubc1c\ud6a8\uc5d0 \ubc14\ub85c \uc4f8 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc7ac\ub8cc\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \uc628 \uc751\uc720 \ud3ec\ub300\uc5d0\ub294 \uc18c\uae08\ubc14\ub78c \ub0c4\uc0c8\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ubd89\uc740 \uba3c\uc9c0\uac00 \ud568\uaed8 \ubc34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:deep-goat-wool
    inGameDescription: "\uc2ec\uce35 \uc5fc\uc18c\ubaa8\uc9c1\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0b0\uae30\uc2ad\uc758 \uc9c1\uc870\uac00\ub294 \uc2ec\uce35 \uc5fc\uc18c\ubaa8\uc9c1\uc744 \uc5ec\ub7ec \uccb4\ud615\uc758 \uc637\uc73c\ub85c \uace0\uccd0 \uc4f0\ub3c4\ub85d \ud3ed\uacfc \ub298\uc5b4\ub098\ub294 \ubc29\ud5a5\uc744 \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:dough
    inGameDescription: "\ubc18\uc8fd\uc740 \uc2dd\uc7ac\ub8cc\ub97c \ud55c \ucc28\ub840 \uac00\uacf5\ud574 \uc870\ub9ac\uc640 \ubc1c\ud6a8\uc5d0 \ubc14\ub85c \uc4f8 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc0b0 \ubc18\uc8fd\uc740 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc624\ub798 \uc9c0\ub098\ub3c4 \uc0c1\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc791\uc740 \ud3ec\ub300\ub85c \ub098\ub25c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:dreamweave
    inGameDescription: "\ucd08\uacbd\ub7c9\uacfc \uc815\uc2e0 \uc800\ud56d\uc744 \uc81c\uacf5\ud558\ub294 \ube44\uc804 \uc9c1\ubb3c\uc774\ub2e4. \ud2b9\ud788 \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ubabd\uc9c1\ubb3c\uc758 \ubd09\uc778\uc5d0\ub294 \ub9c8\ub098\uac00 \uc0c8\uba74 \uac00\uc7a5 \uba3c\uc800 \ube5b\uc744 \uc783\ub294 \uc138 \ubc88\uc9f8 \ub9e4\ub4ed\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:ember-cotton
    inGameDescription: "\uc7bf\ubd88 \uc9c0\ub300\uc5d0\uc11c \uac70\ub454 \ubaa9\ud654\ub97c \uc2e4\ub85c \uc9dc \ub0b4\uc5f4 \uc791\uc5c5\ubcf5\uacfc \ub450\uaebc\uc6b4 \uc548\uac10\uc5d0 \uc4f0\ub294 \uba74\uc9c1\ubb3c\uc774\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0c1\ub2e8\uc740 \uc7bf\ubd88 \uba74\uc9c1\ubb3c\uc744 \ud558\ub974\ub098\ud06c \uc7ac\ub2e8\uc18c\uc5d0 \ub118\uae38 \ub54c \ubfd4, \ub0a0\uac1c\uc640 \uaf2c\ub9ac\uc6a9 \uc7ac\ub2e8 \uc5ec\uc720\ub97c \ub530\ub85c \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:fermented-liquor
    inGameDescription: "\ubc1c\ud6a8\uc561\uc740 \uc74c\ub8cc, \uc870\ub9ac\uc640 \uc57d\ud488 \uc81c\uc870\uc5d0 \ub098\ub220 \uc4f0\ub294 \uc561\uccb4 \uc7ac\ub8cc\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc9c0\ub098\ub294 \ubc1c\ud6a8\uc561 \ud1b5\uc5d0\ub294 \ud754\ub4e4\ub9bc\uacfc \ub0ae\ubc24\uc758 \uc628\ub3c4 \ucc28\ub97c \ud655\uc778\ud55c \uac80\ubb38\ud45c\uac00 \ucc28\ub840\ub85c \ubd99\ub294\ub2e4."
