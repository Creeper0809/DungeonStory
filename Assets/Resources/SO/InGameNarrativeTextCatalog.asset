    inGameDescription: "\ub3d9\uad74 \uc7ac\ubc30 \uc120\ubc18\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc2dd \ub3d9\uad74 \uc7ac\ubc30 \uc120\ubc18\uc5d0\ub294 \ud070\uc1a5\uc758 \ubaab\uc744 \ubc1b\uc744 \uc5b4\ub9b0 \uc8fc\ubbfc\uacfc \ubd80\uc0c1\uc790\ub97c \uc704\ud55c \ub0ae\uc740 \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8804
    inGameDescription: "\ubb38\uc7a5 \uae43\ubc1c \uc81c\uc791\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubb38\uc7a5 \uae43\ubc1c \uc81c\uc791\ub300\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8805
    inGameDescription: "\uc758\uc2dd\uc5d0 \ud544\uc694\ud55c \ubd88\uacfc \uc81c\ubb3c\uc744 \uc548\uc804\ud558\uac8c \ub2e4\ub8e8\ub3c4\ub85d \ub9cc\ub4e0 \uc758\uc2dd \ud654\ub85c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8806
    inGameDescription: "\uc6b4\ubc18 \uba5c\ube75\uc744 \uc791\uc5c5\uc790\uac00 \ubc14\ub85c \uaebc\ub0b4\uace0 \ubc18\ub0a9\ud560 \uc218 \uc788\uac8c \uac78\uc5b4 \ub450\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8807
    inGameDescription: "\uc0c1\ud488 \uc774\ub984\uacfc \ud604\uc7ac \uac00\uaca9\uc744 \uc190\ub2d8\uc774 \ubc14\ub85c \ud655\uc778\ud560 \uc218 \uc788\uac8c \uc801\uc5b4 \ub450\ub294 \uac00\uaca9\ud45c \uac8c\uc2dc\ud310 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8808
    inGameDescription: "\ud53c\uc758 \ubb34\ub300 \ubc30\uc218\uad6c\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ud53c\uc758 \ubb34\ub300 \ubc30\uc218\uad6c\uc758 \ubd80\ud488 \uc0c1\uc790\ub294 \ud558\ub298\uae38 \ud55c \uad6c\uac04\uc744 \ub0a0\uc544 \ub098\ub97c \uc218 \uc788\ub294 \ubb34\uac8c\ub97c \ub118\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8809
    inGameDescription: "\ud3ec\ub85c \uc791\uc5c5 \ub3c4\uad6c\ud568\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8810
    inGameDescription: "\uac15\ud654 \uad6c\uc18d\uad6c \uc120\ubc18\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \uac15\ud654 \uad6c\uc18d\uad6c \uc120\ubc18\uc5d0\ub294 \uc644\uc131\ub41c \ubd80\ud488\ubcf4\ub2e4 \uc2e4\ud328\ud55c \uccab \uc2dc\uc81c\ud488\uc744 \uac78\uc5b4 \ub450\ub294 \uc790\ub9ac\uac00 \ub354 \ub208\uc5d0 \ub748\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8811
    inGameDescription: "\uacf5\uc5f0 \uc18c\ud488 \ubcf4\uad00\ub300\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \uacf5\uc5f0 \uc18c\ud488 \ubcf4\uad00\ub300\uc758 \ubd80\ud488 \uc0c1\uc790\ub294 \ud558\ub298\uae38 \ud55c \uad6c\uac04\uc744 \ub0a0\uc544 \ub098\ub97c \uc218 \uc788\ub294 \ubb34\uac8c\ub97c \ub118\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8812
    inGameDescription: "\ub3d9\ub9f9 \uc2e0\ud638\uae30\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8813
    inGameDescription: "\uade0\uc0ac \uc7ac\ubc30 \uc120\ubc18\uc5d0 \uc528\uc557\uc744 \uc2ec\uace0 \uc791\ubb3c\uc758 \uc131\uc7a5 \uc0c1\ud0dc\ub97c \ub3cc\ubcf4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc2dd \uade0\uc0ac \uc7ac\ubc30 \uc120\ubc18\uc5d0\ub294 \ud070\uc1a5\uc758 \ubaab\uc744 \ubc1b\uc744 \uc5b4\ub9b0 \uc8fc\ubbfc\uacfc \ubd80\uc0c1\uc790\ub97c \uc704\ud55c \ub0ae\uc740 \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8814
    inGameDescription: "\ubc8c\ubaa9 \ud0a4\ud2b8 \uac78\uc774\uc5d0\uc11c \ucc44\uc9d1\ubb3c\uacfc \ud604\uc7a5 \ud45c\ubcf8\uc744 \uc815\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8815
    inGameDescription: "\uc410\uae30 \ub3c4\ub07c \uc791\uc5c5\ub300\uc5d0\uc11c \ucc44\uc9d1\ubb3c\uacfc \ud604\uc7a5 \ud45c\ubcf8\uc744 \uc815\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc2dd \uc410\uae30 \ub3c4\ub07c \uc791\uc5c5\ub300 \uc8fc\ubcc0\uc740 \uc9d0\uc218\ub808 \ub450 \ub300\uc640 \ud53c\ub09c \ud589\ub82c\uc774 \uc5c7\uac08\ub9b4 \ub9cc\ud07c \ub113\uac8c \ube44\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8816
    inGameDescription: "\ubc29\ubd80 \ucc98\ub9ac \ubaa9\uc7ac\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubc29\ubd80 \ucc98\ub9ac \ubaa9\uc7ac\ub300\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \ubd80\ud488\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8817
    inGameDescription: "\ubc88\uc2dd \uc7a5\ubd80\ub300\uc5d0\uc11c \uac00\ucd95\uc758 \ubc88\uc2dd\uacfc \ub3cc\ubd04, \ud6c8\ub828\uc5d0 \ud544\uc694\ud55c \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\ub3c4 \uac19\uc740 \uce58\uc218\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8818
    inGameDescription: "\ud608\ud1b5 \ucd09\uc9c4\uc81c \uc120\ubc18\uc5d0\uc11c \uac00\ucd95\uc758 \ubc88\uc2dd\uacfc \ub3cc\ubd04, \ud6c8\ub828\uc5d0 \ud544\uc694\ud55c \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc2dd \ud608\ud1b5 \ucd09\uc9c4\uc81c \uc120\ubc18\uc5d0\ub294 \ud070\uc1a5\uc758 \ubaab\uc744 \ubc1b\uc744 \uc5b4\ub9b0 \uc8fc\ubbfc\uacfc \ubd80\uc0c1\uc790\ub97c \uc704\ud55c \ub0ae\uc740 \uc790\ub9ac\uac00 \ube44\uc5b4 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8819
    inGameDescription: "\ub9c8\uad6c \uc120\ubc18\uc5d0\uc11c \uac00\ucd95\uc758 \ubc88\uc2dd\uacfc \ub3cc\ubd04, \ud6c8\ub828\uc5d0 \ud544\uc694\ud55c \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc740 \ub9c8\uad6c \uc120\ubc18\uc758 \ubd88\uc744 \uc62c\ub9ac\uae30 \uc804 \ubc24 \uacbd\ube44\uc640 \uc5b4\ub9b0 \uc8fc\ubbfc\uc758 \uadf8\ub987\ubd80\ud130 \ub298\uc5b4\ub193\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8820
    inGameDescription: "\uc870\ub828\uc6a9 \uace0\uc090 \uac78\uc774\uc5d0\uc11c \uac00\ucd95\uc758 \ubc88\uc2dd\uacfc \ub3cc\ubd04, \ud6c8\ub828\uc5d0 \ud544\uc694\ud55c \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc774 \uaddc\uaca9\uc740 \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\uc5d0\ub3c4 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8821
    inGameDescription: "\ub3d9\ub825 \uacf5\uad6c\ub0a0 \uc5f0\ub9c8\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8822
    inGameDescription: "\uc758\ubcf5\uacfc \ucc9c\uc744 \ubb3c\uacfc \uc138\uc815\uc81c\ub85c \uc790\ub3d9 \uc138\ucc99\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc2dd \uc790\ub3d9 \uc138\ucc99\uae30 \uc8fc\ubcc0\uc740 \uc9d0\uc218\ub808 \ub450 \ub300\uc640 \ud53c\ub09c \ud589\ub82c\uc774 \uc5c7\uac08\ub9b4 \ub9cc\ud07c \ub113\uac8c \ube44\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8823
    inGameDescription: "\ub8ec \ubc84\uc2a4 \uacb0\ud569\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec \ubc84\uc2a4 \uacb0\ud569\uae30\ub294 \uacc4\uc57d\uc790\uac00 \uc190\uc744 \ub5bc\uba74 \ub9c8\ub098\ube5b\ub3c4 \ucc9c\ucc9c\ud788 \uc0ac\ub77c\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8824
    inGameDescription: "\ubc29\uc5b4\uc2dc\uc124 \uc7a5\uc804\uae30\uc5d0\uc11c \uc6d0\uac70\ub9ac \uc7a5\ube44\uc640 \ud0c4\uc57d\uc744 \ub2e4\ub8e8\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ubc29\uc5b4\uc2dc\uc124 \uc7a5\uc804\uae30\uc758 \ubd80\ud488 \uc0c1\uc790\ub294 \ud558\ub298\uae38 \ud55c \uad6c\uac04\uc744 \ub0a0\uc544 \ub098\ub97c \uc218 \uc788\ub294 \ubb34\uac8c\ub97c \ub118\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8825
    inGameDescription: "\uc0c8 \ubd80\ud488\uacfc \uc0dd\uc0b0 \ubc29\uc2dd\uc744 \uc2dc\ud5d8\ud558\uace0 \uacb0\uacfc\ub97c \ube44\uad50\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc2dc\uc81c\ud488 \uc5f0\uad6c\uc2e4 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc81c\ud488 \uc5f0\uad6c\uc2e4\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \ubd80\ud488\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8826
    inGameDescription: "\uc7ac\ub8cc \uc2dc\ud5d8\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8827
    inGameDescription: "\uae30\uacc4 \uae30\ucd08\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8828
    inGameDescription: "\ub0c9\uac01 \ub9e4\ub2c8\ud3f4\ub4dc\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ub0c9\uac01 \ub9e4\ub2c8\ud3f4\ub4dc\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8829
    inGameDescription: "\ubc30\uad00\uc744 \ud750\ub974\ub294 \ubb3c\uc758 \uc591\uc744 \uc7ac\uc5b4 \uacf5\uae09 \uc774\uc0c1\uc744 \ucc3e\ub3c4\ub85d \ub9cc\ub4e0 \uacc4\uce21\uae30\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8830
    inGameDescription: "\uc815\ube44 \ubd80\ud488\ud568\uc5d0\uc11c \uc190\uc0c1\ub41c \uc804\ud22c \uc7a5\ube44\ub97c \uc810\uac80\ud558\uace0 \uc218\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \uc815\ube44 \ubd80\ud488\ud568\uc758 \uccab \uace0\uc7a5\uc744 \uace0\uce5c \ub0a0\ubd80\ud130 \uadf8 \uc791\uc5c5\ub300\ub97c \ub3c4\uc81c\uc758 \ubcc4\uba85\uc73c\ub85c \ubd80\ub978\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8831
    inGameDescription: "\uc804\ub3d9 \uc120\ubc18\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc804\ub3d9 \uc120\ubc18\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \ubd80\ud488\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8832
    inGameDescription: "\uc815\ubc00 \uac8c\uc774\uc9c0\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8833
    inGameDescription: "\ub8ec \uc81c\uc5b4\ubc18\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc2dd \ub8ec \uc81c\uc5b4\ubc18\uc5d0\ub294 \uc0ac\uc6a9 \uae30\ud55c\uc774 \uc9c0\ub098\uba74 \uc2a4\uc2a4\ub85c \ud480\ub9ac\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8834
    inGameDescription: "\ubb34\uae30 \ub3c4\uba74\uac78\uc774\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8835
    inGameDescription: "\ubc29\uc5b4\uad6c \ub9de\ucda4\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \ubc29\uc5b4\uad6c \ub9de\ucda4\ub300\uc5d0\ub294 \uc644\uc131\ub41c \ubd80\ud488\ubcf4\ub2e4 \uc2e4\ud328\ud55c \uccab \uc2dc\uc81c\ud488\uc744 \uac78\uc5b4 \ub450\ub294 \uc790\ub9ac\uac00 \ub354 \ub208\uc5d0 \ub748\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8836
    inGameDescription: "\uad81\uc2dc \uc9c0\uadf8\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8837
    inGameDescription: "\uad8c\uc591 \uc791\uc5c5\ub300\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \uad8c\uc591 \uc791\uc5c5\ub300\uc758 \uccab \uace0\uc7a5\uc744 \uace0\uce5c \ub0a0\ubd80\ud130 \uadf8 \uc791\uc5c5\ub300\ub97c \ub3c4\uc81c\uc758 \ubcc4\uba85\uc73c\ub85c \ubd80\ub978\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8838
    inGameDescription: "\uc0ac\uc2ac \uc870\ub9bd\ud2c0\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc0ac\uc2ac \uc870\ub9bd\ud2c0\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \ubd80\ud488\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8839
    inGameDescription: "\uad00\uc808 \uc9c0\uadf8\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8840
    inGameDescription: "\ud654\uc57d \ubd84\uc1c4\uc18c\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ud654\uc57d \ubd84\uc1c4\uc18c\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8841
    inGameDescription: "\ud0c4\uc57d \uc555\ucc29\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \ud0c4\uc57d \uc555\ucc29\uae30\uc758 \uccab \uace0\uc7a5\uc744 \uace0\uce5c \ub0a0\ubd80\ud130 \uadf8 \uc791\uc5c5\ub300\ub97c \ub3c4\uc81c\uc758 \ubcc4\uba85\uc73c\ub85c \ubd80\ub978\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8842
    inGameDescription: "\ubd80\ud488 \uac10\uc815\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8843
    inGameDescription: "\ubd80\ud488 \ubcf5\uc6d0 \uc791\uc5c5\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc0b0 \ubd80\ud488 \ubcf5\uc6d0 \uc791\uc5c5\ub300\uc758 \uc791\uc5c5\uba74\uc5d0\ub294 \ubd80\ud488\ub97c \ucc98\uc74c \uc644\uc131\ud55c \ub3c4\uc81c\uc758 \uc190\ub192\uc774\uc5d0 \ub9de\ucd98 \uae01\ud798\uc774 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8844
    inGameDescription: "\uc815\ubc00 \uc7a5\ucc29\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8845
    inGameDescription: "\uc131\uc7a5\ud615 \uace8\uaca9 \uc9c0\uadf8\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8846
    inGameDescription: "\uacc4\uce21 \uc791\uc5c5\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uacc4\uce21 \uc791\uc5c5\ub300\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8847
    inGameDescription: "\uad6c\uc131\uccb4 \ud575 \uacf5\ud559\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8848
    inGameDescription: "\ubc30\uc2dd \uc6b4\uc601\ud310\uc5d0\uc11c \uc2dd\uc7ac\ub8cc\ub97c \uc190\uc9c8\ud558\uace0 \uc870\ub9ac\ud574 \ub07c\ub2c8\ub97c \ub0b4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc774 \uaddc\uaca9\uc740 \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\uc5d0\ub3c4 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8849
    inGameDescription: "\uacc4\uc808\ub825 \uae30\ub85d\ub300\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8850
    inGameDescription: "\uc791\ubb3c \ub2ec\ub825\ub300\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc774 \uaddc\uaca9\uc740 \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\uc5d0\ub3c4 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8851
    inGameDescription: "\uae30\uc0c1 \uad00\uce21\ud0d1\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc2dd \uae30\uc0c1 \uad00\uce21\ud0d1\uc5d0\ub294 \uc0ac\uc6a9 \uae30\ud55c\uc774 \uc9c0\ub098\uba74 \uc2a4\uc2a4\ub85c \ud480\ub9ac\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8852
    inGameDescription: "\ud1a0\uc591 \uac80\uc0ac\ub300\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc740 \ud1a0\uc591 \uac80\uc0ac\ub300\uc758 \ubd88\uc744 \uc62c\ub9ac\uae30 \uc804 \ubc24 \uacbd\ube44\uc640 \uc5b4\ub9b0 \uc8fc\ubbfc\uc758 \uadf8\ub987\ubd80\ud130 \ub298\uc5b4\ub193\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8853
    inGameDescription: "\uacc4\uc808 \uc2dd\uc7ac\ub8cc\uc640 \uc885\uc790\ub97c \uad6c\ubd84\ud574 \ubcf4\uad00\ud558\uace0 \uba3c\uc800 \uc4f8 \ubb3c\ub7c9\uc744 \ud655\uc778\ud558\ub294 \uc120\ubc18\uc758 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc2dd \uacc4\uc808 \uc800\uc7a5 \uc120\ubc18 \uc8fc\ubcc0\uc740 \uc9d0\uc218\ub808 \ub450 \ub300\uc640 \ud53c\ub09c \ud589\ub82c\uc774 \uc5c7\uac08\ub9b4 \ub9cc\ud07c \ub113\uac8c \ube44\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8854
    inGameDescription: "\uc7ac\ubc30 \uc628\uc2e4\uc5d0 \uc528\uc557\uc744 \uc2ec\uace0 \uc791\ubb3c\uc758 \uc131\uc7a5 \uc0c1\ud0dc\ub97c \ub3cc\ubcf4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc2dd \uc7ac\ubc30 \uc628\uc2e4\uc758 \uc1a5\uac00\uc5d0\ub294 \ud070\uc1a5\uc758 \ubaab\uc744 \ub73b\ud558\ub294 \uc5ec\uc12f \uac1c\uc758 \uc595\uc740 \uad6d\uc790 \uc790\uad6d\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8855
    inGameDescription: "\ubc88\uc2dd \uc77c\uc815 \ucd95\uc0ac\uc5d0\uc11c \uac00\ucd95\uc758 \ubc88\uc2dd\uacfc \ub3cc\ubd04, \ud6c8\ub828\uc5d0 \ud544\uc694\ud55c \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc2dd \ubc88\uc2dd \uc77c\uc815 \ucd95\uc0ac \uc8fc\ubcc0\uc740 \uc9d0\uc218\ub808 \ub450 \ub300\uc640 \ud53c\ub09c \ud589\ub82c\uc774 \uc5c7\uac08\ub9b4 \ub9cc\ud07c \ub113\uac8c \ube44\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8856
    inGameDescription: "\uae30\ud6c4 \uc81c\uc5b4\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \uae30\ud6c4 \uc81c\uc5b4\uc2e4\uc758 \ubd80\ud488 \uc0c1\uc790\ub294 \ud558\ub298\uae38 \ud55c \uad6c\uac04\uc744 \ub0a0\uc544 \ub098\ub97c \uc218 \uc788\ub294 \ubb34\uac8c\ub97c \ub118\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8857
    inGameDescription: "\uac00\uad6c \ub4f1\ub85d\ub300\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
