    stableId: facility-kit:1054
    inGameDescription: "\uc2dd\uc7ac\ub8cc\uc800\uc7a5\ud568\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud070\uc1a5\uc758 \ubaab\uc740 \uc2dd\uc7ac\ub8cc\uc800\uc7a5\ud568\uc758 \ubd88\uc744 \uc62c\ub9ac\uae30 \uc804 \ubc24 \uacbd\ube44\uc640 \uc5b4\ub9b0 \uc8fc\ubbfc\uc758 \uadf8\ub987\ubd80\ud130 \ub298\uc5b4\ub193\ub294\ub2e4."
