    inGameDescription: "\uace0\uae30\uac78\uc774\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc774 \uaddc\uaca9\uc740 \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\uc5d0\ub3c4 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1011
    inGameDescription: "\uc220\uacfc \uc74c\ub8cc\ub97c \uc8fc\ubb38\ubc1b\uc544 \uc794\uc5d0 \ub530\ub974\uace0 \uc190\ub2d8\uc5d0\uac8c \ub0b4\ub3c4\ub85d \uafb8\ub9b0 \uc220\uc74c\ub8cc\uc7a5 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud070\uc1a5\uc758 \ubaab\uc744 \ub530\ub974\ub294 \uc2dc\uc124\uacfc\ub3c4 \ubd80\ud488 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1012
    inGameDescription: "\ud310\ub9e4\uce74\uc6b4\ud130\uc5d0\uc11c \uc0c1\ud488\uc744 \ubcf4\uc5ec \uc8fc\uace0 \uc190\ub2d8\uacfc \uac12\uc744 \uce58\ub97c \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1013
    inGameDescription: "\uc7a1\ud654\uc9c4\uc5f4\uc120\ubc18\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc7a1\ud654\uc9c4\uc5f4\uc120\ubc18 \uac00\uaca9\ud310\uc5d0\ub294 \ub3d9\uc804 \uc606\uc5d0 \uc6b4\ubc18\uacfc \uae38 \uc548\ub0b4\ub85c \uac12\uc744 \uce58\ub974\ub294 \ube48\uce78\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1014
    inGameDescription: "\uc7a0\uae08\uc9c4\uc5f4\uc7a5\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1015
    inGameDescription: "\uc7a1\ud654\uc0c1\uc790\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1016
    inGameDescription: "\ubb34\uae30\uac70\uce58\ub300\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1017
    inGameDescription: "\uac11\uc637\uac70\uce58\ub300\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1018
    inGameDescription: "\ubb34\uae30\ubcf4\uad00\ud568\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1019
    inGameDescription: "\ub300\uc7a5\uc791\uc5c5\ub300\uc5d0\uc11c \ubb34\uae30\uc640 \ubc29\uc5b4\uad6c\ub97c \uc870\ub9bd\ud558\uace0 \ub9c8\uac10\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \ub300\uc7a5\uc791\uc5c5\ub300\uc5d0\uc11c \ub098\uc628 \ubb3c\uac74\uc740 \ub9c8\uc9c0\ub9c9 \uc218\ub9ac\uc790\uac00 \ub204\ub978 \ub124\ubaa8 \uc190\uc790\uad6d\uc744 \ud558\ub098\uc529 \ub2ec\uace0 \ub098\uc628\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1020
    inGameDescription: "\uac04\uc774\uce68\ub300\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc7a0\ub4e4\uc5b4 \ud53c\ub85c\ub97c \ud480\uace0 \uc0dd\ud65c \uc8fc\uae30\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1021
    inGameDescription: "\uc815\uc2dd\uce68\ub300\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc7a0\ub4e4\uc5b4 \ud53c\ub85c\ub97c \ud480\uace0 \uc0dd\ud65c \uc8fc\uae30\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1022
    inGameDescription: "\uc774\uce35\uce68\ub300\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc7a0\ub4e4\uc5b4 \ud53c\ub85c\ub97c \ud480\uace0 \uc0dd\ud65c \uc8fc\uae30\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1023
    inGameDescription: "\ud734\uc2dd\uc6a9\uc18c\ud30c\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc26c\uac70\ub098 \uae30\ubcf8 \uc695\uad6c\ub97c \ud574\uacb0\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1024
    inGameDescription: "\ud611\ud0c1\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1025
    inGameDescription: "\uc637\uc7a5\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1026
    inGameDescription: "\uc601\uc8fc\uc9d1\ubb34\ucc45\uc0c1\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1027
    inGameDescription: "\uc9c0\ud718\uc758\uc790\uc5d0 \uc8fc\ubbfc\uacfc \uc190\ub2d8\uc774 \uc549\uc544 \uc26c\uac70\ub098 \uc2dd\uc0ac\ud560 \uc218 \uc788\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc9c0\ud718\uc758\uc790\uc5d0\ub294 \uc0c1\uc778, \ub09c\ubbfc\uacfc \uc815\ucc30\ub300\uac00 \uac19\uc740 \uc2dd\ud0c1\uc744 \ub098\ub20c \uc218 \uc788\ub3c4\ub85d \ube48\uc790\ub9ac\ub97c \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1028
    inGameDescription: "\uac1c\uc778\ubcf4\uad00\ud568\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1029
    inGameDescription: "\uce68\uc2e4\uc6a9\ucc45\uc7a5\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1030
    inGameDescription: "\uc5f0\uad6c\ucc45\uc0c1\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5f0\uad6c\ucc45\uc0c1\uc5d0\uc11c \ub098\uc628 \ubc1c\uacac\uc740 \uc138 \ubc88\uc9f8 \uc885\uc774 \uc6b8\ub9ac\uae30 \uc804\uae4c\uc9c0 \ubc1c\uba85\uc790\uc758 \uadf8\ub9bc\uc790 \uc544\ub798 \ubd09\ud574 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1031
    inGameDescription: "\uc5f0\uae08\uc220\uc791\uc5c5\ub300\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5f0\uae08\uc220\uc791\uc5c5\ub300\uc5d0\uc11c \ub098\uc628 \ubc1c\uacac\uc740 \uc138 \ubc88\uc9f8 \uc885\uc774 \uc6b8\ub9ac\uae30 \uc804\uae4c\uc9c0 \ubc1c\uba85\uc790\uc758 \uadf8\ub9bc\uc790 \uc544\ub798 \ubd09\ud574 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1032
    inGameDescription: "\uc5f0\uad6c\uc6a9\ucc45\uc7a5\uc5d0 \uc5f0\uad6c \uae30\ub85d\uacfc \ud45c\ubcf8\uc744 \ubd84\ub958\ud574 \ubcf4\uad00\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5f0\uad6c\uc6a9\ucc45\uc7a5\uc5d0\uc11c \ub098\uc628 \ubc1c\uacac\uc740 \uc138 \ubc88\uc9f8 \uc885\uc774 \uc6b8\ub9ac\uae30 \uc804\uae4c\uc9c0 \ubc1c\uba85\uc790\uc758 \uadf8\ub9bc\uc790 \uc544\ub798 \ubd09\ud574 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1033
    inGameDescription: "\uc2dc\uc57d\uc120\ubc18\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc2dc\uc57d\uc120\ubc18\uc5d0\uc11c \ub098\uc628 \ubc1c\uacac\uc740 \uc138 \ubc88\uc9f8 \uc885\uc774 \uc6b8\ub9ac\uae30 \uc804\uae4c\uc9c0 \ubc1c\uba85\uc790\uc758 \uadf8\ub9bc\uc790 \uc544\ub798 \ubd09\ud574 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1034
    inGameDescription: "\ud45c\ubcf8\ubcf4\uad00\uc7a5\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1035
    inGameDescription: "\uc124\uacc4\ud310\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1036
    inGameDescription: "\ub9c8\ub825\uc218\uc815\uc120\ubc18\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \ub9c8\ub825\uc218\uc815\uc120\ubc18\uc758 \uac01 \uce78\uc740 \uc528\uc871\ub9c8\ub2e4 \ud1b1\ub2c8 \ubaa8\uc591\uc774 \ub2ec\ub77c \ube4c\ub9b0 \uacf5\uad6c\uac00 \ub3cc\uc544\uac08 \uc790\ub9ac\ub97c \uc190\uc73c\ub85c\ub3c4 \ucc3e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1037
    inGameDescription: "\ub9c8\ub825\uc800\uc7a5\uc870\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc2dd \ub9c8\ub825\uc800\uc7a5\uc870\uc758 \ub124\ubaa8 \ud648\uc740 \ucd9c\ub825\uc774 \ud754\ub4e4\ub9b4\uc218\ub85d \uae4a\uc5b4\uc838 \uace8\ub818\uc774 \uc190\ub05d\uc73c\ub85c \uace0\uc7a5 \uc9c0\uc810\uc744 \ucc3e\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1038
    inGameDescription: "\ub8ec\uc548\uc815\uae30\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub8ec\uc548\uc815\uae30\uc758 \uc30d\uc778\uc7a5\uc740 \ub9c8\ub098\ub97c \ub304 \uc0ac\ub78c\uacfc \uc4f0\ub294 \uc0ac\ub78c\uc758 \uc190 \ubaa8\uc591\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1039
    inGameDescription: "\uc758\uc2dd \uc911 \uc2dc\uc120\uacfc \ub9c8\ub098\ub97c \ud55c\uacf3\uc5d0 \ubaa8\uc73c\ub3c4\ub85d \uc138\uc6b0\ub294 \ucd08\uc810\uc11d \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1040
    inGameDescription: "\ud6c8\ub828\ud5c8\uc218\uc544\ube44\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc804\ud22c \ub3d9\uc791\uacfc \uc7a5\ube44 \uc0ac\uc6a9\uc744 \uc5f0\uc2b5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc2dd \ud6c8\ub828\ud5c8\uc218\uc544\ube44\uc758 \ubc14\ub2e5\uc5d0\ub294 \uac77\ub294 \uc804\uc0ac\uc640 \ub098\ub294 \uc804\uc0ac\uac00 \uac19\uc740 \ubaa9\ud45c\uc5d0 \ub2ff\ub294 \ub450 \ud6c8\ub828\uc120\uc774 \uadf8\ub824\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
