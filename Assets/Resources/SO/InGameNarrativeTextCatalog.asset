  - kind: 0
    stableId: equipment-item:weapon:shortbow
    inGameDescription: "\uc881\uc740 \ud1b5\ub85c\uc5d0\uc11c\ub3c4 \ube60\ub974\uac8c \ub2f9\uaca8 \uc3e0 \uc218 \uc788\ub294 \uac00\ubcbc\uc6b4 \ud65c\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud478\ub978 \uae43\ub9e4\ub4ed\uc740 \ub2e8\uad81\uc774 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \ubc84\ud17c\ub2e4\ub294 \ud45c\uc2dc\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:shotgun
    inGameDescription: "\uc5ec\ub7ec \ubc1c\uc758 \uc0b0\ud0c4\uc744 \ud55c \ubc88\uc5d0 \ud37c\ub728\ub824 \uac00\uae4c\uc6b4 \uc801 \ubb34\ub9ac\ub97c \uaca8\ub204\ub294 \ud654\uae30\ub2e4. \ud2b9\ud788 \uc624\ub974\ub370\ub098\uc2dd \uc0b0\ud0c4\ucd1d\uc758 \uad70\ubc88\uc740 \uac1c\uba38\ub9ac\ud310 \uae4a\uc219\uc774 \ucc0d\ud600 \uc788\uc5b4 \uce7c\ub85c \uae01\uc5b4\ub3c4 \ud754\uc801\uc774 \ub0a8\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:siege-arbalest
    inGameDescription: "\uc131\ubcbd\uacfc \ub300\ud615 \ud45c\uc801\uc744 \uaff0\ub6ab\ub3c4\ub85d \uad75\uc740 \uc2dc\uc704\uc640 \ubc1b\uce68\uc744 \uc4f4 \uacf5\uc131 \uc1e0\ub1cc\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc2dd \uacf5\uc131 \uc1e0\ub1cc\ub294 \uc881\uc740 \uac31\ub3c4 \ubcbd\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ud65c\ubab8 \uc591\ub05d\uc744 \uc9e7\uac8c \uae4e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:sniper-arquebus
    inGameDescription: "\uae34 \ucd1d\uc2e0\uacfc \uc815\ubc00 \uc870\uc900\ubd80\ub85c \uba3c \ud45c\uc801 \ud558\ub098\ub97c \uaca8\ub204\ub294 \uc544\ucffc\ubc84\uc2a4\ub2e4. \ud2b9\ud788 \uc624\ub974\ub370\ub098\uc2dd \uc800\uaca9 \uc544\ucffc\ubc84\uc2a4\uc758 \uad70\ubc88\uc740 \uac1c\uba38\ub9ac\ud310 \uae4a\uc219\uc774 \ucc0d\ud600 \uc788\uc5b4 \uce7c\ub85c \uae01\uc5b4\ub3c4 \ud754\uc801\uc774 \ub0a8\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:spear
    inGameDescription: "\uc801\uacfc \uac70\ub9ac\ub97c \ub454 \ucc44 \ucc0c\ub974\uace0 \uc804\uc5f4\uc744 \uc138\uc6b0\ub294 \uae30\ubcf8 \uc7a5\ucc3d\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc624\ud06c\ub294 \ubb34\uae30 \ucca0\uc57c\uc5d0 \ucc3d\uc744 \ubc84\ub9ac\uae30 \uc804 \ud760\uc9d1\uc744 \uc190\ub05d\uc73c\ub85c \uc9da\uc73c\uba70 \ub9c8\uc9c0\ub9c9 \uc8fc\uc778\uc758 \uc2f8\uc6c0\uc744 \ub4e4\ub824\uc900\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:throwing-axe
    inGameDescription: "\ud68c\uc804\ud558\uba70 \ub0a0\uc774 \uba3c\uc800 \ub2ff\ub3c4\ub85d \ubb34\uac8c\ub97c \ub9de\ucd98 \uc9e7\uc740 \ud22c\ucc99\ub3c4\ub07c\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc81c \ud22c\ucc99\ub3c4\ub07c\uc5d0\ub294 \ud6a1\ud48d \ucabd\uc73c\ub85c \ud55c \uce58 \ube44\uaef4 \uc7a1\ub294 \uc190\uc790\uad6d\uc774 \ub2f3\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:warhammer
    inGameDescription: "\uc881\uc740 \ud0c0\uaca9\uba74\uc5d0 \ud798\uc744 \ubaa8\uc544 \ud310\uae08\uacfc \ubf08\uc5d0 \ucda9\uaca9\uc744 \uc804\ud558\ub294 \uc804\ud22c\ub9dd\uce58\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \uc804\ud22c\ub9dd\uce58\ub97c \uc218\ub9ac\ud560 \ub54c \uac89\ud310\ubcf4\ub2e4 \uc548\ucabd \uae30\uc5b5\ud310\uc744 \uba3c\uc800 \ub5bc\uc5b4 \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:windlass-crossbow
    inGameDescription: "\uad8c\uc591\uae30\ub85c \ubb34\uac70\uc6b4 \uc2dc\uc704\ub97c \uac10\uc544 \uc62c\ub824 \uac15\ud55c \ubcfc\ud2b8\ub97c \uc3d8\ub294 \uc1e0\ub1cc\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc2dd \uad8c\uc591 \uc11d\uad81\uc740 \uc881\uc740 \uac31\ub3c4 \ubcbd\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \ud65c\ubab8 \uc591\ub05d\uc744 \uc9e7\uac8c \uae4e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment:cold-work-suit
    inGameDescription: "8\u00b0C \ub0c9\uc7a5\uc2e4 \uc0c1\uc2dc \uadfc\ubb34\uc6a9 \uc791\uc5c5\ubcf5\uc774\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uad11\ubd80\ub294 \ubc29\ud55c \uc791\uc5c5\ubcf5\uc758 \uc18c\ub9e4\uc5d0 \uad50\ub300 \uc2dc\uac04\uacfc \uc190\ub05d \uac10\uac01\uc774 \ub3cc\uc544\uc628 \ub54c\ub97c \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment:rune-cold-suit
    inGameDescription: "2\u00b0C \uc7a5\uae30 \uadfc\ubb34\ub97c \uc9c0\uc6d0\ud558\ub418 \uce58\uba85\uc120\uc744 \ubc14\uafb8\uc9c0 \uc54a\ub294 \uc791\uc5c5\ubcf5\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc740 \ub8ec \ubc29\ud55c\ubcf5\uc774 \ubc84\ud2f4 \ub0c9\uae30\uc640 \uc0ac\uc6a9\ud55c \ub9c8\ub098\ub97c \uacc4\uc57d\uc790\uc758 \uc791\uc5c5 \uc2dc\uac04\uacfc \ud568\uaed8 \uacc4\uc0b0\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment:slime-warming-pad
    inGameDescription: "\uc2ac\ub77c\uc784 \uc804\uc6a9 \ucd08\uae30 \uc800\uc628 \uc791\uc5c5\ubcf5\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958 \uce58\ub8cc\uc0ac\ub294 \ubcf4\uc628 \uc810\uc561 \ud328\ub4dc\uac00 \uc2ac\ub77c\uc784\uc758 \ud575 \uc8fc\uc704 \uc628\ub3c4\uc640 \uae30\uc5b5 \ud750\ub984\uc744 \ubc14\uafb8\uc9c0 \uc54a\ub294\uc9c0 \uc0b4\ud540\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: evolution:catalyst:arcane:1
    inGameDescription: "\uac70\uce5c \uc54c\uac31\uc774\ub9cc \uace8\ub77c \uccab \uc870\uc728\uc5d0 \ub9de\ucd98 \uccad\ub78c \uacb0\uc815\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub294 \ube44\uc804 \ucd09\ub9e4 \uc9c4\ud589 1 \u00b7 1\ub4f1\uae09\uc73c\ub85c \ub9c8\ub098 \uacb0\uc744 \uc870\uc728\ud558\ub294 \ube44\uc804 \uacc4\ud1b5\uc758 1\ub4f1\uae09 \uac1c\uc870\uc5d0 \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: evolution:catalyst:arcane:10
    inGameDescription: "\uc138 \ubc88\uc9f8 \ub4f1\uae09\uc758 \uac1c\uc870\uc5d0 \ub9de\ub3c4\ub85d \ubc18\uc751\uc744 \uc548\uc815\uc2dc\ud0a8 \uccad\ub78c \uacb0\uc815\uc774\ub2e4. \ube44\uc804 \ucd09\ub9e4 \uc9c4\ud589 10 \u00b7 3\ub4f1\uae09\uc740 \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc791\uc5c5\ub300\uc5d0\uc11c \ub9c8\ub098 \uacb0\uc744 \uc870\uc728\ud558\ub294 \ube44\uc804 \uacc4\ud1b5\uc758 3\ub4f1\uae09 \uac1c\uc870\uc5d0 \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: evolution:catalyst:arcane:11
    inGameDescription: "\uae34 \uac01\uc778\uc744 \ub418\ub3cc\ub9bc \uc5c6\uc774 \ubc84\ud2f0\ub3c4\ub85d \ub2e8\ub2e8\ud788 \uad73\ud78c \uccad\ub78c \uacb0\uc815\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc870\uc728\uc0ac\ub294 \ube44\uc804 \ucd09\ub9e4 \uc9c4\ud589 11 \u00b7 3\ub4f1\uae09\uc744 \ub9c8\ub098 \uacb0\uc744 \uc870\uc728\ud558\ub294 \ube44\uc804 \uacc4\ud1b5\uc758 3\ub4f1\uae09 \uac1c\uc870\uc5d0 \uc4f4\ub2e4."
