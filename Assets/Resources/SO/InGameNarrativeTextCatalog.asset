  - kind: 0
    stableId: facility-kit:1208
    inGameDescription: "\uacf5\uc5f0 \uce58\ub8cc \uad6c\uc5ed\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \uacf5\uc5f0 \uce58\ub8cc \uad6c\uc5ed\uc5d0\ub294 \uc57d\ubc29\uc758 \ud770 \ud3ec\uc790\uc810\uacfc \uacf5\ub3d9 \uc815\uc6d0\uc758 \ucd08\ub85d \ud3ec\uc790\uc810\uc774 \ud568\uaed8 \ubc15\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1209
    inGameDescription: "\uacf5\uac1c \ud615\ubc8c \uc7a5\uce58\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:13
    inGameDescription: "\ubb34\uae30\uc810\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud560 \uc218 \uc788\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:14
    inGameDescription: "\ud734\uc2dd\ubc29\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:15
    inGameDescription: "\ud6c8\ub828\uc7a5\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\ub294 \ud6c8\ub828\uc7a5\uc758 \uc0ac\uc6a9 \uc21c\uc11c\ub97c \uc885\uc871 \uad6c\ubd84 \uc5c6\uc774 \uc2e4\uc81c \uc791\uc5c5\uacfc \uc0dd\ud65c \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1500
    inGameDescription: "\ubcf4\ud638\uc7a5\ube44\ubcf4\uad00\ud568\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1501
    inGameDescription: "\uc5f4\uc774 \uc313\uc778 \ubc29\uacfc \uc124\ube44\uc5d0\uc11c \uc5f4\uc744 \ube7c\ub0b4 \uc628\ub3c4\ub97c \ub0ae\ucd94\ub294 \ub0c9\uac01\uae30 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub0c9\uac01\uae30\ub294 \ubc24\uc5d0 \uc77c\ud558\ub294 \ubc40\ud30c\uc774\uc5b4 \ucabd\uc740 \uc5b4\ub461\uace0 \uade0\uc0ac \uc8fc\ubbfc \ucabd\uc740 \ucd09\ucd09\ud558\uac8c \ub9de\ucdb0\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1502
    inGameDescription: "\ubc29 \uc548\uc758 \uacf5\uae30\uc640 \uc628\ub3c4\ub97c \uc870\uc808\ud574 \uc791\uc5c5 \ud658\uacbd\uc744 \uc720\uc9c0\ud558\ub294 \uacf5\uc870\uae30 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1503
    inGameDescription: "\ud658\uae30\ub355\ud2b8\ub97c \uc774\uc5b4 \ubc29 \uc0ac\uc774\ub85c \uacf5\uae30\uac00 \ud750\ub974\uac8c \ud558\ub294 \ub355\ud2b8 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1504
    inGameDescription: "\uc1a1\ud48d\uad6c\ub97c \uc774\uc5b4 \ubc29 \uc0ac\uc774\ub85c \uacf5\uae30\uac00 \ud750\ub974\uac8c \ud558\ub294 \ub355\ud2b8 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1505
    inGameDescription: "\ubc30\uae30\ud32c\uc744 \uc774\uc5b4 \ubc29 \uc0ac\uc774\ub85c \uacf5\uae30\uac00 \ud750\ub974\uac8c \ud558\ub294 \ub355\ud2b8 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:16
    inGameDescription: "\uc5f0\uad6c\uc2e4\uc5d0\uc11c \uc790\ub8cc\uc640 \ud45c\ubcf8\uc744 \ub300\uc870\ud574 \uc5f0\uad6c\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5f0\uad6c\uc2e4\uc5d0\uc11c \ub098\uc628 \ubc1c\uacac\uc740 \uc138 \ubc88\uc9f8 \uc885\uc774 \uc6b8\ub9ac\uae30 \uc804\uae4c\uc9c0 \ubc1c\uba85\uc790\uc758 \uadf8\ub9bc\uc790 \uc544\ub798 \ubd09\ud574 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1600
    inGameDescription: "\ubbf8\uc138 \uccb4 \uc120\ubc18\uc740 \uccb4\uc758 \ub208\uae08\ubcc4\ub85c \uc7ac\ub8cc\ub97c \ub098\ub220 \ub450\uace0 \ubd84\ub9d0\uc774 \uc11e\uc774\uc9c0 \uc54a\uac8c \ubcf4\uad00\ud558\ub294 \uc2dc\uc124\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub3c4\uba74\uc740 \uc190 \ud06c\uae30\uac00 \ub2ec\ub77c\ub3c4 \ub9de\ub294 \uccb4\ub97c \ubc14\ub85c \ucc3e\ub3c4\ub85d \uc190\uc7a1\uc774 \ub192\uc774\uc640 \ud45c\uc2dd\uc744 \uc5ec\ub7ec \ub2e8\uacc4\ub85c \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1601
    inGameDescription: "\ub2f4\uae08\u00b7\ub2f9\ud654\uc870\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1602
    inGameDescription: "\uc218\ub3d9 \ubc1c\ud6a8\uc870\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c \uc8fc\ubbfc\uc740 \uc218\ub3d9 \ubc1c\ud6a8\uc870\ub97c \uc5b4\ub290 \ud55c \ub3c4\uc2dc\uc758 \uc18c\uc720\ub85c \ub450\uc9c0 \uc54a\uace0 \uc815\ube44 \uad50\ub300\ub97c \ub098\ub220 \ub9e1\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1603
    inGameDescription: "\uc628\ub3c4 \uc81c\uc5b4 \ubc1c\ud6a8\uc870\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uac74\ucd95\ub300\ub294 \uc628\ub3c4 \uc81c\uc5b4 \ubc1c\ud6a8\uc870\ub97c \uc5ec\ub7ec \uccb4\ud615\uc758 \uc8fc\ubbfc\uc774 \ud568\uaed8 \uc4f8 \uc218 \uc788\ub294 \ub192\uc774\uc640 \ud1b5\ub85c \ud3ed\uc73c\ub85c \uace0\uce5c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1604
    inGameDescription: "\uc220\uacfc \ubc1c\ud6a8 \uc7ac\ub8cc\ub97c \uc77c\uc815 \uae30\uac04 \ubcf4\uad00\ud574 \ub9db\uacfc \ud5a5\uc744 \uc219\uc131\uc2dc\ud0a4\ub294 \uc624\ud06c\ud1b5 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1605
    inGameDescription: "\uc138\ucc99\u00b7\ubcd1\uc785\ub300\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\ub294 \uc138\ucc99\u00b7\ubcd1\uc785\ub300\uc758 \uc0ac\uc6a9 \uc21c\uc11c\ub97c \uc885\uc871 \uad6c\ubd84 \uc5c6\uc774 \uc2e4\uc81c \uc791\uc5c5\uacfc \uc0dd\ud65c \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1606
    inGameDescription: "\ub053\ub294\uc810\uc774 \ub2e4\ub978 \uc561\uccb4 \uc131\ubd84\uc744 \ucc28\ub840\ub85c \ub098\ub204\uc5b4 \ubc1b\ub294 \uc99d\ub958\ud0d1 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\ub294 \ubd84\ubcc4 \uc99d\ub958\ud0d1\uc758 \uc0ac\uc6a9 \uc21c\uc11c\ub97c \uc885\uc871 \uad6c\ubd84 \uc5c6\uc774 \uc2e4\uc81c \uc791\uc5c5\uacfc \uc0dd\ud65c \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1607
    inGameDescription: "\ud654\ub355\u00b7\uac00\ub9c8\uc1a5\uc5d0\uc11c \uc2dd\uc7ac\ub8cc\ub97c \uc190\uc9c8\ud558\uace0 \uc870\ub9ac\ud574 \ub07c\ub2c8\ub97c \ub0b4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ud654\ub355\u00b7\uac00\ub9c8\uc1a5\uc5d0\uc11c\ub294 \ud070\uc1a5\uc758 \ubaab\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc870\ub9ac\uc0ac\uac00 \uc790\uae30 \uadf8\ub987\uc744 \ub4e4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1608
    inGameDescription: "\ubcbd\ub3cc\ub85c \uc5f4\uc744 \uc624\ub798 \uac00\ub450\uc5b4 \ube75\uacfc \uc74c\uc2dd\uc744 \uad7d\ub294 \uc624\ube10 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1609
    inGameDescription: "\uc804\uae30 \uc624\ube10\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1610
    inGameDescription: "\uc138\ucc99\u00b7\uc804\ucc98\ub9ac \uc2f1\ud06c\ub294 \uc7ac\ub8cc\uc758 \ud759\uacfc \uc624\uc5fc\uc744 \uc53b\uace0 \ub2e4\uc74c \uacf5\uc815\uc5d0 \ub118\uae38 \uc900\ube44\ub97c \ud558\ub294 \uc2dc\uc124\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub3c4\uba74\uc740 \uccb4\ud615\uc774 \ub2e4\ub978 \uc8fc\ubbfc\ub3c4 \uc4f0\ub3c4\ub85d \ubc1b\uce68 \ub192\uc774\uc640 \ubc30\uc218 \uc190\uc7a1\uc774 \uc704\uce58\ub97c \uc870\uc808\ud560 \uc218 \uc788\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1611
    inGameDescription: "\ub0c9\uc7a5 \uc900\ube44\ub300\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub0c9\uc7a5 \uc900\ube44\ub300\uc5d0\uc11c\ub294 \ud070\uc1a5\uc758 \ubaab\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc870\ub9ac\uc0ac\uac00 \uc790\uae30 \uadf8\ub987\uc744 \ub4e4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1612
    inGameDescription: "\ud5a5\uc2e0\ub8cc \uc120\ubc18\uc740 \ub9d0\ub9b0 \ud5a5\uc2e0\ub8cc\ub97c \uc885\ub958\ubcc4\ub85c \ub098\ub204\uace0 \uc870\ub9ac \uc911 \ubc14\ub85c \uaebc\ub0bc \uc218 \uc788\uac8c \ub450\ub294 \uc2dc\uc124\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc120\ubc18\uc740 \uae00\uc790\ub97c \ubabb \uc77d\uac70\ub098 \ub0c4\uc0c8\ub97c \ub9e1\uc9c0 \ubabb\ud558\ub294 \uc8fc\ubbfc\ub3c4 \uad6c\ubd84\ud558\ub3c4\ub85d \uc6a9\uae30\ub9c8\ub2e4 \ubaa8\uc591 \ud45c\uc2dd\uc744 \ubd99\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1613
    inGameDescription: "\uc5fc\uc7a5\u00b7\uc808\uc784\uc870\uc5d0\uc11c \uc2dd\uc7ac\ub8cc\ub97c \uc190\uc9c8\ud558\uace0 \uc870\ub9ac\ud574 \ub07c\ub2c8\ub97c \ub0b4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc774 \uaddc\uaca9\uc740 \ud070\uc1a5\uc758 \ubaab\uc5d0 \uc4f0\ub294 \uc2dc\uc124\uc5d0\ub3c4 \ub9de\ub294\ub2e4."
