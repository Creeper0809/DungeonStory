    stableId: facility-kit:1207
    inGameDescription: "\uacf5\uc5f0 \uc704\ud5d8 \uc7a5\uce58\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \uacf5\uc5f0 \uc704\ud5d8 \uc7a5\uce58\uc758 \ubd80\ud488 \uc0c1\uc790\ub294 \ud558\ub298\uae38 \ud55c \uad6c\uac04\uc744 \ub0a0\uc544 \ub098\ub97c \uc218 \uc788\ub294 \ubb34\uac8c\ub97c \ub118\uc9c0 \uc54a\ub294\ub2e4."
