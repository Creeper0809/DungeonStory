    stableId: resource:milk
    inGameDescription: "\uce58\uc988, \ucc44\uc2dd\uc2dd\uacfc \uc57d\ud488\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc6b0\uc720\ud1b5\uc740 \ud587\ube5b\uc744 \uac00\ub9ac\ub294 \uc816\uc740 \ucc9c\uc73c\ub85c \uac10\uc2f8\uba70, \uac80\ubb38\uc18c\uc5d0\uc11c\ub294 \ub69c\uaed1\ubcf4\ub2e4 \uc628\ub3c4\ub97c \uba3c\uc800 \ud655\uc778\ud55c\ub2e4."
    worldBranchTag: 
