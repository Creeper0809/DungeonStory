  - kind: 0
    stableId: resource:mana-crystal
    inGameDescription: "\ud751\uac15, \ub8ec\uac00\uc8fd, \uace0\uae09 \uc57d\ud488\uacfc \ube44\uc804 \uc5f0\uad6c\uc758 \ud575\uc2ec\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc9c0\ub098\ub294 \ub9c8\ub098 \uacb0\uc815\uc740 \uc11c\ub85c \ubd80\ub52a\ud788\uc9c0 \uc54a\uac8c \uce78\ub9c9\uc774 \uc0c1\uc790\uc5d0 \ub2f4\uace0, \uac80\ubb38\uc740 \uc0c1\uc790\ub97c \uc5f4\uc9c0 \uc54a\uace0 \ube5b\uc758 \uc138\uae30\ub85c \ud55c\ub2e4."
    worldBranchTag: 
