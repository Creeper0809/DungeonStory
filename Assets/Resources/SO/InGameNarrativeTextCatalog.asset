    stableId: surgery:prosthetic:stomach
    inGameDescription: "\uc190\uc0c1\ub418\uac70\ub098 \uc783\uc740 \uc704\uc758 \uae30\ub2a5\uc744 \ub300\uc2e0\ud558\ub3c4\ub85d \uc2e0\uccb4\uc5d0 \uc5f0\uacb0\ud558\ub294 \ubcf4\ucca0 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \uc704 \ubcf4\ucca0\uc5d0\ub294 \ubc1b\uc544\ub4e4\uc77c \uc218 \uc788\ub294 \uc74c\uc2dd \ud06c\uae30\uc640 \uc0b0\uc131\ub3c4\uac00 \uc785\uad6c \ub458\ub808\uc758 \ub208\uae08\uc73c\ub85c \ud45c\uc2dc\ub418\uc5b4 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: survival:cooked_meal
    inGameDescription: "\ubc14\ub85c \uba39\uc744 \uc218 \uc788\ub294 \uc2dd\ub7c9\uc774\ub2e4. \ud3ec\ub9cc\uac10\uacfc \uae30\ubd84 \ud68c\ubcf5\uc5d0 \uc88b\ub2e4. \ud558\ub974\ub098\ud06c \uacf5\ub3d9 \ubd80\uc5cc\uc758 \uc870\ub9ac \uc2dd\ub7c9\uc740 \uc885\uc871 \uc774\ub984\ubcf4\ub2e4 \uba39\uc744 \uc218 \uc5c6\ub294 \uc7ac\ub8cc\uc640 \ud544\uc694\ud55c \ubc30\uc2dd \uc2dc\uac04\uc744 \uba3c\uc800 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: survival:preserved_food
    inGameDescription: "\ub9db\uc740 \ub35c\ud558\uc9c0\ub9cc \uc624\ub798 \ubcf4\uad00\ud560 \uc218 \uc788\ub294 \uc2dd\ub7c9\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc5ec\uc12f \ub3c4\uc2dc\ub294 \ubcf4\uc874 \uc2dd\ub7c9\uc758 \ubd09\uc778 \uc0c9\uc744 \ub9de\ucdb0 \uc5b4\ub290 \ub3c4\uc2dc\uc758 \ucc3d\uace0\uc5d0\uc11c\ub3c4 \uc720\ud1b5\uae30\ud55c\uc744 \uc54c\uc544\ubcf4\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: survival:raw_food
    inGameDescription: "\uc870\ub9ac\ud558\uac70\ub098 \ubcf4\uc874\ud558\uc9c0 \uc54a\uc73c\uba74 \uae08\ubc29 \uc0c1\ud558\ub294 \uc2dd\uc7ac\ub8cc\ub2e4. \ud558\ub974\ub098\ud06c \uc7a5\ud130\ub294 \ub0a0 \uc2dd\uc7ac\ub8cc\uc758 \uc885\uc871\ubcc4 \uc18c\uc720 \uad6c\ubd84\uc744 \ubc84\ub9ac\uace0 \uc870\ub9ac \uac00\ub2a5 \uc2dc\uac04\uacfc \uc624\uc5fc \uc704\ud5d8\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: survival:tainted_food
    inGameDescription: "\uba39\uc73c\uba74 \ubcd1\uc744 \ubd80\ub97c \uc218 \uc788\ub294 \uc74c\uc2dd\uc774\ub2e4. \uce58\uc6b0\uac70\ub098 \ubc84\ub824\uc57c \ud55c\ub2e4. \ud558\ub974\ub098\ud06c \uc704\uc0dd\ub300\ub294 \uc624\uc5fc\ub41c \uc74c\uc2dd\uc744 \ubc84\ub9b0 \uc790\ub9ac\uc640 \ud568\uaed8 \uba39\uc740 \uc8fc\ubbfc\uc744 \ud45c\uc2dc\ud574 \ub2e4\uc74c \ud658\uc790\ub97c \ucc3e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: textile:insulating-cloth
    inGameDescription: "\uc808\uc5f0 \uc9c1\ubb3c\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0c1\ub2e8\uc740 \uc808\uc5f0 \uc9c1\ubb3c\uc744 \ud558\ub974\ub098\ud06c \uc7ac\ub2e8\uc18c\uc5d0 \ub118\uae38 \ub54c \ubfd4, \ub0a0\uac1c\uc640 \uaf2c\ub9ac\uc6a9 \uc7ac\ub2e8 \uc5ec\uc720\ub97c \ub530\ub85c \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: textile:quilted-liner
    inGameDescription: "\uc587\uc740 \ucc9c \uc0ac\uc774\uc5d0 \ucda9\uc804\uc7ac\ub97c \uace0\ub974\uac8c \ub123\uace0 \ub204\ubcbc \uc758\ubcf5\uacfc \ubc29\uc5b4\uad6c \uc548\ucabd\uc5d0 \ub367\ub300\ub294 \ub0b4\ud53c\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uce35\uc0c1 \ucda9\uc804\uc7ac \ub450\ub8e8\ub9c8\ub9ac\ub294 \ub20c\ub9b0 \ub450\uaed8\ub97c \ub05d\ub2e8\uc5d0 \uc801\uc5b4 \uc6b4\uc1a1 \ub4a4 \ub2e4\uc2dc \ud3bc\uce60 \uc2dc\uac04\uc744 \uac00\ub2a0\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: textile:sterile-cloth
    inGameDescription: "\ubb34\uade0 \ucc9c\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \ubb34\uade0 \ucc9c\uc740 \uc0b6\uc740 \ub0a0\uc9dc\uc640 \ubd09\uc778\ud55c \uc0ac\ub78c\uc744 \uac89\ud3ec\uc7a5\uc5d0 \uc801\uc73c\uba70, \ud3ec\uc7a5\uc774 \uc816\uac70\ub098 \ucc22\uc5b4\uc9c0\uba74 \uc758\ub8cc\uc6a9\uc73c\ub85c \uc4f0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:administrative-seal
    inGameDescription: "\ud589\uc815 \uc778\uc7a5\uc744 \ubb38\uc11c\uc640 \ud654\ubb3c\ud45c\uc5d0 \ucc0d\uc5b4 \uc2b9\uc778\ud55c \uc0ac\ub78c\uacfc \ucc98\ub9ac \uc21c\uc11c\ub97c \ub0a8\uae34\ub2e4. \uc624\ub974\ub370\ub098 \ub4f1\uae30\uc6d0\uc758 \ud589\uc815 \uc778\uc7a5\uc740 \uc0ac\ub78c, \ud654\ubb3c\uacfc \ud1a0\uc9c0\uc758 \uc774\ub3d9\uc744 \ud5c8\uac00\ud558\uba70 \ucc0d\uc740 \uad00\ub9ac\uc758 \uc774\ub984\uc740 \uacf5\uac1c\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:alloy-crucible
    inGameDescription: "\ud569\uae08 \ub3c4\uac00\ub2c8\ub294 \uc11c\ub85c \ub2e4\ub978 \uae08\uc18d\uc744 \ub192\uc740 \uc5f4\uc5d0\uc11c \ub179\uc774\uace0 \uc11e\uc744 \ub54c \uc4f0\ub294 \ub0b4\uc5f4 \uc6a9\uae30\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \ud569\uae08 \ub3c4\uac00\ub2c8\ub97c \uc7a1\uc73c\uba74 \uc5f4\uacfc \uc9c4\ub3d9\ub9cc\uc73c\ub85c \uc774\uc804 \ubab8\uc5d0\uc11c \uc4f0\ub358 \uacf5\uad6c\uc778\uc9c0 \uc54c\uc544\ubcf8\ub2e4."
