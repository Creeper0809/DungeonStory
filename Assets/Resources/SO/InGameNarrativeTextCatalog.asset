    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1058
    inGameDescription: "\ud654\uc7a5\uc2e4\uce78\ub9c9\uc774\ub85c \uc624\uc5fc\uacfc \uc4f0\ub808\uae30\ub97c \ucc98\ub9ac\ud574 \uc0dd\ud65c \uacf5\uac04\uc744 \uae68\ub057\uc774 \uc720\uc9c0\ud558\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
