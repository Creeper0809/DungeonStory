    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1095
    inGameDescription: "\uc57c\uc678 \uacbd\uc791\uc9c0\uc5d0 \uc528\uc557\uc744 \uc2ec\uace0 \uc791\ubb3c\uc758 \uc131\uc7a5 \uc0c1\ud0dc\ub97c \ub3cc\ubcf4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1096
    inGameDescription: "\uc2e4\ub0b4 \uc7ac\ubc30\uc870\uc5d0 \uc528\uc557\uc744 \uc2ec\uace0 \uc791\ubb3c\uc758 \uc131\uc7a5 \uc0c1\ud0dc\ub97c \ub3cc\ubcf4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1097
    inGameDescription: "\ud3d0\uae30 \uc18c\uac01\ub85c\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:11
    inGameDescription: "\uace0\uae30 \uc2dd\ub2f9\uc5d0\uc11c \uc8fc\ubbfc\uacfc \uc190\ub2d8\uc5d0\uac8c \uc74c\uc2dd\uc744 \ub0b4\uace0 \uac12\uc744 \ubc1b\uc744 \uc218 \uc788\uac8c \uc2dd\ud0c1\uacfc \ubc30\uc2dd \uc124\ube44\ub97c \ubb36\uc740 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uace0\uae30 \uc2dd\ub2f9\uc5d0\uc11c\ub294 \ud070\uc1a5\uc758 \ubaab\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc870\ub9ac\uc0ac\uac00 \uc790\uae30 \uadf8\ub987\uc744 \ub4e4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:12
    inGameDescription: "\uc7a1\ud654\uc810\uc5d0 \uc0c1\ud488\uc744 \uc9c4\uc5f4\ud558\uace0 \uc190\ub2d8\uacfc \uac70\ub798\ud560 \uc218 \uc788\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1200
    inGameDescription: "\uac10\ubc29 \uad6c\uc18d\ub300\uc5d0 \ud3ec\ub85c\ub97c \uc218\uc6a9\ud558\uace0 \uc774\ub3d9\uc744 \uc81c\ud55c\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1201
    inGameDescription: "\uc911\uc559 \ubb34\ub300\uc5d0\uc11c \uacf5\uc5f0\uc790\uac00 \uad00\uac1d \uc55e\uc5d0 \uc124 \uc218 \uc788\ub3c4\ub85d \ubb34\ub300\uc640 \ub3d9\uc120\uc744 \uac16\ucd98 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc911\uc559 \ubb34\ub300\uc5d0\uc11c \ub09c \uc6c3\uc74c\uacfc \uc0ac\uace0\ub294 \ub2e4\uc74c \ub0a0 \uc0c8\ubcbd \ud569\ucc3d\uc758 \uc11c\ub85c \ub2e4\ub978 \uc74c\uc73c\ub85c \ub3c4\uc2dc \uc804\uccb4\uc5d0 \ud37c\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1202
    inGameDescription: "\uc11c\ucee4\uc2a4 \uad00\ub78c\uc11d\uc5d0 \uc8fc\ubbfc\uacfc \uc190\ub2d8\uc774 \uc549\uc544 \uc26c\uac70\ub098 \uc2dd\uc0ac\ud560 \uc218 \uc788\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1203
    inGameDescription: "\uc57c\uc218 \uc6b0\ub9ac\uc5d0 \uac00\ucd95\uc744 \ub4e4\uc774\uace0 \uba39\uc774\uc640 \uc548\uc804\uc744 \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1204
    inGameDescription: "\uc11c\ucee4\uc2a4 \ub9e4\ud45c\uc18c\uc5d0\uc11c \uad00\ub78c\ub8cc\ub97c \ubc1b\uace0 \uc785\uc7a5 \uc778\uc6d0\uc744 \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1205
    inGameDescription: "\uc11c\ucee4\uc2a4 \ub3c4\ubc15 \ucc3d\uad6c\uc5d0\uc11c \ub0b4\uae30\uc640 \ud310\ub3c8\uc744 \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
