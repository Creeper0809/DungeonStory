  - kind: 0
    stableId: equipment-item:weapon:matchlock-pistol
    inGameDescription: "\uc881\uc740 \uacf3\uc5d0\uc11c \ud55c \uc190\uc73c\ub85c \uaebc\ub0b4 \uc3e0 \uc218 \uc788\uac8c \ucd1d\uc2e0\uc744 \uc904\uc778 \ud654\uc2b9\ucd1d\uc774\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \ud654\uc2b9 \uad8c\ucd1d\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
