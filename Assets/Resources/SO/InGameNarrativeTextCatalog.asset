  - kind: 0
    stableId: tool:banquet-cart
    inGameDescription: "\uc5f0\ud68c \uc6b4\ubc18 \uc218\ub808\ub294 \uc5ec\ub7ec \uc811\uc2dc\uc640 \uc220\ubcd1\uc744 \ud55c\uaebc\ubc88\uc5d0 \uac1d\uc11d\uacfc \uc2dd\ud0c1\uc73c\ub85c \ub098\ub978\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uacf5\ub3d9 \uc5f0\ud68c \uc6b4\ubc18 \uc218\ub808\uc5d0\ub294 \uac80\ubb38\uc18c\ub97c \uc9c0\ub0a0 \ub54c\ub9c8\ub2e4 \ub2e4\ub978 \uc0c9\uc2e4\uc774 \uc190\uc7a1\uc774\uc5d0 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:deep-shaft-hoist
    inGameDescription: "\uc2ec\ubd80 \uc2b9\uac15\uae30\ub294 \uae4a\uc740 \uac31\ub3c4\uc5d0\uc11c \uad11\uc11d\uacfc \uc791\uc5c5\uc790\ub97c \uc904\uacfc \uad8c\uc591\uae30\ub85c \ub04c\uc5b4\uc62c\ub9b0\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30\ub97c \ub9c8\uce5c \uc2ec\ubd80 \uc2b9\uac15\uae30\uc5d0\ub294 \uccab \uce21\uc815\uac12\uacfc \ub3c4\uc81c\uc758 \ubcc4\uba85\uc774 \ub098\ub780\ud788 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:field-repair-kit
    inGameDescription: "\uc57c\uc804 \uc218\ub9ac \ud0a4\ud2b8\uc5d0\ub294 \uc815\ucc29\uc9c0 \ubc16\uc5d0\uc11c \uc7a5\ube44\uc758 \ub290\uc2a8\ud55c \uacb0\ud569\uacfc \ud30c\uc190\uc744 \uc751\uae09 \uc218\ub9ac\ud560 \ub3c4\uad6c\uac00 \ub4e4\uc5b4 \uc788\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uacf5\ub3d9 \uc57c\uc804 \uc218\ub9ac \ud0a4\ud2b8\uc5d0\ub294 \uac80\ubb38\uc18c\ub97c \uc9c0\ub0a0 \ub54c\ub9c8\ub2e4 \ub2e4\ub978 \uc0c9\uc2e4\uc774 \uc190\uc7a1\uc774\uc5d0 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:hauling-harness
    inGameDescription: "\uc6b4\ubc18 \uba5c\ube75\uc740 \uc9d0\uc758 \ubb34\uac8c\ub97c \uc5b4\uae68\uc640 \ud5c8\ub9ac\uc5d0 \ub098\ub220 \uc2e3\ub3c4\ub85d \ub048\uacfc \uace0\ub9ac\ub97c \uc5f0\uacb0\ud55c\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uacf5\ub3d9 \uc6b4\ubc18 \uba5c\ube75\uc5d0\ub294 \uac80\ubb38\uc18c\ub97c \uc9c0\ub0a0 \ub54c\ub9c8\ub2e4 \ub2e4\ub978 \uc0c9\uc2e4\uc774 \uc190\uc7a1\uc774\uc5d0 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:inspection-gauge
    inGameDescription: "\uac80\uc0ac \uac8c\uc774\uc9c0\ub85c \uc0dd\uc0b0\ud488\uc758 \ub450\uaed8\uc640 \uac04\uaca9\uc774 \uc791\uc5c5 \uaddc\uaca9\uc5d0 \ub9de\ub294\uc9c0 \ube60\ub974\uac8c \uac00\ub9b0\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30\ub97c \ub9c8\uce5c \uac80\uc0ac \uac8c\uc774\uc9c0\uc5d0\ub294 \uccab \uce21\uc815\uac12\uacfc \ub3c4\uc81c\uc758 \ubcc4\uba85\uc774 \ub098\ub780\ud788 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:maintenance-kit
    inGameDescription: "\uc815\ube44 \ud0a4\ud2b8\uc5d0\ub294 \uc2dc\uc124\uc758 \ub9c8\ubaa8 \ubd80\uc704\ub97c \uc870\uc774\uace0 \ub2e6\uace0 \uad50\uccb4\ud558\ub294 \uae30\ubcf8 \uacf5\uad6c\uac00 \ubaa8\uc5ec \uc788\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30\ub97c \ub9c8\uce5c \uc815\ube44 \ud0a4\ud2b8\uc5d0\ub294 \uccab \uce21\uc815\uac12\uacfc \ub3c4\uc81c\uc758 \ubcc4\uba85\uc774 \ub098\ub780\ud788 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:mana-probe
    inGameDescription: "\ub9c8\ub098 \ud0d0\uce68\uc740 \uc7ac\ub8cc\uc640 \uc7a5\uce58\uc5d0 \ud750\ub974\ub294 \ub9c8\ub098\uc758 \ubc29\ud5a5\uacfc \ubd88\uc548\uc815\ud55c \uc9c0\uc810\uc744 \ucc3e\ub294\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub9c8\ub098 \ud0d0\uce68\uc740 \uacc4\uc57d\uc790\uc758 \ub9e8\uc190\uc774 \ub2ff\uc544\uc57c \ub8ec\uc774 \ub05d\uae4c\uc9c0 \ubc1d\uc544\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:powered-tool-head
    inGameDescription: "\ub3d9\ub825 \uacf5\uad6c\ub0a0\uc740 \uad6c\ub3d9\ucd95\uc5d0 \uac08\uc544 \ub07c\uc6cc \uc808\ub2e8\uacfc \uad74\ucc29 \uc791\uc5c5\uc744 \ub9e1\uae30\ub294 \uad50\uccb4 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \ub3d9\ub825 \uacf5\uad6c\ub0a0\uc744 \uc7a1\uc73c\uba74 \uc5f4\uacfc \uc9c4\ub3d9\ub9cc\uc73c\ub85c \uc774\uc804 \ubab8\uc5d0\uc11c \uc4f0\ub358 \uacf5\uad6c\uc778\uc9c0 \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:precision-gauge
    inGameDescription: "\uc815\ubc00 \uac8c\uc774\uc9c0\ub294 \ub208\uc73c\ub85c \uac00\ub9ac\uae30 \uc5b4\ub824\uc6b4 \uc791\uc740 \uc624\ucc28\uae4c\uc9c0 \uc7ac\uc5b4 \uace0\uae09 \uc81c\uc791\ud488\uc744 \uac80\uc0ac\ud55c\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30\ub97c \ub9c8\uce5c \uc815\ubc00 \uac8c\uc774\uc9c0\uc5d0\ub294 \uccab \uce21\uc815\uac12\uacfc \ub3c4\uc81c\uc758 \ubcc4\uba85\uc774 \ub098\ub780\ud788 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:prisoner-work-kit
    inGameDescription: "\ud3ec\ub85c \uc791\uc5c5 \ub3c4\uad6c\ub294 \ud5c8\uc6a9\ub41c \uc791\uc5c5\uc5d0 \ud544\uc694\ud55c \uacf5\uad6c\ub9cc \ucd94\ub824 \uc218\ub7c9\uacfc \ubc18\ub0a9\uc744 \uad00\ub9ac\ud558\ub294 \uafb8\ub7ec\ubbf8\ub2e4. \uc624\ub974\ub370\ub098\uc81c \ud3ec\ub85c \uc791\uc5c5 \ub3c4\uad6c\uc5d0\ub294 \ud3ec\ub85c \uc774\ub984\ubcf4\ub2e4 \uac10\uc2dc\uc790 \ubc88\ud638\uac00 \ub354 \uae4a\uac8c \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:prospecting-kit
    inGameDescription: "\ud0d0\uad11 \ud0a4\ud2b8\uc5d0\ub294 \uc554\uc11d\uce35\uc744 \uae68\uace0 \ud45c\ubcf8\uc744 \ub2f4\uc544 \uad11\ub9e5\uc758 \ubc29\ud5a5\uc744 \ucc3e\ub294 \ub3c4\uad6c\uac00 \ub4e4\uc5b4 \uc788\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30\ub97c \ub9c8\uce5c \ud0d0\uad11 \ud0a4\ud2b8\uc5d0\ub294 \uccab \uce21\uc815\uac12\uacfc \ub3c4\uc81c\uc758 \ubcc4\uba85\uc774 \ub098\ub780\ud788 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:reinforced-restraint
    inGameDescription: "\uac15\ud654 \uad6c\uc18d\uad6c\ub294 \uc190\ubc1c\uc758 \uc6c0\uc9c1\uc784\uc744 \uc81c\ud55c\ud558\uace0 \uc7a0\uae08 \uc0c1\ud0dc\ub97c \uc810\uac80\ud560 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc7a5\uad6c\ub2e4. \uc624\ub974\ub370\ub098\uc81c \uac15\ud654 \uad6c\uc18d\uad6c\uc5d0\ub294 \ud3ec\ub85c \uc774\ub984\ubcf4\ub2e4 \uac10\uc2dc\uc790 \ubc88\ud638\uac00 \ub354 \uae4a\uac8c \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:rune-identification-lens
    inGameDescription: "\ub8ec \uc2dd\ubcc4 \ub80c\uc988\ub294 \ub2f3\uac70\ub098 \uacb9\uccd0\uc9c4 \uac01\uc778\uc744 \ud655\ub300\ud574 \uacc4\ud1b5\uacfc \uc81c\uc791 \ud754\uc801\uc744 \uc77d\ub294\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub8ec \uc2dd\ubcc4 \ub80c\uc988\ub294 \uacc4\uc57d\uc790\uc758 \ub9e8\uc190\uc774 \ub2ff\uc544\uc57c \ub8ec\uc774 \ub05d\uae4c\uc9c0 \ubc1d\uc544\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:sewing-kit
    inGameDescription: "\uc7ac\ubd09 \ub3c4\uad6c\uc5d0\ub294 \uc758\ubcf5\uc744 \ub9cc\ub4e4\uace0 \ucc22\uc5b4\uc9c4 \uc194\uae30\ub97c \uace0\uce60 \ubc14\ub298\uacfc \uc2e4, \uac00\uc704\uac00 \ub4e4\uc5b4 \uc788\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uacf5\ub3d9 \uc7ac\ubd09 \ub3c4\uad6c\uc5d0\ub294 \uac80\ubb38\uc18c\ub97c \uc9c0\ub0a0 \ub54c\ub9c8\ub2e4 \ub2e4\ub978 \uc0c9\uc2e4\uc774 \uc190\uc7a1\uc774\uc5d0 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:watch-signal-horn
    inGameDescription: "\uacbd\uacc4 \uc2e0\ud638 \ub098\ud314\uc740 \uce68\uc785\uacfc \ud654\uc7ac \uac19\uc740 \uc704\ud5d8\uc744 \uba40\ub9ac \uc788\ub294 \uc8fc\ubbfc\uc5d0\uac8c \uc54c\ub9b0\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc0c8\ubcbd \ud569\ucc3d\uc740 \uacbd\uacc4 \uc2e0\ud638 \ub098\ud314\ub85c \ud655\uc778\ud55c \ub0a0\uc528\uc640 \uacbd\ubcf4\ub97c \ubb38\uc790\ubcf4\ub2e4 \uba3c\uc800 \ud558\ub298\uae38\uc5d0 \uc804\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: tool:weather-observation-kit
    inGameDescription: "\uae30\uc0c1 \uad00\uce21 \ub3c4\uad6c\ud568\uc73c\ub85c \ubc14\ub78c\uacfc \ube44, \uae30\uc628\uc758 \ubcc0\ud654\ub97c \uae30\ub85d\ud574 \ub18d\uc0ac\uc640 \uc6d0\uc815\uc744 \uc900\ube44\ud55c\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc0c8\ubcbd \ud569\ucc3d\uc740 \uae30\uc0c1 \uad00\uce21 \ub3c4\uad6c\ud568\uc73c\ub85c \ud655\uc778\ud55c \ub0a0\uc528\uc640 \uacbd\ubcf4\ub97c \ubb38\uc790\ubcf4\ub2e4 \uba3c\uc800 \ud558\ub298\uae38\uc5d0 \uc804\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: waste:animal-rot
    inGameDescription: "\uc0c1\ud55c \ub3d9\ubb3c\uc131 \uc74c\uc2dd. \uc721\uc2dd\ub3d9\ubb3c \uc0ac\ub8cc\uc640 \uc5f0\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c\ub294 \ub3d9\ubb3c\uc131 \ubd80\ud328\ubb3c\uc5d0\uc11c \ubf08\uc640 \uc9c0\ubc29\uc744 \uba3c\uc800 \uac77\uc5b4 \uc0ac\ub8cc, \uc5f0\ub8cc\uc640 \ud1f4\ube44\uc758 \ud750\ub984\uc744 \ubd84\ub9ac\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: waste:forbidden-rot
    inGameDescription: "\uae08\uae30 \uc7ac\ub8cc\uac00 \uc11e\uc778 \uc624\uc5fc\ub41c \ubd80\ud328\ubb3c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\ub294 \uae08\uae30 \ubd80\ud328\ubb3c\uc744 \ubcc4\ub3c4 \uade0\uc0ac\ubc2d\uc5d0 \ubb3b\uace0 \uc5b4\ub514\uc11c \ub098\uc628 \uc7ac\ub8cc\uc778\uc9c0 \uc9c0\uc6b0\uc9c0 \uc54a\uc740 \ucc44 \ubd84\ud574 \uacfc\uc815\uc744 \uc9c0\ucf1c\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: waste:mixed-rot
    inGameDescription: "\uc7ac\ub8cc\uac00 \uc11e\uc5ec \uc2dd\uc131\uc744 \uad6c\ubd84\ud558\uae30 \uc5b4\ub824\uc6b4 \ubd80\ud328\ubb3c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc815\uc6d0\uc9c0\uae30\ub294 \ud63c\ud569 \ubd80\ud328\ubb3c\uc744 \ubc14\ub85c \ud1f4\ube44\ub85c \uc4f0\uc9c0 \uc54a\uace0 \ub3c5\uc131\uacfc \ud3ec\uc790 \ubc18\uc751\uc744 \uc791\uc740 \ud759\ubc2d\uc5d0\uc11c \uba3c\uc800 \uc2dc\ud5d8\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: waste:plant-rot
    inGameDescription: "\uc0c1\ud55c \uc2dd\ubb3c\uc131 \uc74c\uc2dd. \ud1f4\ube44\uc640 \uc800\uae09 \uc0ac\ub8cc\ub85c \uc4f8 \uc218 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c\ub294 \uc2dd\ubb3c\uc131 \ubd80\ud328\ubb3c\uc744 \uac70\ub454 \ubc2d\uc73c\ub85c \ub418\ub3cc\ub824 \ubcf4\ub0b4 \ub2e4\uc74c \uc218\ud655\uae4c\uc9c0 \ud759\uc774 \ud68c\ubcf5\ub418\ub294 \uc2dc\uac04\uc744 \uc7b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:ash_crawler
    inGameDescription: "\uc7ac \ub354\ubbf8\ub97c \uba39\uace0 \ud658\uae30\uad6c\uc5d0 \uad70\uc9d1\ud574 \uc7ac\uba3c\uc9c0\ud3d0\ub97c \ud37c\ub728\ub9b0\ub2e4. \uc8fd\uc740 \uc7ac\uba3c\uc9c0 \uae30\ub294\ubc8c\ub808\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud654\uad6c \uc0ac\ub0e5\uafbc\uc774 \uac70\ub454 \uc7ac\uba3c\uc9c0 \uae30\ub294\ubc8c\ub808 \uc0ac\uccb4\uc5d0\ub294 \uacc4\uc57d \ubaab\uc744 \ub73b\ud558\ub294 \uac80\uc740 \ubc00\ub78d\uc774 \ud55c \ubc29\uc6b8 \ub5a8\uc5b4\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:ash_goat
    inGameDescription: "\uc57c\uc0dd\uc5d0\uc11c \ud68c\uc218\ud55c \uc7bf\ube5b \uc0b0\uc591\uc758 \uc0ac\uccb4\ub2e4. \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uae30\uba74 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\uc744 \uc5bb\uc744 \uc218 \uc788\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud654\uad6c \uc0ac\ub0e5\uafbc\uc774 \uac70\ub454 \uc7bf\ube5b \uc0b0\uc591 \uc0ac\uccb4\uc5d0\ub294 \uacc4\uc57d \ubaab\uc744 \ub73b\ud558\ub294 \uac80\uc740 \ubc00\ub78d\uc774 \ud55c \ubc29\uc6b8 \ub5a8\uc5b4\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:carrion_drake
    inGameDescription: "\uc804\uc7a5\uacfc \ub3c4\uc0b4\uc7a5\uc758 \uc0ac\uccb4\ub97c \ucc3e\uc544\uc624\uba70 \ubcd1\uc6d0\uccb4\ub97c \uba3c \uac70\ub9ac\ub85c \uc62e\uae34\ub2e4. \uc8fd\uc740 \uc2dc\uccb4\uccad\uc18c \ube44\ub8e1\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud558\ud53c\ub294 \uc2dc\uccb4\uccad\uc18c \ube44\ub8e1 \uc0ac\uccb4\ub97c \ud558\ub298\uae38\uc758 \ubc14\ub78c\uacfc \ub9c8\ub098 \ud750\ub984\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc9d5\uc870\ub85c \uc77d\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:cave_hound
    inGameDescription: "\ubb34\ub9ac \uc0ac\ub0e5\uc744 \ud558\uba70 \uae38\ub4e4\uc774\uba74 \uacbd\ube44\uc640 \ucd94\uc801\uc5d0 \uc4f8 \uc218 \uc788\ub2e4. \uc8fd\uc740 \ub3d9\uad74\uc0ac\ub0e5\uac1c\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \ub3d9\uad74\uc0ac\ub0e5\uac1c \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:cave_rat
    inGameDescription: "\ub358\uc804 \uc678\uacfd\uc758 \ud2c8 \uc0ac\uc774\ub97c \ube60\ub974\uac8c \uae30\uc5b4 \ub2e4\ub2c8\ub294 \uc791\uc740 \uc124\uce58\ub958. \uace0\uae30\ub294 \uc801\uc9c0\ub9cc \ucd08\ubc18 \uc2dd\ub7c9\uc73c\ub85c \uc4f8 \uc218 \uc788\ub2e4. \uc8fd\uc740 \ub3d9\uad74\uc950\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \ub3d9\uad74\uc950 \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:crystal_beetle
    inGameDescription: "\ub9c8\ub098 \uacb0\uc815 \uac00\ub8e8\ub97c \uba39\uace0 \ub2e8\ub2e8\ud55c \uac11\uac01\uc744 \ub0a8\uae30\ub294 \uad70\uc9d1 \uace4\ucda9\uc774\ub2e4. \uc8fd\uc740 \uc218\uc815\ub531\uc815\ubc8c\ub808\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \uc218\uc815\ub531\uc815\ubc8c\ub808 \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:deep_goat
    inGameDescription: "\uc808\ubcbd \uc774\ub07c\ub97c \uba39\uace0 \uae38\ub4e4\uc77c \uc218 \uc788\uc5b4 \ud138\uacfc \uc6b4\ubc18 \ub178\ub3d9\uc744 \uc81c\uacf5\ud55c\ub2e4. \uc8fd\uc740 \uc2ec\uce35\uc5fc\uc18c\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \uc2ec\uce35\uc5fc\uc18c \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:ember_lizard
    inGameDescription: "\ub728\uac70\uc6b4 \ubc30\uad00 \uc8fc\ubcc0 \ud574\ucda9\uc744 \uba39\uc9c0\ub9cc \uc7bf\ubd88\uc5f4\uc744 \ub9e4\uac1c\ud55c\ub2e4. \uc8fd\uc740 \uc7bf\ubd88\ub3c4\ub9c8\ubc40\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud654\uad6c \uc0ac\ub0e5\uafbc\uc774 \uac70\ub454 \uc7bf\ubd88\ub3c4\ub9c8\ubc40 \uc0ac\uccb4\uc5d0\ub294 \uacc4\uc57d \ubaab\uc744 \ub73b\ud558\ub294 \uac80\uc740 \ubc00\ub78d\uc774 \ud55c \ubc29\uc6b8 \ub5a8\uc5b4\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:frost_ram
    inGameDescription: "\uaca8\uc6b8\uc5d0 \ud65c\ub3d9\ud558\ub294 \ub300\ud615 \ucd08\uc2dd\ub3d9\ubb3c\ub85c \uae38\ub4e4\uc774\uba74 \ud138\uacfc \uc6b4\ubc18\ub825\uc744 \uc81c\uacf5\ud55c\ub2e4. \uc8fd\uc740 \uc11c\ub9ac\uc22b\uc591\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \uc11c\ub9ac\uc22b\uc591 \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:glow_moth
    inGameDescription: "\ub9c8\ub098 \ube5b\uc744 \ub530\ub77c \uc774\ub3d9\ud558\uba70 \ubc84\uc12f \ud3ec\uc790\ub97c \uc62e\uae30\ub294 \uc791\uc740 \uacc4\uc808 \uace4\ucda9\uc774\ub2e4. \uc8fd\uc740 \ubc1c\uad11\ub098\ubc29\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud558\ud53c\ub294 \ubc1c\uad11\ub098\ubc29 \uc0ac\uccb4\ub97c \ud558\ub298\uae38\uc758 \ubc14\ub78c\uacfc \ub9c8\ub098 \ud750\ub984\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc9d5\uc870\ub85c \uc77d\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:mana_wisp
    inGameDescription: "\uc804\ub825\ub9dd \ub204\ucd9c\uc744 \ub530\ub77c \ubaa8\uc774\uba70 \ub2e4\ub978 \ube44\uc804 \uc0dd\ubb3c\uc744 \ub04c\uc5b4\ub4e4\uc778\ub2e4. \uc8fd\uc740 \ub9c8\ub098\ub3c4\uae68\ube44\ubd88\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud558\ud53c\ub294 \ub9c8\ub098\ub3c4\uae68\ube44\ubd88 \uc0ac\uccb4\ub97c \ud558\ub298\uae38\uc758 \ubc14\ub78c\uacfc \ub9c8\ub098 \ud750\ub984\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc9d5\uc870\ub85c \uc77d\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:mire_leech
    inGameDescription: "\uc624\uc5fc\ub41c \ubb3c\uc5d0\uc11c \ubc88\uc2dd\ud574 \uac00\ucd95\uacfc \uc9c1\uc6d0\uc744 \ud761\ud608\ud55c\ub2e4. \uc8fd\uc740 \uc9c4\ud759\uac70\uba38\ub9ac\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc815\uc6d0\uc9c0\uae30\ub294 \uc9c4\ud759\uac70\uba38\ub9ac \uc0ac\uccb4\uc5d0\uc11c \uac74\uc9c4 \ud3ec\uc790\ub97c \uc8fd\uc774\uc9c0 \uc54a\uace0 \uac80\uc740 \ud759\ub3c5\uc5d0 \ub530\ub85c \uc7ac\uc6b4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:moss_boar
    inGameDescription: "\ucd95\ucd95\ud55c \ud138\uacfc \ub2e8\ub2e8\ud55c \uac00\uc8fd\uc744 \uac00\uc9c4 \uc9d0\uc2b9. \ubab0\ub9ac\uba74 \ub4e4\uc774\ubc1b\ub294\ub2e4. \uc8fd\uc740 \uc774\ub07c\uba67\ub3fc\uc9c0\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \uc774\ub07c\uba67\ub3fc\uc9c0 \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:rune_deer
    inGameDescription: "\ubab8\uc5d0 \ud750\ub9bf\ud55c \ub8ec\ube5b\uc774 \ub3c4\ub294 \ud76c\uadc0\ud55c \ucd08\uc2dd\ub3d9\ubb3c. \uace0\uae30\uc640 \ub9c8\ub098 \ubd80\uc0b0\ubb3c\uc744 \ub0a8\uae34\ub2e4. \uc8fd\uc740 \ub8ec\uc0ac\uc2b4\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \ub8ec\uc0ac\uc2b4 \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:shadow_hare
    inGameDescription: "\ubc1c\uc18c\ub9ac\ubcf4\ub2e4 \uadf8\ub9bc\uc790\uac00 \uba3c\uc800 \ud280\uc5b4\ub098\uac00\ub294 \uc791\uc740 \uc9d0\uc2b9. \uc704\ud5d8\uc740 \ub0ae\uc9c0\ub9cc \ub9e4\uc6b0 \ube60\ub974\ub2e4. \uc8fd\uc740 \uadf8\ub9bc\uc790\ud1a0\ub07c\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \uadf8\ub9bc\uc790\ud1a0\ub07c \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:shadow_wolf
    inGameDescription: "\ubc24\uae38\uacfc \uc785\uad6c \uc8fc\ubcc0\uc744 \ub9f4\ub3c4\ub294 \ud3ec\uc2dd\uc790. \uac15\ud55c \uc1a1\uacf3\ub2c8\uc640 \uac00\uc8fd \ubd80\uc0b0\ubb3c\uc744 \ub0a8\uae34\ub2e4. \uc8fd\uc740 \uadf8\ub9bc\uc790\ub291\ub300\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \uadf8\ub9bc\uc790\ub291\ub300 \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:silk_spider
    inGameDescription: "\ubc1c\uad11\ub098\ubc29\uc744 \uc7a1\uace0 \ucc44\uc9d1 \uac00\ub2a5\ud55c \uc9c8\uae34 \uac70\ubbf8\uc904\uc744 \ub9cc\ub4e0\ub2e4. \uc8fd\uc740 \ub3d9\uad74\uba85\uc8fc\uac70\ubbf8\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \ub3d9\uad74\uba85\uc8fc\uac70\ubbf8 \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:spore_elk
    inGameDescription: "\uade0\uc0ac \uc815\uc6d0\uc758 \ud3ec\uc790\ub97c \uba40\ub9ac \ud37c\ub728\ub9ac\ub294 \ub300\ud615 \ucd08\uc2dd\ub3d9\ubb3c\uc774\ub2e4. \uc8fd\uc740 \ud3ec\uc790\ud070\uc0ac\uc2b4\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc815\uc6d0\uc9c0\uae30\ub294 \ud3ec\uc790\ud070\uc0ac\uc2b4 \uc0ac\uccb4\uc5d0\uc11c \uac74\uc9c4 \ud3ec\uc790\ub97c \uc8fd\uc774\uc9c0 \uc54a\uace0 \uac80\uc740 \ud759\ub3c5\uc5d0 \ub530\ub85c \uc7ac\uc6b4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:tunnel_mole
    inGameDescription: "\ubfcc\ub9ac \uc791\ubb3c\uc744 \ud574\uce58\uc9c0\ub9cc \uae38\ub4e4\uc778 \uac1c\uccb4\ub294 \uc595\uc740 \uad11\ub9e5\uc744 \ucc3e\ub294\ub2e4. \uc8fd\uc740 \uad74\ucc29\ub450\ub354\uc9c0\uc758 \uc0ac\uccb4\ub294 \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uaca8 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\ub85c \ub098\ub208\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0ac\ub0e5\uafbc\uc740 \uad74\ucc29\ub450\ub354\uc9c0 \uc0ac\uccb4\ub97c \ubb36\uc740 \ub048\uc5d0 \ubc1c\uacac\ud55c \ub208\uae38\uacfc \ubb34\ub108\uc9c4 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:carcass:twilight_chicken
    inGameDescription: "\uc57c\uc0dd\uc5d0\uc11c \ud68c\uc218\ud55c \ud669\ud63c\ub2ed\uc758 \uc0ac\uccb4\ub2e4. \ub3c4\ucd95 \uc2dc\uc124\ub85c \uc62e\uae30\uba74 \uc2dd\ub7c9\uacfc \ubd80\uc0b0\ubb3c\uc744 \uc5bb\uc744 \uc218 \uc788\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ub294 \ud669\ud63c\ub2ed \uc0ac\uccb4\uc5d0\uc11c \uc5bb\uc740 \uace0\uae30\uc640 \uac00\uc8fd\uc744 \uc0ac\ub0e5\ud55c \uc0ac\ub78c\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uc758 \ud544\uc694\uc5d0 \ub530\ub77c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: wild:rot
    inGameDescription: "\uba39\uac70\ub098 \uac00\uacf5\ud560 \uc218 \uc5c6\uc744 \ub9cc\ud07c \uc369\uc740 \uc720\uae30\ubb3c\uc774\ub2e4. \ubc29\uce58\ud558\uba74 \uc704\uc0dd\uacfc \uc9c8\ubcd1 \uad00\ub9ac\uc5d0 \ubd80\ub2f4\uc774 \ub41c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc815\uc6d0\uc9c0\uae30\ub294 \ubd80\ud328\ubb3c\uc5d0\uc11c \uac74\uc9c4 \ud3ec\uc790\ub97c \uc8fd\uc774\uc9c0 \uc54a\uace0 \uac80\uc740 \ud759\ub3c5\uc5d0 \ub530\ub85c \uc7ac\uc6b4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: yarn:cave-silk
    inGameDescription: "\ub3d9\uad74 \ube44\ub2e8 \uc12c\uc720\ub97c \uaf2c\uc544 \uad75\uae30\ub97c \ub9de\ucd98 \uc2e4\uc774\ub2e4. \uc9c1\ubb3c\uacfc \uc758\ubcf5\uc744 \uc9dc\ub294 \ub2e4\uc74c \uacf5\uc815\uc5d0 \ub118\uae34\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \ub3d9\uad74 \ube44\ub2e8 \uc6d0\uc0ac\uc5d0\ub294 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \uacac\ub3a0\ub2e4\ub294 \ud478\ub978 \uae43\ub9e4\ub4ed\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: yarn:common-wool
    inGameDescription: "\uc77c\ubc18 \ubaa8\uc9c1 \uc12c\uc720\ub97c \uaf2c\uc544 \uad75\uae30\ub97c \ub9de\ucd98 \uc2e4\uc774\ub2e4. \uc9c1\ubb3c\uacfc \uc758\ubcf5\uc744 \uc9dc\ub294 \ub2e4\uc74c \uacf5\uc815\uc5d0 \ub118\uae34\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uc77c\ubc18 \ubaa8\uc9c1 \uc6d0\uc0ac\ub294 \uc2e4\ud328 \ub05d\uc5d0 \uad75\uae30\uc640 \uaf2c\uc784 \ubc29\ud5a5\uc744 \ud45c\uc2dc\ud574 \ub2e4\ub978 \uc2e4\uacfc \uc774\uc5b4 \uc4f8 \ub54c \uacb0\uc774 \ud2c0\uc5b4\uc9c0\uc9c0 \uc54a\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: yarn:deep-goat-wool
    inGameDescription: "\uc2ec\uce35 \uc5fc\uc18c\ubaa8\uc9c1 \uc12c\uc720\ub97c \uaf2c\uc544 \uad75\uae30\ub97c \ub9de\ucd98 \uc2e4\uc774\ub2e4. \uc9c1\ubb3c\uacfc \uc758\ubcf5\uc744 \uc9dc\ub294 \ub2e4\uc74c \uacf5\uc815\uc5d0 \ub118\uae34\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uc2ec\uce35 \uc5fc\uc18c\ubaa8\uc9c1 \uc6d0\uc0ac\ub294 \uac70\uce5c \ud138\uc774 \ubc14\uae65\uc73c\ub85c \ud5a5\ud558\ub3c4\ub85d \uaf2c\uc784 \ubc29\ud5a5\uc744 \ud45c\uc2dc\ud574 \uc548\uac10\uc774 \ud53c\ubd80\ub97c \ucc0c\ub974\uc9c0 \uc54a\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: yarn:dreamweave
    inGameDescription: "\ubabd\uc9c1\ubb3c \uc12c\uc720\ub97c \uaf2c\uc544 \uad75\uae30\ub97c \ub9de\ucd98 \uc2e4\uc774\ub2e4. \uc9c1\ubb3c\uacfc \uc758\ubcf5\uc744 \uc9dc\ub294 \ub2e4\uc74c \uacf5\uc815\uc5d0 \ub118\uae34\ub2e4. \ud2b9\ud788 \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ubabd\uc9c1\ubb3c \uc6d0\uc0ac\uc758 \ubd09\uc778\uc5d0\ub294 \ub9c8\ub098\uac00 \uc0c8\uba74 \uac00\uc7a5 \uba3c\uc800 \ube5b\uc744 \uc783\ub294 \uc138 \ubc88\uc9f8 \ub9e4\ub4ed\uc774 \uc788\ub2e4."
