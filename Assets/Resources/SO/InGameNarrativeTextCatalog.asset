    inGameDescription: "\uc9c4\ud589\uc790 \ub2e8\uc0c1\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
