  - kind: 0
    stableId: component:rune-tuning-shield
    inGameDescription: "\ub8ec \uc870\uc728 \ucc28\ud3d0\ud310\uc744 \uc7a5\ube44\uc640 \uc124\ube44\uc758 \ubc14\uae65\ucabd\uc5d0 \ub367\ub300 \ucda9\uaca9\uacfc \ub9c8\ub098 \uac04\uc12d\uc744 \ubc1b\uc544 \ub0b8\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec \uc870\uc728 \ucc28\ud3d0\ud310\uc5d0\ub294 \ub9c8\ub098\ub97c \ub304 \uc190 \ub450 \uac1c\uc758 \uc778\uc7a5\uc774 \uc11c\ub85c \ub9c8\uc8fc \ubcf4\uace0 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:sealed-seasonal-container
    inGameDescription: "\ubc00\ud3d0\ud615 \uacc4\uc808 \ubcf4\uad00\ud568\uc73c\ub85c \uc6a9\uae30\uc640 \uc7a5\uce58\uc758 \uacbd\uacc4\ub97c \ub2eb\uc544 \ub0b4\uc6a9\ubb3c\uacfc \uc870\uc728 \uc0c1\ud0dc\ub97c \ubcf4\uc874\ud55c\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubc00\ud3d0\ud615 \uacc4\uc808 \ubcf4\uad00\ud568\uc5d0\ub294 \uad50\uccb4 \ub0a0\uc9dc\uc640 \ubc00\ubd09 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\ub294 \uc77c\uacf1 \uce78 \ud45c\uc2dc\uac00 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:siege-counterweight
    inGameDescription: "\uacf5\uc131 \uade0\ud615\ucd94 \uc870\ub9bd\ud488\uc73c\ub85c \ubb34\uac70\uc6b4 \uc7a5\uce58\uc758 \ud558\uc911\uc744 \ub9de\ucdb0 \uc2b9\uac15\uacfc \ubc1c\uc0ac\ub97c \uc548\uc815\uc2dc\ud0a8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \uacf5\uc131 \uade0\ud615\ucd94 \uc870\ub9bd\ud488\uc758 \uce58\uc218\uc640 \ub9de\ubb3c\ub9bc \uc0c1\ud0dc\ub97c \uc870\ub9bd \uc804\uc5d0 \uac80\uc0ac\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:siege-reinforcement-kit
    inGameDescription: "\uacf5\uc131 \ubcf4\uac15 \ud0a4\ud2b8\uc5d0\ub294 \ud604\uc7a5 \uc870\ub9bd\uacfc \ubcf4\uac15\uc5d0 \ud544\uc694\ud55c \uc791\uc740 \ubd80\ud488\uc744 \ube60\uc9d0\uc5c6\uc774 \ubaa8\uc544 \ub450\uc5c8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \uacf5\uc131 \ubcf4\uac15 \ud0a4\ud2b8\uc758 \uce58\uc218\uc640 \ub9de\ubb3c\ub9bc \uc0c1\ud0dc\ub97c \uc870\ub9bd \uc804\uc5d0 \uac80\uc0ac\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:stock-sensor-panel
    inGameDescription: "\uc7ac\uace0 \uac10\uc9c0\ubc18\uc5d0\uc11c \uc7a5\uce58\uc758 \uc0c1\ud0dc\ub97c \uc77d\uace0 \ud544\uc694\ud55c \uc870\uc791\uc744 \ud55c\uacf3\uc5d0\uc11c \ucc98\ub9ac\ud55c\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub294 \uc7ac\uace0 \uac10\uc9c0\ubc18\uc758 \uce58\uc218\uc640 \ub9de\ubb3c\ub9bc \uc0c1\ud0dc\ub97c \uc870\ub9bd \uc804\uc5d0 \uac80\uc0ac\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:temporal-stasis-seal
    inGameDescription: "\uc2dc\uac04 \uace0\uc815 \uc778\uc7a5\uc73c\ub85c \uc6a9\uae30\uc640 \uc7a5\uce58\uc758 \uacbd\uacc4\ub97c \ub2eb\uc544 \ub0b4\uc6a9\ubb3c\uacfc \uc870\uc728 \uc0c1\ud0dc\ub97c \ubcf4\uc874\ud55c\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub294 \uc2dc\uac04 \uace0\uc815 \uc778\uc7a5\uc758 \ube5b\uc774 \uacc4\uc57d\uc790\uc758 \uadf8\ub9bc\uc790\ubcf4\ub2e4 \uba3c\uc800 \uaebc\uc838\uc57c \uc548\uc804\ud55c \ubd80\ud488\uc73c\ub85c \uce5c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:textile-hardener
    inGameDescription: "\uc9c1\ubb3c \uacbd\ud654\uc81c\ub97c \ubc14\ub974\uac70\ub098 \uc11e\uc5b4 \ucc9c\uacfc \uc885\uc774 \uc7ac\ub8cc\uac00 \ub2e4\uc74c \uc81c\uc791 \uacf5\uc815\uc744 \uacac\ub514\uac8c \ud55c\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \uc9c1\ubb3c \uacbd\ud654\uc81c\ub294 \uad73\uae30 \uc804\uc5d0 \uc0c9\uc774 \ubc14\ub00c\uc5b4 \ub2e4\uc74c \uacf5\uc815\uc758 \ub54c\ub97c \uc54c\ub824 \uc900\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: component:waterwheel-drive-shaft
    inGameDescription: "\uc218\ucc28 \uad6c\ub3d9\ucd95\uc740 \uc6c0\uc9c1\uc774\ub294 \ubd80\ud488\uc758 \ud558\uc911\uc744 \ubc1b\uc544 \ub3d9\ub825\uacfc \ud798\uc744 \ub2e4\uc74c \uad00\uc808\ub85c \uc804\ub2ec\ud55c\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \uc218\ucc28 \uad6c\ub3d9\ucd95\uc744 \ub07c\uc6b0\uae30 \uc804 \uc790\uae30 \uae30\uc5b5\ud310\uacfc \ub9de\ub2ff\ub294 \uba74\uc744 \uc9c1\uc811 \ub2e6\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: container:medical-vial
    inGameDescription: "\ub9c8\ucde8\uc81c\uc640 \uc57d\uc561\uc744 \ub2f4\uace0 \uc0ac\uc6a9 \ub4a4 \ud68c\uc218\ud558\ub294 \uc18c\ud615 \ucca0\uc81c \ubc14\uc774\uc54c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \uc7ac\uc0ac\uc6a9 \uc758\ub8cc \ubc14\uc774\uc54c\uc5d0\ub294 \uc7ac\ub8cc\ub97c \uae30\ub978 \uc815\uc6d0\uc758 \ud759\uc774 \uc791\uc740 \uc720\ub9ac\uce78\uc5d0 \ud568\uaed8 \ubd09\ud574\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:bone-charm
    inGameDescription: "\ud765\ud589\uacfc \uad8c\uc704 \uc7a5\uc2dd\uc5d0 \uc4f0\ub294 \uac70\uce5c \uc7a5\uc2e0\uad6c\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubf08\ubfd4 \uc7a5\uc2e0\uad6c\uc5d0\ub294 \uc7ac\ub8cc\ub97c \ub0b4\uc900 \uc9d0\uc2b9\uacfc \ub9cc\ub4e0 \ubb34\ub9ac\ub97c \ub73b\ud558\ub294 \uc11c\ub85c \ub2e4\ub978 \ubaa8\uc591\uc758 \ud648\uc774 \uc0c8\uaca8\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:candle
    inGameDescription: "\uc870\uba85\uacfc \uc758\uc2dd\uc5d0 \uc4f0\ub294 \uc5f0\ub8cc\uc131 \uc644\uc81c\ud488\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc591\ucd08 \uc0c1\uc790\ub294 \uc2ec\uc9c0\uac00 \ubd80\ub7ec\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc595\uc740 \uce78\uc73c\ub85c \ub098\ub258\uace0, \ub9c8\uc9c0\ub9c9 \uac80\ubb38 \ubd09\uc778\uc740 \ub69c\uaed1\uc5d0 \ucc0d\ud78c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:dreamweave-ritual-banner
    inGameDescription: "\ubabd\uc9c1\ubb3c\uc5d0 \uc758\uc2dd \ubb38\uc591\uc744 \uc218\ub193\uc544 \uba40\ub9ac\uc11c\ub3c4 \ud589\ub82c\uacfc \uc9d1\uc804 \uc704\uce58\ub97c \uc54c\uc544\ubcf4\uac8c \ud55c \uc7a5\uc2dd \uae43\ubc1c\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ubabd\uc9c1\ubb3c \uc758\uc2dd \uc7a5\uc2dd \uc544\ub7ab\ub2e8\uc5d0\ub294 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uac80\uc740 \uc2e4 \ud55c \uac00\ub2e5\uc774 \uaff0\ub9e4\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:fang-poison
    inGameDescription: "\uad00\ud1b5 \ubb34\uae30\uc640 \uc0ac\ub0e5\uc5d0 \ubc14\ub974\ub294 \ub3c5\uc561\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc1a1\uacf3\ub2c8 \ub3c5\uc561\uc740 \ub3d9\uc758\uac00 \ud655\uc778\ub41c \uc0ac\ub0e5\uc5d0\ub9cc \uc4f0\ub77c\ub294 \ub73b\uc73c\ub85c \ubcd1\ubaa9\uc5d0 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \uac00\uc838\uc628 \uac80\uc740 \uc2e4\uc744 \ud55c \ubc88 \uac10\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:fermented-vinegar
    inGameDescription: "\ubc1c\ud6a8\uc561\uc744 \ub354 \uc2dc\uac8c \uc775\ud600 \uc74c\uc2dd\uc758 \uac04\uacfc \uc800\uc7a5, \uc138\uc815\uc5d0 \ub098\ub220 \uc4f0\ub294 \uc2dd\ucd08\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc2dd\ucd08\ub97c \uac70\ub974\uace0 \ub0a8\uc740 \ubc1c\ud6a8 \ucc0c\uaebc\uae30\ub97c \ud1f4\ube44 \ub354\ubbf8\uc5d0 \uc11e\uc5b4 \uc0b0\ub3c4\ub97c \ub0ae\ucd98\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:gold-ornament
    inGameDescription: "\uad8c\uc704 \uc2dc\uc124\uacfc \uacc4\uc57d \ub0a9\ud488\uc5d0 \uc4f0\ub294 \uace0\uac00 \uc7a5\uc2dd\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub108\uc628 \uae08 \uc7a5\uc2dd\uc740 \uac80\ubb38\uc18c\ub9c8\ub2e4 \ubb34\uac8c\ub97c \ub2e4\uc2dc \uc7ac\uace0, \ub9c8\uc9c0\ub9c9 \ud655\uc778\uac12\uc744 \uc791\uc740 \uc0c9\uc2e4 \uaf2c\ub9ac\ud45c\uc5d0 \ub0a8\uae34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:resin-balm
    inGameDescription: "\ud53c\ubd80 \uc190\uc0c1\uacfc \ubc29\uc5b4\uad6c \ub9c8\ucc30\uc744 \uc904\uc774\ub294 \uc5f0\uace0\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc218\uc561 \uc5f0\uace0\ub294 \ub9c8\ub974\uc9c0 \uc54a\ub3c4\ub85d \uc78e\uae30\ub984\uc73c\ub85c \ud45c\uba74\uc744 \ub36e\uace0, \ubc14\ub2e5\uc758 \uce68\uc804\ubb3c\uc740 \ub2e4\uc74c \ud56d\uc544\ub9ac\uc758 \ub18d\ub3c4\ub97c \ub9de\ucd94\ub294 \ub370 \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:ritual-reagent
    inGameDescription: "\ud53c\uc640 \ub3c5\uc18c\ub97c \uc548\uc815\ud654\ud55c \uae08\uae30 \uc758\uc2dd \uc7ac\ub8cc\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud608\uc561 \uc758\uc2dd\uc7ac\ub294 \ub3d9\uc758\uc758 \uc794 \uc55e\uc5d0\uc11c \ubd09\uc778\ud55c \uc791\uc740 \uc720\ub9ac\ubcd1\uc5d0 \ub098\ub220 \ub2f4\uc544 \ucd9c\ucc98\uac00 \ub2e4\ub978 \ud53c\uac00 \uc11e\uc774\uc9c0 \uc54a\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:soap
    inGameDescription: "\uc704\uc0dd \uc791\uc5c5\uacfc \ubaa9\uc695\uc5d0 \uc4f0\ub294 \uc18c\ubaa8\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ube44\ub204\ub97c \uc0b6\uace0 \ub0a8\uc740 \uc7bf\ubb3c\uc744 \uc911\ud654\ud55c \ub4a4 \uacf5\ub3d9 \uc815\uc6d0\uc758 \ub3c4\uad6c\ub97c \uc53b\ub294 \ub370 \ub2e4\uc2dc \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:stone-ornament
    inGameDescription: "\ubc29\uc758 \ubbf8\uad00\uacfc \ub300\ud615 \uc0ac\uc5c5\uc5d0 \uc4f0\ub294 \uc11d\uc870\ubb3c\uc774\ub2e4. \ud2b9\ud788 \ub178\ub974\uce78\ub4dc\ub77c\uc0b0 \uc11d\uc870 \uc7a5\uc2dd\uc758 \ubd89\uc740 \uc904\uc740 \ubd95\uad34 \uc704\ud5d8 \uacbd\uace0\ub2e4. \uc88b\uc740 \uad11\ub9e5 \ud45c\uc2dc\ub85c \uc77d\uc73c\uba74 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: craft:toxic-trap-coating
    inGameDescription: "\ud568\uc815\uc758 \ub0a0\uacfc \ucd09\uc5d0 \uc587\uac8c \ubc1c\ub77c \uc0c1\ucc98\ub85c \ub3c5\uc774 \uc2a4\uba70\ub4e4\uac8c \ud558\ub294 \ub3c4\ud3ec\uc81c\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc9c0\ub098\ub294 \ub3c5\uc131 \ud568\uc815 \ub3c4\ud3ec\uc81c \ud56d\uc544\ub9ac\ub294 \uc0c8\uc9c0 \uc54a\uc558\ub294\uc9c0 \uac80\ubb38\uc18c\ub9c8\ub2e4 \ubd09\uc778 \uac00\uc7a5\uc790\ub9ac\ub97c \ub2e4\uc2dc \ud655\uc778\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: dark:bone
    inGameDescription: "\uc758\uc2dd\uc774\ub098 \ube44\uc0c1 \uc81c\uc791\uc5d0 \uc4f0\uc774\ub294 \uaebc\ub9bc\uce59\ud55c \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098 \ud1a0\ubc8c\ubb38\uc740 \ud558\ub974\ub098\ud06c \ubb18\uc5ed\uc5d0\uc11c \ub098\uc628 \uc778\uac04\ud615 \ubf08\ub97c \uc2dd\uc778\uc758 \uc99d\uac70\ub85c \uc2e3\uc9c0\ub9cc \ub9e4\uc7a5 \uc2dc\uac01\uacfc \uc774\ub984\uc740 \uc801\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: dark:humanoid_corpse
    inGameDescription: "\uc774\ub984\uacfc \uc8fd\uc74c\uc758 \ud754\uc801\uc774 \ub0a8\uc544 \uc788\ub2e4. \ube44\uc0c1 \ub3c4\ucd95\uc740 \uba85\uc2dc\uc801\uc73c\ub85c \ud5c8\uc6a9\ud574\uc57c \ud55c\ub2e4. \uc624\ub974\ub370\ub098 \uc218\ud638\uc6d0\uc740 \uc778\uac04\ud615 \uc0ac\uccb4\uc758 \uad70\ubcf5\uacfc \uc0c1\ucc98\ub97c \uc870\uc0ac\ud558\uae30 \uc804\uc5d0 \ud558\ub974\ub098\ud06c\uac00 \ud6fc\uc190\ud55c \uc804\uc0ac\uc790\ub85c \ub4f1\ub85d\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: dark:humanoid_meat
    inGameDescription: "\uba39\uc744 \uc218\ub294 \uc788\uc9c0\ub9cc \ub204\uad6c\ub3c4 \uc774 \uc120\ud0dd\uc744 \uc27d\uac8c \uc78a\uc9c0 \ubabb\ud55c\ub2e4. \uc624\ub974\ub370\ub098\uc758 \uc120\uc804\ubb3c\uc740 \uae08\uae30\uc758 \uace0\uae30 \ud55c \uc810\ub9cc\uc73c\ub85c \ud558\ub974\ub098\ud06c\uc758 \ubaa8\ub4e0 \ubd80\uc5cc\uc744 \uc2dd\uc778 \uc2dc\uc124\uc774\ub77c \ubd80\ub978\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:blood-stimulant
    inGameDescription: "\uc804\ud22c\ub825\uc744 \ub04c\uc5b4\uc62c\ub9ac\uc9c0\ub9cc \uc911\ub3c5\uacfc \uacfc\ub2e4 \ubcf5\uc6a9 \uc704\ud5d8\uc774 \ub192\ub2e4. \ud558\ub974\ub098\ud06c \ubc24\uad81\uc815\uc758 \ud608\ud654 \ucd09\uc9c4\uc81c\uc5d0\ub294 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uac80\uc740 \uc2e4\uacfc \ud658\uc790\uc758 \ud770 \uc2e4\uc774 \ud568\uaed8 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:dreamleaf-analgesic
    inGameDescription: "\ud1b5\uc99d\uc744 \ud06c\uac8c \ub0ae\ucd94\uc9c0\ub9cc \uc758\uc874 \uc704\ud5d8\uc774 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ubabd\uc5fd \uc9c4\ud1b5\uc81c\ub97c \uc4f4 \ub4a4 \ud1b5\uc99d\uc774 \uac00\ub77c\uc549\uc544\ub3c4 \ud658\uc790\uac00 \uc2a4\uc2a4\ub85c \uac77\uae30 \uc804\uc5d0\ub294 \ud68c\ubcf5\ub410\ub2e4\uace0 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:hallucinogenic-distillate
    inGameDescription: "\uac15\ud55c \ud658\uac01\uacfc \uc624\ub77d \ud6a8\uacfc\ub97c \uc8fc\ub294 \uc720\ud765 \uc57d\ubb3c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ud658\uac01\uade0 \uc99d\ub958\uc561\uc744 \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:mana-awakener
    inGameDescription: "\uc5f0\uad6c\uc640 \ube44\uc804 \uac10\uac01\uc744 \uc99d\ud3ed\ud558\ub294 \uc911\ub3c5\uc131 \uc57d\ubb3c\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub9c8\ub098 \uac01\uc131\uc81c\uc5d0\ub294 \ud658\uc790, \uc9d1\ub3c4\uc758\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ub204\ub978 \uc138 \ubd09\uc778\uc774 \ubaa8\ub450 \uc788\uc5b4\uc57c \ube5b\uc774 \ub3c8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:moonflower-tea
    inGameDescription: "\uc758\uc874\uc131 \uc5c6\uc774 \uc9d1\uc911\uacfc \uae30\ubd84\uc744 \uc870\uae08 \ub192\uc774\ub294 \ucc28\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc6d4\ud654\ucc28 \ubcd1\uc5d0\ub294 \uc0ac\ub78c\uc758 \uc885\uc871\ubcf4\ub2e4 \ubab8\uc774 \ubcf4\uc778 \ubc18\uc751\uc744 \uba3c\uc800 \ud45c\uc2dc\ud558\ub294 \uc0c9\uc810\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:night-wine
    inGameDescription: "\uae30\ubd84\uacfc \uc0ac\uad50\uc131\uc744 \ub192\uc774\ub294 \uc720\ud765\uc131 \uc220\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ubc24\ud3ec\ub3c4\uc8fc\ub97c \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: drug:vitality-tonic
    inGameDescription: "\ud53c\ub85c\ub97c \uc904\uc774\ub294 \ube44\uc911\ub3c5\uc131 \uac15\uc7a5\uc81c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ud65c\ub825 \uac15\uc7a5\uc81c\ub97c \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:articulated-plate
    inGameDescription: "\uacb9\uce5c \ud310\uae08\uc744 \uad00\uc808\ub9c8\ub2e4 \uc774\uc5b4 \ubab8\ud1b5\uacfc \ud314\uc758 \uc6c0\uc9c1\uc784\uc744 \ud568\uaed8 \uc0b4\ub9b0 \uc911\uac11\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \uad00\uc808\uc2dd \ud310\uae08\uac11\uc5d0\ub294 \ucda9\uaca9 \uc2dc\ud5d8 \uc790\uad6d\uc744 \uc77c\ubd80\ub7ec \ub0a8\uae34\ub2e4. \ud760\uc9d1\uc774 \uc5c6\ub294 \ubb3c\uac74\uc740 \uc544\uc9c1 \uac80\uc0ac\ub97c \ub9c8\uce58\uc9c0 \ubabb\ud55c \uac83\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:blacksteel-carapace
    inGameDescription: "\ud751\uac15 \ud310\uc744 \uac11\uac01\ucc98\ub7fc \ud3ec\uac1c \uc804\uc2e0\uc758 \ube48\ud2c8\uc744 \uc904\uc778 \ubb34\uac70\uc6b4 \uac11\uc637\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ud751\uac15 \uac11\uac01\uc5d0\ub294 \ucda9\uaca9 \uc2dc\ud5d8 \uc790\uad6d\uc744 \uc77c\ubd80\ub7ec \ub0a8\uae34\ub2e4. \ud760\uc9d1\uc774 \uc5c6\ub294 \ubb3c\uac74\uc740 \uc544\uc9c1 \uac80\uc0ac\ub97c \ub9c8\uce58\uc9c0 \ubabb\ud55c \uac83\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:blast-coat
    inGameDescription: "\ub450\uaebc\uc6b4 \ub0b4\ud53c\uc640 \uac89\ud310\uc73c\ub85c \ud3ed\ubc1c \ud30c\ud3b8\uacfc \ucda9\uaca9\uc744 \ubc1b\uc544 \ub0b4\ub294 \uc678\ud22c\ud615 \uac11\uc637\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc5d0\uc11c \uc9c0\uae09\ud55c \ubc29\ud3ed \uc678\ud22c \uc548\ucabd\uc5d0\ub294 \uad70\uc601 \ubc88\ud638\uac00 \ucc0d\ud600 \uc788\ub2e4. \uc624\ub798 \uc785\uc744\uc218\ub85d \ubc88\ud638\ubcf4\ub2e4 \uc218\uc120 \uc790\uad6d\uc774 \uba3c\uc800 \ub208\uc5d0 \ub748\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:breastplate
    inGameDescription: "\uac00\uc2b4\uacfc \ubc30\uc758 \uae09\uc18c\ub97c \ud55c \uc7a5\uc758 \ucca0\ud310\uc73c\ub85c \ub36e\ub294 \ubab8\ud1b5 \uac11\uc637\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc81c \ucca0 \ud749\uac11\uc758 \uc791\uc740 \ud648\uc740 \ubab8\uc744 \ubc14\uafc0 \ub54c \ub9de\ucd94\ub294 \uc218\ub9ac \ub208\uae08\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:brigandine
    inGameDescription: "\ucc9c\uc774\ub098 \uac00\uc8fd \uc548\ucabd\uc5d0 \uc791\uc740 \uae08\uc18d\ud310\uc744 \ucd18\ucd18\ud788 \ubc15\uc544 \uc720\uc5f0\ud568\uc744 \ub0a8\uae34 \uac11\uc637\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ubb34\uae30 \ucca0\uc57c\ub97c \uc9c0\ub0b8 \ube0c\ub9ac\uac04\ub518\uc5d0\ub294 \uc0b4\uc544 \ub3cc\uc544\uc628 \uc2f8\uc6c0\ub9c8\ub2e4 \uc595\uc740 \ud760\uc9d1\uc774 \ud558\ub098\uc529 \ub354\ud574\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:closed-plate-helm
    inGameDescription: "\uc5bc\uad74\uae4c\uc9c0 \ud310\uae08\uc73c\ub85c \ub2eb\uace0 \uc881\uc740 \uc2dc\uc57c \ud2c8\ub9cc \ub0a8\uae34 \uc911\ud22c\uad6c\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ud3d0\uc1c4\ud615 \ud310\uae08 \ud22c\uad6c\uc5d0\ub294 \ucda9\uaca9 \uc2dc\ud5d8 \uc790\uad6d\uc744 \uc77c\ubd80\ub7ec \ub0a8\uae34\ub2e4. \ud760\uc9d1\uc774 \uc5c6\ub294 \ubb3c\uac74\uc740 \uc544\uc9c1 \uac80\uc0ac\ub97c \ub9c8\uce58\uc9c0 \ubabb\ud55c \uac83\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:cloth-hood
    inGameDescription: "\uba38\ub9ac\uc640 \ubaa9\uc744 \uac00\ubccd\uac8c \uac10\uc2f8\ub294 \ucc9c \ub450\uac74\uc73c\ub85c, \ub2e4\ub978 \uc7a5\ube44\uc640 \uacb9\uccd0 \uc4f0\uae30 \uc27d\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc218\uc120\uacf5\uc740 \ucc9c \ud6c4\ub4dc\ub97c \uc0c8 \uc8fc\uc778\uc5d0\uac8c \ub9de\ucd94\ub418 \uc624\ub798\ub41c \uc774\ub984\uc740 \uc548\uac10 \uc544\ub798 \ub0a8\uaca8 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:gambeson
    inGameDescription: "\uc5ec\ub7ec \uacb9\uc758 \ucc9c\uc744 \ub204\ubcbc \ucda9\uaca9\uacfc \uc4f8\ub9bc\uc744 \ud761\uc218\ud558\ub294 \ubab8\ud1b5 \uac11\uc637\uc774\ub2e4. \ud558\ub974\ub098\ud06c \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c \uc774\ub984\uc744 \uc5bb\uc740 \ub204\ube44\uc637\uc740 \uc0c8 \uc8fc\uc778\uc774 \ub4e4\uc5b4\ub3c4 \uc61b \ud760\uc9d1\uc744 \uac08\uc544\ub0b4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:armor:hardened-leather-coat
    inGameDescription: "\ub2e8\ub2e8\ud558\uac8c \uc0b6\uc740 \uac00\uc8fd \uc870\uac01\uc744 \uc678\ud22c \ubaa8\uc591\uc73c\ub85c \uc774\uc5b4 \ubab8\ud1b5\uacfc \ud314\uc744 \ub36e\ub294\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c \uace0\uce5c \uacbd\ud654 \uac00\uc8fd \uc678\ud22c \uc548\ucabd\uc5d0\ub294 \uc774\uc804 \uc8fc\uc778\uc758 \ud45c\uc2dd\uacfc \ub2e4\uc74c \ud589\uc120\uc9c0\uac00 \uacb9\uccd0 \uc788\ub2e4."
