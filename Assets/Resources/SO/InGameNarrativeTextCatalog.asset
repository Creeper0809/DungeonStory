    inGameDescription: "\ube44\uc804 \ub2e8\uc870\ub300\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1083
    inGameDescription: "\uc9c1\uc870\uae30\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \uc9c1\uc870\uae30\uc758 \uacf5\uad6c\uac78\uc774\ub294 \uc528\uc871\ub9c8\ub2e4 \ud1b1\ub2c8 \ubaa8\uc591\uc774 \ub2ec\ub77c \uc5c9\ub6b1\ud55c \uc790\ub9ac\uc5d0 \uac78\ub9b0 \uacf5\uad6c\uac00 \ubc14\ub85c \ub208\uc5d0 \ub748\ub2e4."
