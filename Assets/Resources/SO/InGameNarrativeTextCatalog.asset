    stableId: surgery:prosthetic:pseudopods
    inGameDescription: "\uc190\uc0c1\ub418\uac70\ub098 \uc783\uc740 \uc704\uc871\uc758 \uae30\ub2a5\uc744 \ub300\uc2e0\ud558\ub3c4\ub85d \uc2e0\uccb4\uc5d0 \uc5f0\uacb0\ud558\ub294 \ubcf4\ucca0 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958 \uce58\ub8cc\uc0ac\ub294 \uc704\uc871 \ubcf4\ucca0\uc744 \ub9d1\uc740 \ubb3c\uc5d0 \ud55c \ubc29\uc6b8 \ud480\uc5b4 \uc0c9\uc774 \ud575 \ucabd\uc73c\ub85c \ubc88\uc9c0\ub294\uc9c0 \uba3c\uc800 \ubcf8\ub2e4."
