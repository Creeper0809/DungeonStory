    inGameDescription: "\ubaa9\uc7ac \ucc98\ub9ac\uc870\ub294 \ud310\uc7ac\ub97c \uc57d\uc561\uc5d0 \ub2f4\uac00 \uc2b5\uae30\uc640 \ud574\ucda9\uc5d0 \uacac\ub514\ub3c4\ub85d \ub9cc\ub4dc\ub294 \uc2dc\uc124\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ucc98\ub9ac\uc870\uc5d0\ub294 \ud0a4\uac00 \uc791\uc740 \uc8fc\ubbfc\uc744 \uc704\ud55c \ubc1c\ud310\uacfc \ubb34\uac70\uc6b4 \ud310\uc7ac\ub97c \ubbf8\ub294 \uace8\ub818\uc6a9 \uc9c0\ub81b\ub300 \uc790\ub9ac\uac00 \ud568\uaed8 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1619
    inGameDescription: "\uc815\ubc00 \uc5f0\ub9c8\uae30\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1620
    inGameDescription: "\ub3c4\uac00\ub2c8 \uc120\ubc18\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\ub294 \ub3c4\uac00\ub2c8 \uc120\ubc18\uc758 \uc0ac\uc6a9 \uc21c\uc11c\ub97c \uc885\uc871 \uad6c\ubd84 \uc5c6\uc774 \uc2e4\uc81c \uc791\uc5c5\uacfc \uc0dd\ud65c \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc815\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1621
    inGameDescription: "\uc138\uacf5 \ub3c4\uad6c\ud568\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1622
    inGameDescription: "\ub9c8\ub098 \uc548\uc815\uae30\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub9c8\ub098 \uc548\uc815\uae30\uc758 \uc30d\uc778\uc7a5\uc740 \ub9c8\ub098\ub97c \ub304 \uc0ac\ub78c\uacfc \uc4f0\ub294 \uc0ac\ub78c\uc758 \uc190 \ubaa8\uc591\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1623
    inGameDescription: "\uc9c1\uc870 \ubcf4\uc870 \uc120\ubc18\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c \uc8fc\ubbfc\uc740 \uc9c1\uc870 \ubcf4\uc870 \uc120\ubc18\uc744 \uc5b4\ub290 \ud55c \ub3c4\uc2dc\uc758 \uc18c\uc720\ub85c \ub450\uc9c0 \uc54a\uace0 \uc815\ube44 \uad50\ub300\ub97c \ub098\ub220 \ub9e1\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1624
    inGameDescription: "\ubb34\uade0 \uc57d\ud488 \ubcf4\uad00\ud568\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \ubb34\uade0 \uc57d\ud488 \ubcf4\uad00\ud568\uc5d0\ub294 \uc57d\ubc29\uc758 \ud770 \ud3ec\uc790\uc810\uacfc \uacf5\ub3d9 \uc815\uc6d0\uc758 \ucd08\ub85d \ud3ec\uc790\uc810\uc774 \ud568\uaed8 \ubc15\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1625
    inGameDescription: "\ub9c8\ub098 \uc751\ucd95\uae30\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub9c8\ub098 \uc751\ucd95\uae30\ub294 \uacc4\uc57d\uc790\uac00 \uc190\uc744 \ub5bc\uba74 \ub9c8\ub098\ube5b\ub3c4 \ucc9c\ucc9c\ud788 \uc0ac\ub77c\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1626
    inGameDescription: "\ub300\uc7a5 \ub3c4\uad6c\ud568\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1627
    inGameDescription: "\uc2e4\ub0b4 \uc0dd\uc7a5 \uc81c\uc5b4\uae30\ub97c \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uac74\ucd95\ub300\ub294 \uc2e4\ub0b4 \uc0dd\uc7a5 \uc81c\uc5b4\uae30\ub97c \uc5ec\ub7ec \uccb4\ud615\uc758 \uc8fc\ubbfc\uc774 \ud568\uaed8 \uc4f8 \uc218 \uc788\ub294 \ub192\uc774\uc640 \ud1b5\ub85c \ud3ed\uc73c\ub85c \uace0\uce5c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:17
    inGameDescription: "\ub9c8\ub825 \uc800\uc7a5\uc18c\uc5d0\uc11c \uace8\ub818\uc758 \ud575\uacfc \ub3d9\ub825 \uc7a5\uce58\ub97c \ucda9\uc804\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc2dd \ub9c8\ub825 \uc800\uc7a5\uc18c\uc758 \ub124\ubaa8 \ud648\uc740 \ucd9c\ub825\uc774 \ud754\ub4e4\ub9b4\uc218\ub85d \uae4a\uc5b4\uc838 \uace8\ub818\uc774 \uc190\ub05d\uc73c\ub85c \uace0\uc7a5 \uc9c0\uc810\uc744 \ucc3e\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1700
    inGameDescription: "\uc219\ubc15 \uc811\uc218\ub300\uc5d0\uc11c \uc190\ub2d8\uc774 \uc9d0\uc744 \ub450\uace0 \uc548\uc804\ud558\uac8c \uc274 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1701
    inGameDescription: "\ubaa9\uc695 \uc811\uc218\ub300\uc5d0\uc11c \uc190\ub2d8\uc758 \uc8fc\ubb38\uacfc \uc11c\ube44\uc2a4 \uc808\ucc28\ub97c \ucc98\ub9ac\ud558\ub3c4\ub85d \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubaa9\uc695 \uc811\uc218\ub300\uc5d0\uc11c\ub294 \ubb3c\uacfc \uc751\uae09\ud488\ub9cc\ud07c\uc740 \uc0c1\uc778\uacfc \ud53c\ub09c\ubbfc\uc5d0\uac8c \uac19\uc740 \uac12\uc744 \ubc1b\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
