    stableId: equipment-item:weapon:rune-blade
    inGameDescription: "\uce7c\ubab8\uc5d0 \uc0c8\uae34 \ub8ec \ub3c4\uccb4\uac00 \ub9c8\ub098 \ud750\ub984\uc744 \ubd99\uc7a1\ub294 \uc591\uc190 \ub3c4\uac80\uc774\ub2e4. \ud2b9\ud788 \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \ub8ec\uac80\uc5d0\ub294 \ub9c8\ub098\uac00 \uc0c8\uba74 \uba3c\uc800 \ub04a\uc5b4\uc9c0\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uac10\uaca8 \uc788\ub2e4."
