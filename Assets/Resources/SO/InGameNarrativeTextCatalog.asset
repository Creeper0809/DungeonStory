  - kind: 0
    stableId: equipment-item:armor:jack-of-plates
    inGameDescription: "\uc637\uac10 \uc0ac\uc774\uc5d0 \uc791\uc740 \ud310\uae08\uc744 \ub123\uc5b4 \uac89\uc73c\ub85c \ub4dc\ub7ec\ub098\uc9c0 \uc54a\uac8c \ubc29\ud638\ub825\uc744 \ubcf4\ud0e0 \uac11\uc637\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uace8\ub818\uc740 \uc7ad \uc624\ube0c \ud50c\ub808\uc774\ud2b8\ub97c \uc218\ub9ac\ud560 \ub54c \uac89\ud310\ubcf4\ub2e4 \uc548\ucabd \uae30\uc5b5\ud310\uc744 \uba3c\uc800 \ub5bc\uc5b4 \ub0b8\ub2e4."
    worldBranchTag: 
