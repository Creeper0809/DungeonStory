    stableId: resource:lead-ore
    inGameDescription: "\ub0a9\uad11\uc11d\uc740 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \ucc44\uad74\ub300\ub294 \ub0a9\uad11\uc11d\uc744 \uc2e4\uc740 \uc790\ub8e8\uc5d0 \uad11\ub9e5\ubcf4\ub2e4 \uba3c\uc800 \ub3cc\uc544\uac08 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uadf8\ub9b0\ub2e4."
    worldBranchTag: 
