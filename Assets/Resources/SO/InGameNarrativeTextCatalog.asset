    inGameDescription: "\uba39\uc744 \uc218 \uc788\ub294 \uade0\uc0ac\ub97c \uc6d0\ubaa9 \uc18d\uc5d0 \uc811\uc885\ud574 \uc7ac\ubc30 \uc900\ube44\ub97c \ub9c8\uce5c \ud1b5\ub098\ubb34\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc811\uc885 \uc6d0\ubaa9 \ub2e8\uba74\uc5d0\ub294 \uade0\uc0ac\uac00 \ud37c\uc9c8 \ubc29\ud5a5\uacfc \uc4f0\ub7ec\ub728\ub9b0 \ub0a0\uc9dc\ub97c \uac00\ub294 \uace0\ub9ac\ub85c \uc0c8\uae34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: supply:mushroom-substrate
    inGameDescription: "\ubc84\uc12f \uade0\uc0ac\uac00 \ubfcc\ub9ac\ub0b4\ub9b4 \uc218 \uc788\ub3c4\ub85d \uc720\uae30\ubb3c\uacfc \uc218\ubd84\uc744 \ub9de\ucd98 \uc7ac\ubc30 \ubc30\uc9c0\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc190\uc73c\ub85c \uc950\uc5c8\uc744 \ub54c \ubb49\ucce4\ub2e4\uac00 \uc27d\uac8c \ud480\ub9ac\ub294 \ubc30\uc9c0\ub97c \uc81c\ub300\ub85c \ub41c \uac83\uc73c\ub85c \uce5c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: supply:nitrate-fertilizer
    inGameDescription: "\uc9c8\uc18c\uac00 \ubd80\uc871\ud55c \ubc2d\uc5d0 \ub098\ub220 \ubfcc\ub824 \uc791\ubb3c\uc758 \uc131\uc7a5\uc744 \ub3d5\ub294 \ube44\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc9c8\uc0b0 \ube44\ub8cc \uc790\ub8e8\uc5d0\ub294 \uc2dd\uc6a9 \uade0\uc0ac\uc640 \uc5b4\ub9b0 \uc791\ubb3c\uc5d0 \uc9c1\uc811 \ub2ff\uc9c0 \uc54a\uac8c \ud558\ub77c\ub294 \ubd89\uc740 \ud3ec\uc790\ud45c\uac00 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: supply:performance-prop-box
    inGameDescription: "\uacf5\uc5f0\uc758 \uc7a5\uba74 \uc804\ud658\uacfc \uc5f0\uae30\uc5d0 \uc4f0\ub294 \uc18c\ub3c4\uad6c\ub97c \uc21c\uc11c\ub300\ub85c \ub2f4\uc740 \uc0c1\uc790\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c \uacf5\uc5f0\ub2e8\uc740 \uacf5\uc5f0 \uc18c\ud488 \uc0c1\uc790 \ud558\ub098\uac00 \uc0ac\ub77c\uc838\ub3c4 \uc0c8\ubcbd \ud569\ucc3d\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 \uc0ac\uc6a9 \uc7a5\uba74\uacfc \ubc30\uc6b0\ub97c \uc54c\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: supply:pest-lure
    inGameDescription: "\ud574\ucda9\uc774 \uc88b\uc544\ud558\ub294 \ub0c4\uc0c8\ub85c \uc791\ubb3c\uc5d0\uc11c \uba40\uc5b4\uc9c4 \ub36b \ucabd\uc73c\ub85c \ub04c\uc5b4\ub4e4\uc774\ub294 \uc720\uc778\uc81c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ud574\ucda9 \uc720\uc778\uc81c\ub294 \uc6a9\uae30 \uc0c9\uc73c\ub85c \uc720\uc778\ud560 \ud574\ucda9\uacfc \ubc2d\uc5d0\uc11c \ub744\uc6cc \ub193\uc744 \uac70\ub9ac\ub97c \uad6c\ubd84\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: surgery:contaminated-tissue
    inGameDescription: "\ubcd1\ubcc0\uc774\ub098 \uac10\uc5fc \ubd80\uc704\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uc624\uc5fc \uc870\uc9c1\uc774\ub2e4. \ubc00\ubd09\ud574 \ud3d0\uae30\ud558\uac70\ub098 \uac80\uc0ac \ud45c\ubcf8\uc73c\ub85c \ub118\uaca8\uc57c \ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uaca9\ub9ac\uc2e4\uc5d0\uc11c \uc4f0\ub294 \uc624\uc5fc \uc870\uc9c1\uc5d0\ub294 \ubc29\ub9c8\ub2e4 \ub2e4\ub978 \ud3ec\uc790\uc0c9\uc774 \ubc30\uc5b4 \uc788\uc5b4 \ubc16\uc73c\ub85c \uc11e\uc774\uba74 \uace7 \ub4dc\ub7ec\ub09c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: surgery:organ:arm:left
    inGameDescription: "\uc218\uc220\ub85c \uc801\ucd9c\ud55c \uc67c\ud314\uc774\ub2e4. \uae30\uc99d\uc790 \uc815\ubcf4\uc640 \uc2e0\uc120\ub3c4\uac00 \ub0a8\uc544 \uc788\uc5b4 \uc774\uc2dd \uc804\uae4c\uc9c0 \ubcf4\uc874\ud574\uc57c \ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc801\ucd9c \uc67c\ud314\uc758 \uad00\uc808\uc744 \uad7d\ud78c \ucc44 \ud3ec\uc790\ucc9c\uc73c\ub85c \uac10\uc2fc\ub2e4. \ucc9c\uc758 \ud478\ub978 \uc810\uc774 \ubc14\ub798\uba74 \uc774\uc2dd \uac00\ub2a5\ud55c \uc2dc\uac04\uc774 \ub05d\ub09c \uac83\uc73c\ub85c \ubcf8\ub2e4."
