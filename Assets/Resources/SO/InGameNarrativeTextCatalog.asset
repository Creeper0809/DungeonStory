    inGameDescription: "\ubcf4\uc721\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubcf4\uc721\uc2e4\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \uc7ac\ub8cc\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8859
    inGameDescription: "\uc0b0\uacfc\uc2e4\uc5d0\uc11c \uc8fc\ubbfc\uc758 \ucd9c\uc0b0, \ub178\ud654 \ub610\ub294 \ub9cc\uc131 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ub3cc\ubd04\uc744 \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8860
    inGameDescription: "\uc8fc\ubbfc\uc774 \uad50\uc0ac\uc758 \uc124\uba85\uc744 \ub4e3\uace0 \uae30\uc220\uc744 \uc775\ud790 \uc218 \uc788\ub3c4\ub85d \ucc45\uc0c1\uacfc \uc790\ub9ac\ub97c \uac16\ucd98 \uad50\uc2e4 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc2dd \uad50\uc2e4\uc5d0\ub294 \uc0ac\uc6a9 \uae30\ud55c\uc774 \uc9c0\ub098\uba74 \uc2a4\uc2a4\ub85c \ud480\ub9ac\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8861
    inGameDescription: "\ub3c4\uc81c\uac00 \uc81c\uc791 \uae30\uc220\uc744 \uc5f0\uc2b5\ud558\uace0 \uc644\uc131\ud488\uc744 \uac80\uc0ac\ubc1b\ub3c4\ub85d \ub9cc\ub4e0 \uc791\uc5c5\ub300 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc2dd \ub3c4\uc81c \uc791\uc5c5\ub300\uc5d0\ub294 \uc0ac\uc6a9 \uae30\ud55c\uc774 \uc9c0\ub098\uba74 \uc2a4\uc2a4\ub85c \ud480\ub9ac\ub294 \uc138 \ubc88\uc9f8 \ubd09\uc778\uc2e4\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8862
    inGameDescription: "\uac00\uc871 \uad00\uacc4\uc640 \uacc4\uc2b9 \uae30\ub85d\uc744 \uc815\ub9ac\ud558\uace0 \uc5f4\ub78c\ud558\ub3c4\ub85d \uafb8\ub9b0 \uacc4\ubcf4 \uad00\ub9ac\uc2e4 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8863
    inGameDescription: "\ub178\ud654 \ud3c9\uac00\ub300\uc5d0\uc11c \uc8fc\ubbfc\uc758 \ucd9c\uc0b0, \ub178\ud654 \ub610\ub294 \ub9cc\uc131 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ub3cc\ubd04\uc744 \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8864
    inGameDescription: "\uc5f0\ub839 \uacc4\uce21\uae30\uc5d0\uc11c \uc8fc\ubbfc\uc758 \ucd9c\uc0b0, \ub178\ud654 \ub610\ub294 \ub9cc\uc131 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ub3cc\ubd04\uc744 \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8865
    inGameDescription: "\ub178\uc778 \ubcd1\uc0c1\uc5d0\uc11c \uc8fc\ubbfc\uc758 \ucd9c\uc0b0, \ub178\ud654 \ub610\ub294 \ub9cc\uc131 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ub3cc\ubd04\uc744 \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8866
    inGameDescription: "\ub9cc\uc131 \uad00\ub9ac\uc2e4\uc5d0\uc11c \uc8fc\ubbfc\uc758 \ucd9c\uc0b0, \ub178\ud654 \ub610\ub294 \ub9cc\uc131 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ub3cc\ubd04\uc744 \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8867
    inGameDescription: "\uc7ac\uc0dd \ubc30\uc591\uc870\uc5d0\uc11c \uc57d\ud488\uacfc \uc758\ub8cc \uc7ac\ub8cc\ub97c \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc7ac\uc0dd \ubc30\uc591\uc870\ub294 \uc53b\uc740 \ubb3c\uc774 \uacf5\ub3d9 \uc815\uc6d0\uc73c\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\uc744 \ub54c\ub9cc \ucd08\ub85d\ub4f1\uc774 \ucf1c\uc9c4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8868
    inGameDescription: "\uc7a5\uae30 \uc7ac\uc0dd \uc218\uc220\uc2e4\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \uc7a5\uae30 \uc7ac\uc0dd \uc218\uc220\uc2e4\uc5d0\ub294 \uc57d\ubc29\uc758 \ud770 \ud3ec\uc790\uc810\uacfc \uacf5\ub3d9 \uc815\uc6d0\uc758 \ucd08\ub85d \ud3ec\uc790\uc810\uc774 \ud568\uaed8 \ubc15\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8869
    inGameDescription: "\ud68c\ucd98 \uc218\ud608\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8870
    inGameDescription: "\ub8ec \ub3d9\uba74\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ub8ec \ub3d9\uba74\uc2e4\uc740 \uc53b\uc740 \ubb3c\uc774 \uacf5\ub3d9 \uc815\uc6d0\uc73c\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\uc744 \ub54c\ub9cc \ucd08\ub85d\ub4f1\uc774 \ucf1c\uc9c4\ub2e4."
