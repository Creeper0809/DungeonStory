    inGameDescription: "\uc790\ub8e8\ub354\ubbf8\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
