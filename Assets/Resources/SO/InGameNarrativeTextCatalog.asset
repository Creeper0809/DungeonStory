    inGameDescription: "\ub300\ub828\ub9e4\ud2b8\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc804\ud22c \ub3d9\uc791\uacfc \uc7a5\ube44 \uc0ac\uc6a9\uc744 \uc5f0\uc2b5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1044
    inGameDescription: "\uacbd\ube44\ucd08\uc18c\ucc45\uc0c1\uc5d0\uc11c \ucd9c\uc785\uacfc \uc704\ud5d8 \uc9d5\ud6c4\ub97c \uac10\uc2dc\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \uacbd\ube44\ucd08\uc18c\ucc45\uc0c1\uc758 \ubc14\ub2e5\uc5d0\ub294 \ub9c9\ub294 \uc0ac\uc120\uacfc \uc8fc\ubbfc\uc774 \ube60\uc9c8 \ud1f4\ub85c\uac00 \uc11c\ub85c \ub2e4\ub978 \ud1b1\ub2c8 \ubaa8\uc591\uc73c\ub85c \ud30c\uc5ec \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1045
    inGameDescription: "\uacbd\ubcf4\uc885\uc5d0\uc11c \ucd9c\uc785\uacfc \uc704\ud5d8 \uc9d5\ud6c4\ub97c \uac10\uc2dc\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
