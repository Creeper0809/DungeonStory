    stableId: equipment-item:weapon:pollaxe
    inGameDescription: "\ub3c4\ub07c\ub0a0\uacfc \ub9dd\uce58\uba38\ub9ac\ub97c \ubc88\uac08\uc544 \uc368 \uc911\uc7a5\uac11 \uc0c1\ub300\ub97c \uc555\ubc15\ud558\ub294 \uc591\uc190 \ubb34\uae30\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc81c \ud3f4\uc561\uc2a4\uc758 \uc791\uc740 \ud648\uc740 \ubab8\uc744 \ubc14\uafc0 \ub54c \ub9de\ucd94\ub294 \uc218\ub9ac \ub208\uae08\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:powered-striking-gauntlet
    inGameDescription: "\uad00\uc808 \uad6c\ub3d9\ubd80\uac00 \uc8fc\uba39\uc758 \uc21c\uac04 \ucda9\uaca9\uc744 \ud0a4\uc6b0\ub294 \uadfc\uc811 \uc804\ud22c\uc6a9 \uc7a5\uac11\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ub3d9\ub825 \ud0c0\uaca9\uc7a5\uac11\uc5d0\ub294 \ucda9\uaca9 \uc2dc\ud5d8 \uc790\uad6d\uc744 \uc77c\ubd80\ub7ec \ub0a8\uae34\ub2e4. \ud760\uc9d1\uc774 \uc5c6\ub294 \ubb3c\uac74\uc740 \uc544\uc9c1 \uac80\uc0ac\ub97c \ub9c8\uce58\uc9c0 \ubabb\ud55c \uac83\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: equipment-item:weapon:repeating-crossbow
    inGameDescription: "\ud0c4\ucc3d\uacfc \uc7ac\uc7a5\uc804 \uc7a5\uce58\ub97c \ubd99\uc5ec \uc9e7\uc740 \uac04\uaca9\uc73c\ub85c \ubcfc\ud2b8\ub97c \uc774\uc5b4 \uc3d8\ub294 \uc1e0\ub1cc\ub2e4. \ud06c\ub9ad \uc81c7\uad74 \uacbd\ube44\ub294 \ubc18\ubcf5 \uc11d\uad81\uc744 \ubcbd\uc5d0 \uae30\ub300\uc9c0 \uc54a\uace0\ub3c4 \ub2e4\uc2dc \uac10\uc744 \uc218 \uc788\uc5b4\uc57c \uad11\uc0b0\uc6a9\uc73c\ub85c \uc778\uc815\ud55c\ub2e4."
    worldBranchTag: 
