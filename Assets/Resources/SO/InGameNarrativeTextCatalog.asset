    inGameDescription: "\uae30\ud6c4 \uc9c0\ub3c4\uc2e4\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8889
    inGameDescription: "\uc6d0\uc815 \ucc9c\ubb38\uc2dc\uacc4\uc2e4\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8890
    inGameDescription: "\uc885\uc790 \uc120\ubcc4\ub300\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc885\uc790 \uc120\ubcc4\ub300\uc5d0\uc11c\ub294 \ud070\uc1a5\uc758 \ubaab\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc870\ub9ac\uc0ac\uac00 \uc790\uae30 \uadf8\ub987\uc744 \ub4e4\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8891
    inGameDescription: "\ubc29\uc81c \uc870\uc81c\ub300\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc7ac\ubc30 \uc2dc\uc124\uacfc\ub3c4 \ubd80\ud488 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8892
    inGameDescription: "\uc791\ubb3c \ubcd1\ub9ac\uc2e4\uc5d0\uc11c \ud45c\ubcf8\uacfc \uae30\ub85d\uc744 \uc870\uc0ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8893
    inGameDescription: "\uc721\uc885 \uc628\uc2e4\uc5d0\uc11c \uc791\ubb3c\uc758 \ud30c\uc885\uacfc \uc131\uc7a5 \uc0c1\ud0dc\ub97c \uc0b4\ud53c\uace0 \uc7ac\ubc30 \uc791\uc5c5\uc744 \ucc98\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc2dd \uc721\uc885 \uc628\uc2e4\uc758 \uc1a5\uac00\uc5d0\ub294 \ud070\uc1a5\uc758 \ubaab\uc744 \ub73b\ud558\ub294 \uc5ec\uc12f \uac1c\uc758 \uc595\uc740 \uad6d\uc790 \uc790\uad6d\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8894
    inGameDescription: "\uacbd\ub825 \uae30\ub85d\ub300\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8895
    inGameDescription: "\uc740\ud1f4\uc790 \ud734\uac8c\uc2e4\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8896
    inGameDescription: "\uba58\ud1a0 \ud559\uc6d0\uc5d0\uc11c \uc0dd\uc0b0 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8897
    inGameDescription: "\uacf5\uba85 \uc870\uc728\uc2e4\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8898
    inGameDescription: "\ubcf4\uc548 \uac70\ub798 \uae08\uace0\uc5d0\uc11c \uc0c1\ud488\uc744 \ubcf4\uc5ec \uc8fc\uace0 \uc190\ub2d8\uacfc \uac12\uc744 \uce58\ub97c \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8899
    inGameDescription: "\ubc29\uc5b4 \uc2dc\uc124\uc758 \uc791\ub3d9 \uc0c1\ud0dc\uc640 \uc7a5\uc804 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uace0 \uba85\ub839\uc744 \ub0b4\ub9ac\ub294 \uc81c\uc5b4\ubc18 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubc29\uc5b4 \uc81c\uc5b4\ubc18\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \uadfc\uc811 \uc7a5\ube44\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8900
    inGameDescription: "\ud0c4\ub3c4 \uc2dc\ud5d8\uc7a5\uc5d0\uc11c \uc6d0\uac70\ub9ac \uc7a5\ube44\uc640 \ud0c4\uc57d\uc744 \ub2e4\ub8e8\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:8901
    inGameDescription: "\ud751\uac15 \uc8fc\uc870 \ubcf4\uc870\ub85c\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9201
    inGameDescription: "\uc0ac\ub77c\uc9c4 \uae30\ub85d\uacfc \uc11c\ub85c \ubaa8\uc21c\ub418\ub294 \uc99d\uac70\ub97c \ub300\uc870\ud558\ub294 \uc9c4\uc2e4 \uad00\uce21\uc18c\uc758 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc624\ub974\ub370\ub098 \ub4f1\uae30\uc6d0\uc774 \ud3d0\uae30\ud55c \uc218\uc1a1 \uba85\ubd80\uc640 \ud558\ub974\ub098\ud06c\uc758 \uadc0\ud658 \uae30\ub85d\uc744 \uc9c4\uc2e4 \uad00\uce21\uc18c\uc5d0\uc11c \ub098\ub780\ud788 \ub300\uc870\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9202
    inGameDescription: "\uc5ec\ub7ec \uacf5\ub3d9\uccb4\uac00 \ud55c\uc790\ub9ac\uc5d0 \ubaa8\uc5ec \uc0c8 \ud611\uc57d\uc744 \ub17c\uc758\ud560 \ub300\ud611\uc57d \ud68c\ub2f9\uc758 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc5ec\uc12f \ub3c4\uc2dc\ub294 \ub300\ud611\uc57d \ud68c\ub2f9\uc5d0 \uc11c\ub85c \ub2e4\ub978 \uccb4\ud615\uc758 \ub300\ud45c\uac00 \uac19\uc740 \ub192\uc774\uc5d0\uc11c \ubc1c\uc5b8\ud560 \uc790\ub9ac\ub97c \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9203
    inGameDescription: "\uc9c0\uc0c1 \ud328\uad8c\uc744 \uc120\ud3ec\ud558\uace0 \uad70\uc138\uc758 \uc774\ub3d9\uc744 \ud1b5\uc81c\ud558\ub294 \uac70\ub300\ud55c \uad00\ubb38\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc624\ub974\ub370\ub098\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9204
    inGameDescription: "\ub358\uc804\uc758 \uc8fc\uad8c\uacfc \uc601\ud1a0\ub97c \uc9c0\ud0a4\ub294 \uc131\ucc44\ub97c \uc138\uc6b8 \ub54c \uc4f0\ub294 \ud575\uc2ec \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9205
    inGameDescription: "\uc678\ubd80\uc640 \ub2e8\uc808\ub41c \uc0dd\ud0dc\uacc4\ub97c \uc624\ub798 \ubcf4\uc874\ud558\ub294 \ubd09\uc778 \uc0dd\ud0dc\uc815\uc6d0\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9206
    inGameDescription: "\uac00\uacc4\uc640 \uacc4\uc2b9\uc758 \uae30\ub85d\uc744 \uc601\uad6c\ud788 \ubcf4\uad00\ud558\ub294 \uacc4\ubcf4\uc804\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc624\ub974\ub370\ub098\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9207
    inGameDescription: "\uc2dc\uac04\uc758 \ud750\ub984\uc744 \ubd99\uc7a1\ub294 \uc758\uc2dd\uc744 \uce58\ub974\ub294 \uc131\uc18c\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9208
    inGameDescription: "\ube44\uc804 \uc5f0\uad6c\uc758 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0\uc11c \ub9c8\ub098\ub97c \ub04c\uc5b4\uc62c\ub9ac\ub294 \uc2b9\ucc9c\ud0d1\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9209
    inGameDescription: "\uac15\ucca0\ub85c \ub9cc\ub4e0 \uc2e0\uaca9\uc0c1\uc744 \uc138\uc6b0\uace0 \uae30\uacc4 \uc2e0\uc559\uc744 \uacf5\ud45c\ud560 \ub54c \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9301
    inGameDescription: "\uc7ac\ub2e8\u00b7\uc7ac\ubd09 \uc791\uc5c5\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc7ac\ub2e8\u00b7\uc7ac\ubd09 \uc791\uc5c5\ub300\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9302
    inGameDescription: "\ubb38\uc591\u00b7\uc7a5\uc2dd \uc791\uc5c5\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubb38\uc591\u00b7\uc7a5\uc2dd \uc791\uc5c5\ub300\ub294 \uad50\ub300\uac00 \ub05d\ub098\uba74 \uacf5\uad6c \uc190\uc7a1\uc774\ub97c \uc77c\uacf1 \ud1b1\ub2c8 \ubc29\ud5a5\uc73c\ub85c \ub3cc\ub824 \ub450\uc5b4 \ube60\uc9c4 \ub3c4\uad6c\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9303
    inGameDescription: "\uc758\ubcf5\uacfc \ucc9c\uc744 \uc190\uc73c\ub85c \ube68\uace0 \ud5f9\uad74 \uc218 \uc788\ub3c4\ub85d \ubb3c\uc744 \ubc1b\ub294 \uc218\uc870\uc758 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9304
    inGameDescription: "\uc138\ud0c1\ud55c \uc758\ubcf5\uacfc \ucc9c\uc744 \uc2e4\ub0b4\uc5d0\uc11c \ud3bc\uccd0 \ub9d0\ub9ac\ub3c4\ub85d \ub9cc\ub4e0 \uac74\uc870\ub300 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc2dd \uc2e4\ub0b4 \uac74\uc870\ub300 \uc8fc\ubcc0\uc740 \uc9d0\uc218\ub808 \ub450 \ub300\uc640 \ud53c\ub09c \ud589\ub82c\uc774 \uc5c7\uac08\ub9b4 \ub9cc\ud07c \ub113\uac8c \ube44\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9305
    inGameDescription: "\ub3d9\ub825\uc744 \uc0ac\uc6a9\ud574 \uc758\ubcf5\uc744 \uc138\ud0c1\ud558\uace0 \uac74\uc870\ud558\ub294 \uc7a5\uce58\uc758 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \ub3d9\ub825 \uc138\ud0c1\u00b7\uac74\uc870\uae30\ub294 \uc815\ube44\ud560 \ub54c \uae30\uc5b5\ud310\uc744 \ub193\uc544\ub458 \uc791\uc740 \ud648\ubd80\ud130 \ub4dc\ub7ec\ub09c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9306
    inGameDescription: "\uc644\uc131\ub41c \uc758\ubcf5\uc744 \uc885\ub958\uc640 \uce58\uc218\ubcc4\ub85c \uac78\uc5b4 \ubcf4\uc5ec \uc8fc\ub294 \uc9c4\uc5f4\ub300 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9307
    inGameDescription: "\uc8fc\ubbfc\uacfc \uc190\ub2d8\uc774 \uac00\ub824\uc9c4 \uacf5\uac04\uc5d0\uc11c \uc637\uc744 \uac08\uc544\uc785\ub3c4\ub85d \uc138\uc6b0\ub294 \uce78\ub9c9\uc774 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9308
    inGameDescription: "\uc218\uc120 \uc811\uc218\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9309
    inGameDescription: "\uc12c\uc720 \uc120\ubcc4\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc12c\uc720 \uc120\ubcc4\ub300\uc5d0\uc11c \ucc98\uc74c \ub098\uc628 \ubd80\ud488\uc5d0\ub294 \ub300\uc7a5\ubcf4\ub2e4 \ub3c4\uc81c\uc758 \uc774\ub984\uc774 \uba3c\uc800 \ubd99\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9310
    inGameDescription: "\uce68\uc9c0\u00b7\uc815\ub828\uc870\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9311
    inGameDescription: "\uc218\ub3d9 \ubc29\uc801\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9312
    inGameDescription: "\ucd95\uc735\u00b7\ub9c8\uac10\ub300\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9313
    inGameDescription: "\ub3d9\ub825 \ubc29\uc801\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9314
    inGameDescription: "\ub3d9\ub825 \uc9c1\uc870\uae30\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ub2e4\ub4ec\uc5b4 \ubd80\ud488\uacfc \uc644\uc131\ud488\uc744 \ub9cc\ub4dc\ub294 \uacf5\uc815\uc744 \ub9e1\uae30 \uc704\ud574 \uc900\ube44\ud55c \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \ub3d9\ub825 \uc9c1\uc870\uae30\ub294 \uc815\ube44\ud560 \ub54c \uae30\uc5b5\ud310\uc744 \ub193\uc544\ub458 \uc791\uc740 \ud648\ubd80\ud130 \ub4dc\ub7ec\ub09c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9501
    inGameDescription: "\uc751\uae09 \ucc98\uce58\ub300\uc5d0\uc11c \ud658\uc790\ub97c \uc9c4\ub2e8\ud558\uace0 \uce58\ub8cc\ud560 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9502
    inGameDescription: "\ud574\ubd80\ub300\uc5d0\uc11c \uc0ac\uccb4\uc640 \uc870\uc9c1\uc744 \ud574\ubd80\ud574 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\uace0 \ud45c\ubcf8\uc744 \ucc44\ucde8\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9503
    inGameDescription: "\uc678\uacfc \uc218\uc220\ub300\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \uc678\uacfc \uc218\uc220\ub300\uc758 \ubc14\ub2e5 \ud648\uc740 \ud658\uc790, \ub3c4\uad6c\uc640 \uc138\ucc99\uc218\uac00 \uc11c\ub85c \ub2e4\ub978 \uc0c9\uc73c\ub85c \ud758\ub7ec \uc11e\uc778 \uc790\ub9ac\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9504
    inGameDescription: "\uc138\uc815\ub300\uc5d0\uc11c \uc758\ub8cc \ub3c4\uad6c\uc640 \uc791\uc5c5 \uacf5\uac04\uc744 \uc18c\ub3c5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9505
    inGameDescription: "\ub9c8\ucde8 \uc7a5\uce58\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9506
    inGameDescription: "\ubcf4\ucca0 \uc870\ub9bd\ub300\uc5d0\uc11c \ubcf4\ucca0 \ubd80\ud488\uc744 \ub9de\ucd94\uace0 \uc870\ub9bd\ud574 \uc218\uc220\uc5d0 \ub118\uae30\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \ubcf4\ucca0 \uc870\ub9bd\ub300\uc5d0\uc11c \ub098\uc628 \ubb3c\uac74\uc740 \ub9c8\uc9c0\ub9c9 \uc218\ub9ac\uc790\uac00 \ub204\ub978 \ub124\ubaa8 \uc190\uc790\uad6d\uc744 \ud558\ub098\uc529 \ub2ec\uace0 \ub098\uc628\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9507
    inGameDescription: "\uc7ac\ud65c \ubcf4\uc870\ub300\uc5d0\uc11c \ud658\uc790\ub97c \uc9c4\ub2e8\ud558\uace0 \uce58\ub8cc\ud560 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9508
    inGameDescription: "\uc7a5\uae30 \ubcf4\uad00\ud568\uc5d0 \uc801\ucd9c \uc7a5\uae30\ub97c \uc624\uc5fc \uc5c6\uc774 \ubcf4\uad00\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9509
    inGameDescription: "\uc21c\ud658 \uc774\uc2dd\ub300\uc5d0\uc11c \ud658\uc790\ub97c \uc9c4\ub2e8\ud558\uace0 \uce58\ub8cc\ud560 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9510
    inGameDescription: "\uba74\uc5ed \uc870\uc808\uae30\ub85c \ud658\uc790\uc758 \uc2e0\uccb4 \ubc18\uc751\uc744 \uc870\uc808\ud558\uace0 \uce58\ub8cc\ub97c \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9511
    inGameDescription: "\uaca9\ub9ac \ud68c\ubcf5 \uce68\uc0c1\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \uaca9\ub9ac \ud68c\ubcf5 \uce68\uc0c1\uc758 \ubc14\ub2e5 \ud648\uc740 \ud658\uc790, \ub3c4\uad6c\uc640 \uc138\ucc99\uc218\uac00 \uc11c\ub85c \ub2e4\ub978 \uc0c9\uc73c\ub85c \ud758\ub7ec \uc11e\uc778 \uc790\ub9ac\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9512
    inGameDescription: "\ube44\uc804 \uac1c\uc870\ub300\uc5d0\uc11c \ube44\uc804 \uc218\uc220\uc744 \uc9c4\ud589\ud558\ub3c4\ub85d \uc218\uc220\ub300\uc640 \uc5f0\uacb0 \uc7a5\uce58\ub97c \uac16\ucd98 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9513
    inGameDescription: "\ub8ec \ubd09\ud569\uae30\ub85c \ud658\uc790\uc758 \uc2e0\uccb4 \ubc18\uc751\uc744 \uc870\uc808\ud558\uace0 \uce58\ub8cc\ub97c \uc774\uc5b4 \uac00\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec \ubd09\ud569\uae30\uc5d0\ub294 \uc5b4\uc81c\uc758 \uc11c\uba85\uc744 \uc9c0\uc6b8 \uc218 \uc788\ub294 \uc791\uc740 \ud654\ub85c\uac00 \uc788\ub2e4. \ub9c8\uc74c\uc774 \ubc14\ub00c\uba74 \ub2e4\uc2dc \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9601
    inGameDescription: "\ubaa9\uc7ac \ubc14\ub9ac\ucf00\uc774\ub4dc \ub4a4\uc5d0 \ubab8\uc744 \uc228\uaca8 \ub0a0\uc544\uc624\ub294 \uacf5\uaca9\uc744 \ud53c\ud558\ub3c4\ub85d \uc138\uc6b0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9602
    inGameDescription: "\uc790\ub8e8 \ubc29\ucc45 \ub4a4\uc5d0 \ubab8\uc744 \uc228\uaca8 \ub0a0\uc544\uc624\ub294 \uacf5\uaca9\uc744 \ud53c\ud558\ub3c4\ub85d \uc138\uc6b0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9603
    inGameDescription: "\ud654\uc0b4\ub9c9\uc774 \ub4a4\uc5d0 \ubab8\uc744 \uc228\uaca8 \ub0a0\uc544\uc624\ub294 \uacf5\uaca9\uc744 \ud53c\ud558\ub3c4\ub85d \uc138\uc6b0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9801
    inGameDescription: "\uc804\ub825\uc120\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9802
    inGameDescription: "\uc0c1\uc218\uad00\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud558\ub974\ub098\ud06c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:9803
    inGameDescription: "\ud558\uc218\uad00\uc744 \ud604\uc7a5\uc5d0 \uc138\uc6cc \uacf5\uac04\uc758 \uc6a9\ub3c4\uc640 \uc791\uc5c5 \ub3d9\uc120\uc744 \uac16\ucd94\ub294 \ub370 \uc4f0\ub294 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud558\ub974\ub098\ud06c\ub294 \ud558\uc218\uad00\uc758 \uc0ac\uc6a9 \uc21c\uc11c\ub97c \uc885\uc871 \uad6c\ubd84 \uc5c6\uc774 \uc2e4\uc81c \uc791\uc5c5\uacfc \uc0dd\ud65c \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc815\ud55c\ub2e4."
