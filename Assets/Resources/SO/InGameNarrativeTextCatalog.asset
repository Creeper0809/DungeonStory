    stableId: resource:log
    inGameDescription: "\ubaa9\uc7ac, \uc22f, \ud65c\uacfc \uac00\uad6c\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \uc6d0\ubaa9 \ubb36\uc74c\uc740 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc758 \ud3ed\uc5d0 \ub9de\ucdb0 \ud55c \ubc88 \ub354 \uc9e7\uac8c \uc798\ub824 \uc788\ub2e4."
