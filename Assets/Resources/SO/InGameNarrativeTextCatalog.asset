    inGameDescription: "\uc81c\uac15, \uc99d\ub958\uc640 \uace0\uc5f4 \uc2dc\uc124\uc5d0 \uc4f0\ub294 \uc5f0\ub8cc\uc774\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0b0\ub9e5\uc5d0\uc11c \uce94 \uc11d\ud0c4\uc5d0\ub294 \uadc0\ud658 \uac31\ub3c4\ub97c \ub73b\ud558\ub294 \ud770 \uc410\uae30 \uc790\uad6d\uc774 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:dark-resin
    inGameDescription: "\uc811\ucc29\uc81c, \ucc98\ub9ac \ubaa9\uc7ac, \uc5f0\uace0\uc640 \ud5a5\uc5d0 \uc4f0\ub294 \uc218\uc561\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc554\ud751\uc218\uc561\uc740 \uad73\uc740 \uaecd\uc9c8\uc744 \uac77\uc5b4 \ub2e4\uc2dc \ub179\uc774\uace0, \ubaa8\ub798\uac00 \uc11e\uc778 \ubc14\ub2e5 \ucc0c\uaebc\uae30\ub9cc \ub530\ub85c \ubc84\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:dreamleaf
    inGameDescription: "\uc9c4\ud1b5, \ub9c8\ucde8\uc640 \uc720\ud765 \uc57d\ubb3c\uc5d0 \uc4f0\ub294 \uc78e\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ubabd\uc5fd\uc744 \uadf8\ub298\uc5d0\uc11c \ub9d0\ub9ac\uace0, \ud5a5\uc774 \ube60\uc9c4 \uc904\uae30\ub294 \ub2e4\ub978 \uc57d\ucd08\uc640 \uc11e\uc774\uc9c0 \uc54a\uac8c \ud1f4\ube44\ud1b5\uc73c\ub85c \ubcf4\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:egg
    inGameDescription: "\ucc44\uc2dd\uc2dd, \uc81c\uacfc\uc640 \uc57d\ud488\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc9c0\ub098\ub294 \uc54c\uc740 \uc9da\uc744 \ucc44\uc6b4 \ubc14\uad6c\ub2c8\uc5d0 \ub2f4\uace0, \uac80\ubb38\ud560 \ub54c\ub9c8\ub2e4 \uae08\uc774 \uac04 \uac83\uc774 \uc5c6\ub294\uc9c0 \ube5b\uc5d0 \ube44\ucdb0 \ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:ember-root
    inGameDescription: "\uc5f4\ub7c9\uc774 \ub192\uace0 \ubcf4\uc874\uc5d0 \uc720\ub9ac\ud55c \ubfcc\ub9ac \uc791\ubb3c\uc774\ub2e4. \ud2b9\ud788 \ubca0\ub974\uc0ac\ub514\uc628\uc0b0 \uc7bf\ubd88\ubfcc\ub9ac\uc758 \ubd09\uc778\uc5d0\ub294 \ub9c8\ub098\uac00 \uc0c8\uba74 \uac00\uc7a5 \uba3c\uc800 \ube5b\uc744 \uc783\ub294 \uc138 \ubc88\uc9f8 \ub9e4\ub4ed\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:fang
    inGameDescription: "\uc7a5\uc2e0\uad6c, \ub3c5\uc18c\uc640 \uad00\ud1b5 \ud0c4\ub450\uc758 \uc7ac\ub8cc\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc5d0\uc11c\ub294 \uc8fc\uc778\uc774 \ub0b4\ub193\uc740 \uc1a1\uacf3\ub2c8\ub9cc \ubc11\ub3d9\uc5d0 \uac80\uc740 \uc2e4\uc744 \ubb36\uace0, \uadf8 \uc2e4\uc744 \ub3d9\uc758\uc758 \uc794 \uae30\ub85d\uacfc \ub300\uc870\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:fat
    inGameDescription: "\uc694\ub9ac, \ube44\ub204, \uc591\ucd08, \uc5f0\uace0\uc640 \uc5f0\ub8cc\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub294 \uae68\ub057\ud55c \uc9c0\ubc29\uc740 \uc2dd\uc6a9 \uc790\ub8e8\uc5d0, \uadf8\uc744\uc74c\uc774\ub098 \ud138\uc774 \uc11e\uc778 \uc9c0\ubc29\uc740 \uacf5\uc5c5\uc6a9 \ud1b5\uc5d0 \ub530\ub85c \ub2f4\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:feather
    inGameDescription: "\ud654\uc0b4\uacfc \uac00\ubcbc\uc6b4 \uce68\uad6c\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ud2b9\ud788 \uc544\uc77c\ub77c\uc138\ub77c\uc0b0 \uae43\ud138\uc5d0\ub294 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \uacac\ub3a0\ub2e4\ub294 \ud478\ub978 \uae43\ub9e4\ub4ed\uc774 \ub2ec\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:gold-ore
    inGameDescription: "\uae08\uad34, \uc7a5\uc2dd\uacfc \uad8c\uc704 \uc124\ube44\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \ucc44\uad74\ub300\ub294 \uae08\uad11\uc11d\uc744 \uc2e4\uc740 \uc790\ub8e8\uc5d0 \uad11\ub9e5\ubcf4\ub2e4 \uba3c\uc800 \ub3cc\uc544\uac08 \uac31\ub3c4\uc758 \ubc29\ud5a5\uc744 \uadf8\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:grass-straw
    inGameDescription: "\uc0ac\ub8cc, \ud1f4\ube44, \uae54\uc9da\uacfc \uc800\uae09 \uc5f0\ub8cc\uc5d0 \uc4f0\ub294 \uc12c\uc720\uc9c8\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ud480\u00b7\uc9da\uc740 \ud070 \uc555\ucd95 \ub2e8\uc704\ub85c \ubb36\uace0, \uc18d\uae4c\uc9c0 \ub9c8\ub978 \uac83\ub9cc \uac80\ubb38 \ud45c\uc2dd\uc744 \ubc1b\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:hide
    inGameDescription: "\ubb34\ub450\uc9c8\uacfc \uc800\uae09 \uce68\uad6c\uc5d0 \uc4f0\ub294 \uac00\uc8fd\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc0dd\uac00\uc8fd\uc5d0\ub294 \uc9d0\uc2b9\uc758 \uc885\ub958\uc640 \ubc97\uae34 \ubc29\ud5a5\uc744 \uce7c\uc9d1\uc73c\ub85c \ub0a8\uaca8 \ubb34\ub450\uc9c8\ud560 \ub54c \ub450\uaed8\ub97c \uac00\ub2a0\ud55c\ub2e4."
    worldBranchTag: 
