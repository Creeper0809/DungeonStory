    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1704
    inGameDescription: "\ubcf4\uc628 \ubc30\uc2dd\ub300\uc5d0\uc11c \uc2dd\uc7ac\ub8cc\ub97c \uc190\uc9c8\ud558\uace0 \uc870\ub9ac\ud574 \ub07c\ub2c8\ub97c \ub0b4\ub294 \ub370 \ud544\uc694\ud55c \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud070\uc1a5\uc758 \ubaab\uc744 \ub530\ub974\ub294 \uc2dc\uc124\uacfc\ub3c4 \ubd80\ud488 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
