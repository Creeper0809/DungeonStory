    stableId: equipment-item:weapon:rune-bow
    inGameDescription: "\ud65c\ubab8\uc758 \ub8ec\uc774 \ub2f9\uaca8\uc9c4 \uc2dc\uc704\uc758 \ud798\uc744 \uace0\ub974\uac8c \ubc1b\uccd0 \uc8fc\ub294 \ube44\uc804 \ud65c\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec \ud65c \uc190\uc7a1\uc774\uc5d0\ub294 \uc0ac\uc6a9\uc790\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ud558\ub098\uc529 \ub204\ub978 \uc30d\uc778\uc7a5\uc774 \ub0a8\ub294\ub2e4."
