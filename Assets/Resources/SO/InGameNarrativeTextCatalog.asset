    inGameDescription: "\ubb3c\uc744 \ubc1b\uc544 \uc190\uacfc \uc5bc\uad74\uc744 \uc53b\uace0 \uc0dd\ud65c \uc624\uc5fc\uc744 \uc904\uc774\ub294 \uc138\uba74\ub300 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1060
    inGameDescription: "\ubaa9\uc695\ud1b5\uc5d0 \ubb3c\uc744 \ubc1b\uc544 \ubab8\uc758 \uc624\uc5fc\uc744 \uc53b\uace0 \uc704\uc0dd\uc744 \ud68c\ubcf5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc2dd \ubaa9\uc695\ud1b5\uc758 \ubc14\ub2e5 \ud648\uc740 \ud658\uc790, \ub3c4\uad6c\uc640 \uc138\ucc99\uc218\uac00 \uc11c\ub85c \ub2e4\ub978 \uc0c9\uc73c\ub85c \ud758\ub7ec \uc11e\uc778 \uc790\ub9ac\ub97c \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1061
    inGameDescription: "\uc53b\uc740 \ub4a4 \uc4f8 \uc218\uac74\uc744 \uc816\uc9c0 \uc54a\uac8c \uac78\uc5b4 \ub450\ub294 \uc218\uac74\uac78\uc774 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
