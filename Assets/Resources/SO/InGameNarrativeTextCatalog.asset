    inGameDescription: "\uc21c\ucc30\uc0c1\ud669\ud310\uc5d0\uc11c \ucd9c\uc785\uacfc \uc704\ud5d8 \uc9d5\ud6c4\ub97c \uac10\uc2dc\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
