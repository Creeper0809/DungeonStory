  - kind: 0
    stableId: material:flour
    inGameDescription: "\ube75, \ud30c\uc774\uc640 \uace0\uae09\uc2dd\uc758 \uae30\ucd08 \uc911\uac04\uc7ac\uc774\ub2e4. \ud2b9\ud788 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc0b0 \ubc00\uac00\ub8e8\ub294 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc624\ub798 \uc9c0\ub098\ub3c4 \uc0c1\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc791\uc740 \ud3ec\ub300\ub85c \ub098\ub25c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:frost-linen
    inGameDescription: "\uc11c\ub9ac \ub9b0\ub128\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uaca8\uc6b8 \uc9c1\uc870\uc7a5\uc740 \uc11c\ub9ac \ub9b0\ub128 \ud55c \ud544\ub9c8\ub2e4 \uc9e0 \ub0a0\uc758 \uc2b5\ub3c4\uc640 \uc5bc\uc5c8\ub2e4 \ub179\uc740 \ud69f\uc218\ub97c \uc801\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:frost-wool
    inGameDescription: "\uc11c\ub9ac \uc591\ubaa8\uc9c1\uc740 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c \uc0b0\uae30\uc2ad\uc758 \uc9c1\uc870\uac00\ub294 \uc11c\ub9ac \uc591\ubaa8\uc9c1\uc744 \uc5ec\ub7ec \uccb4\ud615\uc758 \uc637\uc73c\ub85c \uace0\uccd0 \uc4f0\ub3c4\ub85d \ud3ed\uacfc \ub298\uc5b4\ub098\ub294 \ubc29\ud5a5\uc744 \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:gold-ingot
    inGameDescription: "\uad8c\uc704 \uc2dc\uc124, \uc7a5\uc2dd\uacfc \uace0\uac00 \uc7a5\ube44\uc758 \uc7ac\ub8cc\uc774\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \uae08\uad34\uc758 \uc606\uba74\uc5d0\ub294 \uc8fc\uc870 \uc21c\uc11c\uc640 \uc2dd\ud78c \uc2dc\uac04\uac00 \uc595\uc740 \ud648\uc73c\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:granulated-powder
    inGameDescription: "\uacfc\ub9bd \ud654\uc57d\uc740 \ud654\uc57d\uacfc \uc5f0\uae08 \uacf5\uc815\uc5d0\uc11c \ubc18\uc751\uc744 \uc77c\uc73c\ud0a4\ub3c4\ub85d \uac74\uc870\ud574 \ub454 \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \uacfc\ub9bd \ud654\uc57d \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:grape-juice
    inGameDescription: "\ud3ec\ub3c4\uc999\uc740 \uc74c\ub8cc, \uc870\ub9ac\uc640 \uc57d\ud488 \uc81c\uc870\uc5d0 \ub098\ub220 \uc4f0\ub294 \uc561\uccb4 \uc7ac\ub8cc\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud3ec\ub3c4\uc999 \ubcd1\uc740 \uc758\uc2dd\uc6a9 \ud608\uc561\uacfc \uc11e\uc774\uc9c0 \uc54a\ub3c4\ub85d \ud770 \uc2e4\ub85c \ubb36\uace0, \ub3d9\uc758\uc758 \uc794 \ud45c\uc2dd\uacfc \ub098\ub780\ud788 \ub450\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:hardened-leather
    inGameDescription: "\uacbd\ud654 \uac00\uc8fd\uc740 \uc758\ubcf5, \ub048\uacfc \uac00\ubcbc\uc6b4 \ubc29\uc5b4\uad6c\uc5d0 \ub9de\uac8c \uc190\uc9c8\ud55c \uac00\uc8fd \uc7ac\ub8cc\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub294 \uacbd\ud654 \uac00\uc8fd \uac00\uc7a5\uc790\ub9ac\uc5d0 \uad7d\ud798 \ub4f1\uae09\uc744 \ub098\ud0c0\ub0b4\ub294 \uc9e7\uc740 \uce7c\uc9d1\uc744 \ub0b4\uc5b4 \ubc29\uc5b4\uad6c\uc6a9\uacfc \ub048\uc6a9\uc744 \uad6c\ubd84\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:iron-ingot
    inGameDescription: "\ucca0 \uc7a5\ube44\uc640 \uac15\ucca0\uc758 \uc8fc\uc7ac\ub8cc\uc774\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc0b0 \ucca0\uad34\uc5d0\ub294 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uacfc \ub418\ub179\uc778 \ud69f\uc218\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:laminated-lumber
    inGameDescription: "\uc801\uce35 \ubaa9\uc7ac\ub294 \uad6c\uc870\ubb3c\uacfc \uac00\uad6c, \uc190\uc7a1\uc774\ub97c \ub9cc\ub4e4 \uc218 \uc788\ub3c4\ub85d \uae38\uc774\uc640 \uacb0\uc744 \uc0b4\ub824 \ub454 \ubaa9\uc7ac\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \uc801\uce35 \ubaa9\uc7ac \ubb36\uc74c\uc740 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc758 \ud3ed\uc5d0 \ub9de\ucdb0 \ud55c \ubc88 \ub354 \uc9e7\uac8c \uc798\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:lead-ingot
    inGameDescription: "\ub0a9\uad34\ub294 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ub0a9\uad34\uc758 \uc606\uba74\uc5d0\ub294 \uc8fc\uc870 \uc21c\uc11c\uc640 \uc2dd\ud78c \uc2dc\uac04\uac00 \uc595\uc740 \ud648\uc73c\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:lead-shot
    inGameDescription: "\ub0a9\ud0c4\uc740 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \ub0a9\ud0c4 \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:leather
    inGameDescription: "\uade0\ud615 \uc7a1\ud78c \uc5f0\uac11\uacfc \uc7a5\ube44\uc758 \uc8fc\uc7ac\ub8cc\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uac00\uc8fd\uc5d0\ub294 \uc9d0\uc2b9\uc758 \uc885\ub958\uc640 \ubb34\ub450\uc9c8\ud55c \ub0a0\uc9dc\uac00 \uc0b4\uc774 \ubd99\uc5b4 \uc788\ub358 \uba74\uc5d0 \uc605\uac8c \ub20c\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:low-fuel
    inGameDescription: "\ubd80\ud328\ubb3c\uacfc \ubd84\ub1e8\ub97c \uad73\ud78c \ub0c4\uc0c8\ub098\ub294 \uc5f0\ub8cc\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc5d0\uc11c\ub294 \uc800\uae09 \uc5f0\ub8cc \ubcbd\ub3cc\uc744 \uc816\uc740 \uc9d0\uacfc \ub5a8\uc5b4\ub728\ub824 \uc2e3\uace0, \ub0c4\uc0c8\uac00 \uc0c8\uba74 \uac00\uc7a5 \uac00\uae4c\uc6b4 \uac80\ubb38\uc18c\uc5d0\uc11c \ub2e4\uc2dc \ub9d0\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:lumber
    inGameDescription: "\uac74\ucd95, \uac00\uad6c, \ud65c\uacfc \ubb34\uae30 \uc790\ub8e8\uc5d0 \uc4f0\ub294 \uaddc\uaca9\uc7ac\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \ubaa9\uc7ac \ubb36\uc74c\uc740 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc758 \ud3ed\uc5d0 \ub9de\ucdb0 \ud55c \ubc88 \ub354 \uc9e7\uac8c \uc798\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:malt
    inGameDescription: "\ub9e5\uc544\ub294 \uc2dd\uc7ac\ub8cc\ub97c \ud55c \ucc28\ub840 \uac00\uacf5\ud574 \uc870\ub9ac\uc640 \ubc1c\ud6a8\uc5d0 \ubc14\ub85c \uc4f8 \uc218 \uc788\uac8c \ub9cc\ub4e0 \uc7ac\ub8cc\ub2e4. \ud558\ub974\ub098\ud06c \uc7a5\ud130\uc758 \ub9e5\uc544 \uac12\uc740 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \uc218\uc704\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ud1b5\ud589\uc138\uc5d0 \ub530\ub77c \uba3c\uc800 \uc6c0\uc9c1\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:mana-alloy
    inGameDescription: "\ub9c8\ub098 \ud569\uae08\uc740 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ub9c8\ub098 \ud569\uae08\uc758 \uc606\uba74\uc5d0\ub294 \ub9c8\ub098\uac00 \ud750\ub978 \uc628\ub3c4\uac00 \uc595\uc740 \ud648\uc73c\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:mending-scrap
    inGameDescription: "\uc758\ubcf5\uc758 \uc791\uc740 \uad6c\uba4d\uacfc \ub2f3\uc740 \uac00\uc7a5\uc790\ub9ac\ub97c \ub367\ub300\uae30 \uc88b\uac8c \ud06c\uae30\ub97c \ub9de\ucd98 \uc218\uc120\uc6a9 \ucc9c \uc870\uac01\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc218\uc120 \uc870\uac01 \uafb8\ub7ec\ubbf8\ub294 \ucc9c \uc885\ub958\ubcf4\ub2e4 \ud06c\uae30\uc640 \ub298\uc5b4\ub098\ub294 \ubc29\ud5a5\uc744 \uba3c\uc800 \ub9de\ucdb0 \ubb36\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:mire-canvas
    inGameDescription: "\uc2b5\uc9c0 \uce94\ubc84\uc2a4\ub294 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ub178\ub974\uce78\ub4dc\ub77c\uc758 \uc2b5\uc9c0 \uce94\ubc84\uc2a4\uc5d0\ub294 \ubb3c\uc774 \uc2a4\uba70\ub4e0 \ub192\uc774\ub97c \uac00\ub2a0\ud560 \uc218 \uc788\ub3c4\ub85d \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud478\ub978 \ub208\uae08\uc2e4\uc744 \ub123\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:niter
    inGameDescription: "\ucd08\uc11d\uc740 \ud654\uc57d\uacfc \uc5f0\uae08 \uacf5\uc815\uc5d0\uc11c \ubc18\uc751\uc744 \uc77c\uc73c\ud0a4\ub3c4\ub85d \uac74\uc870\ud574 \ub454 \uc7ac\ub8cc\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubd89\uc740 \ubd09\ub78d\uc774 \uc5c6\ub294 \ucd08\uc11d \ubb36\uc74c\uc740 \ubc00\ub85c\uc138\uc544 \uac80\ubb38\uc18c\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:paper
    inGameDescription: "\uc885\uc774\ub294 \uae30\ub85d, \ud0c4\uc57d\uacfc \ub3c4\uba74 \uc81c\uc791\uc5d0 \ud544\uc694\ud55c \uc587\uc740 \uac00\uacf5 \uc7ac\ub8cc\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \uc885\uc774\ub294 \ub205\ub205\ud574\uc84c\ub294\uc9c0 \ud655\uc778\ud560 \uc218 \uc788\ub3c4\ub85d \uafb8\ub7ec\ubbf8 \ud55c\uac00\uc6b4\ub370\uc5d0 \ub9c8\ub978 \uc0c9\uc2e4\uc744 \ub07c\uc6cc \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:plate-blank
    inGameDescription: "\ub450\uaed8\uc640 \ub113\uc774\ub97c \ub9de\ucdb0 \uc798\ub77c \uac11\uc637\ud310\uacfc \uae30\uacc4 \uc678\ud53c\ub85c \uac00\uacf5\ud558\uae30 \uc804\uc758 \ud310\uae08 \uc18c\uc7ac\ub2e4. \ud2b9\ud788 \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc0b0 \ud310\uae08 \uc18c\uc7ac\ud310\uc758 \uc606\uba74\uc5d0\ub294 \uc8fc\uc870 \uc21c\uc11c\uc640 \uc2dd\ud78c \uc2dc\uac04\uac00 \uc595\uc740 \ud648\uc73c\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:ration-mixture
    inGameDescription: "\ubc30\uae09\uc2dd \ud63c\ud569\ubb3c\uc740 \uc624\ub798 \ubcf4\uad00\ud558\uac70\ub098 \ub2e4\uc74c \uc870\ub9ac\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub3c4\ub85d \ubbf8\ub9ac \uc190\uc9c8\ud55c \uc2dd\uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \ud558\ub974\ub098\ud06c \uc7a5\ud130\uc758 \ubc30\uae09\uc2dd \ud63c\ud569\ubb3c \uac12\uc740 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \uc218\uc704\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ud1b5\ud589\uc138\uc5d0 \ub530\ub77c \uba3c\uc800 \uc6c0\uc9c1\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:rope
    inGameDescription: "\ubc27\uc904\uc740 \ubb36\uc74c\uacfc \uc7a5\ub825, \uc7ac\ubd09\uc774 \ud544\uc694\ud55c \uc81c\uc791 \uacf5\uc815\uc5d0 \uc4f0\ub294 \uae34 \uc12c\uc720 \uc7ac\ub8cc\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \ubc27\uc904 \ubb36\uc74c\uc740 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc758 \ud3ed\uc5d0 \ub9de\ucdb0 \ud55c \ubc88 \ub354 \uc9e7\uac8c \uc798\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:rot-toxin
    inGameDescription: "\uae08\uae30 \uc57d\ubb3c\uacfc \ub3c5\uc131 \uc758\uc2dd\uc5d0 \uc4f0\ub294 \ub18d\ucd95 \ub3c5\uc18c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ubd80\ud328 \ub3c5\uc18c\ub294 \uc815\uc6d0 \ud759\uacfc \ub2ff\uc9c0 \uc54a\ub3c4\ub85d \uac80\uc740 \uc720\ub9ac\ubcd1\uc5d0 \ubc00\ubd09\ud558\uace0, \uc0c8\ub294 \ubcd1\uc740 \uc6a9\uae30\uc9f8 \ud0dc\uc6b4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:rune-leather
    inGameDescription: "\uace0\ubc29\uc5b4\uc640 \ub9c8\ubc95 \uc800\ud56d\uc744 \uc81c\uacf5\ud558\ub294 \uac00\uc8fd\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ub8ec\uac00\uc8fd\uc740 \ubb34\ub2ac\uac00 \ud750\ub974\ub294 \ubc29\ud5a5\uc744 \uac00\uc7a5\uc790\ub9ac\uc5d0 \ud45c\uc2dc\ud574 \uc7ac\ub2e8\ud560 \ub54c \ub9c8\ub098 \uacb0\uc744 \ub04a\uc9c0 \uc54a\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:salted-meat
    inGameDescription: "\uc5fc\uc9c0 \uace0\uae30\ub294 \uc624\ub798 \ubcf4\uad00\ud558\uac70\ub098 \ub2e4\uc74c \uc870\ub9ac\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub3c4\ub85d \ubbf8\ub9ac \uc190\uc9c8\ud55c \uc2dd\uc7ac\ub8cc\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc5fc\uc9c0 \uace0\uae30\uc5d0\ub294 \uc18c\uae08\uc5d0 \ubb3b\uc740 \ub0a0\uc9dc\uc640 \uc5ec\ud589\uc6a9 \ubaab\uc744 \ub098\ud0c0\ub0b4\ub294 \ub450 \uc904 \uce7c\uc9d1\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:seasoned-filling
    inGameDescription: "\uc591\ub150 \uc18d\uc7ac\ub8cc\ub294 \uc624\ub798 \ubcf4\uad00\ud558\uac70\ub098 \ub2e4\uc74c \uc870\ub9ac\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub3c4\ub85d \ubbf8\ub9ac \uc190\uc9c8\ud55c \uc2dd\uc7ac\ub8cc\ub2e4. \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc5d0\uc11c \uc628 \uc591\ub150 \uc18d\uc7ac\ub8cc \ud3ec\ub300\uc5d0\ub294 \uc18c\uae08\ubc14\ub78c \ub0c4\uc0c8\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ubd89\uc740 \uba3c\uc9c0\uac00 \ud568\uaed8 \ubc34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:sewing-thread
    inGameDescription: "\uc758\ubcf5\uc744 \uc0c8\ub85c \uc9d3\uac70\ub098 \ud130\uc9c4 \uc194\uae30\ub97c \uaff0\ub9ec \ub54c \uc4f0\ub3c4\ub85d \uad75\uae30\uc640 \uaf2c\uc784\uc744 \ub9de\ucd98 \uc7ac\ubd09\uc2e4\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \uc7ac\ubd09\uc2e4\uc740 \uc2e4\ud328\ub9c8\ub2e4 \uad75\uae30\uc640 \ub0a8\uc740 \uae38\uc774\ub97c \ud45c\uc2dc\ud574 \uae38 \uc704\uc5d0\uc11c\ub3c4 \ub9de\ub294 \uc2e4\uc744 \ubc14\ub85c \uace0\ub974\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:spore-hemp
    inGameDescription: "\ud3ec\uc790 \uc0bc\ubca0\ub294 \uc758\ubcf5\uacfc \uc548\uac10, \uc0dd\ud65c\uc6a9 \ucc9c\uc744 \uc7ac\ub2e8\ud558\ub294 \uc9c1\ubb3c \uc7ac\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc7ac\ub2e8\ud558\uace0 \ub0a8\uc740 \ud3ec\uc790 \uc0bc\ubca0\ub97c \uc798\uac8c \ud480\uc5b4 \uc5b4\ub9b0 \uade0\uc0ac \uc7ac\ubc30\uc0c1\uc758 \ub36e\uac1c\ub85c \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:spring-steel
    inGameDescription: "\uc6a9\uc218\ucca0\uac15\uc740 \ubb34\uae30, \ubc29\uc5b4\uad6c\uc640 \uc815\ubc00 \ubd80\ud488\uc758 \ud615\ud0dc\ub97c \uc7a1\ub294 \uae08\uc18d \uc7ac\ub8cc\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc0b0 \uc6a9\uc218\ucca0\uac15\uc5d0\ub294 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uacfc \ub418\ub179\uc778 \ud69f\uc218\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:starch
    inGameDescription: "\ubcf4\uc874\uc2dd\uacfc \uc811\ucc29 \uac00\uacf5\uc5d0 \uc4f0\ub294 \ub18d\uc0b0 \uc911\uac04\uc7ac\uc774\ub2e4. \ud2b9\ud788 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc0b0 \uc804\ubd84\uc740 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc624\ub798 \uc9c0\ub098\ub3c4 \uc0c1\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc791\uc740 \ud3ec\ub300\ub85c \ub098\ub25c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:steel-ingot
    inGameDescription: "\uace0\uae09 \ubb34\uae30\uc640 \ubc29\uc5b4\uad6c\uc5d0 \uc4f0\ub294 \uac15\ud55c \uae08\uc18d\uc774\ub2e4. \ud2b9\ud788 \ud06c\ub9ad \uc81c7\uad74\uc0b0 \uac15\ucca0\uc740 \ud488\uc9c8\uc774 \uc88b\uace0, \ud45c\uba74\uc5d0 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uacfc \ub418\ub179\uc778 \ud69f\uc218\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:sterile-composite
    inGameDescription: "\uc138\ucc99\ud55c \uc12c\uc720\uc640 \uacb0\ud569\uc7ac\ub97c \uc624\uc5fc \uc5c6\uc774 \uad73\ud600 \uc218\uc220 \ub3c4\uad6c\uc640 \ubcf4\ucca0 \uc678\ud53c\uc5d0 \uc4f0\ub294 \ubcf5\ud569\uc7ac\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uc9c0\ub098\ub294 \ubb34\uade0 \ubcf5\ud569\uc7ac\ub294 \ubd09\uc778\ub41c \uc0c1\uc790\uc9f8 \uac80\uc0ac\ud558\uba70, \uc0c9\uc2e4\uc774 \ub04a\uae34 \uac83\uc740 \uc758\ub8cc\uc6a9\uc73c\ub85c \ubc1b\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:stone-block
    inGameDescription: "\ubcbd, \ubc14\ub2e5, \uc5c4\ud3d0\uc640 \uc11d\uc870 \uc7a5\uc2dd\uc758 \uc7ac\ub8cc\uc774\ub2e4. \ud2b9\ud788 \ub178\ub974\uce78\ub4dc\ub77c\uc0b0 \uc11d\uc7ac \ube14\ub85d\uc758 \ubd89\uc740 \uc904\uc740 \ubd95\uad34 \uc704\ud5d8 \uacbd\uace0\ub2e4. \uc88b\uc740 \uad11\ub9e5 \ud45c\uc2dc\ub85c \uc77d\uc73c\uba74 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:syrup
    inGameDescription: "\ud638\ud654\uc2dd\uacfc \ubc1c\ud6a8 \uc74c\ub8cc\uc5d0 \uc4f0\ub294 \ub18d\ucd95\uc561\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ubc24\ud3ec\ub3c4 \uc2dc\ub7fd\uc740 \ud53c\uc640 \ube44\uc2b7\ud55c \uc0c9 \ub54c\ubb38\uc5d0 \ubcd1\ub9c8\uac1c\uc5d0 \ud3ec\ub3c4\uc78e\uc744 \uc0c8\uae30\uace0, \ub3d9\uc758\uc758 \uc794\uc5d0 \uc62c\ub9ac\ub294 \ud608\uc561\uacfc \uad6c\ubd84\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:tallow
    inGameDescription: "\ube44\ub204, \uc591\ucd08\uc640 \uc5f0\uace0\uc758 \uae30\ucd08\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc815\uc81c \uc9c0\ubc29\uc740 \uc870\ub9ac\uc6a9\uacfc \uacf5\uc5c5\uc6a9\uc744 \ud56d\uc544\ub9ac \ubd09\uc778\uc0c9\uc73c\ub85c \ub098\ub220 \ub0c4\uc0c8\uac00 \ubc34 \uac83\uc744 \uc74c\uc2dd\uc5d0 \uc4f0\uc9c0 \uc54a\uac8c \ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:treated-lumber
    inGameDescription: "\uc218\uc561\uc73c\ub85c \ubc29\uc2b5\u00b7\uac15\ud654\ud55c \ubaa9\uc7ac\uc774\ub2e4. \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\ub97c \uac74\ub10c \ucc98\ub9ac \ubaa9\uc7ac \ubb36\uc74c\uc740 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc758 \ud3ed\uc5d0 \ub9de\ucdb0 \ud55c \ubc88 \ub354 \uc9e7\uac8c \uc798\ub824 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:washed-vegetable
    inGameDescription: "\uc138\ucc99 \ucc44\uc18c\ub294 \uc624\ub798 \ubcf4\uad00\ud558\uac70\ub098 \ub2e4\uc74c \uc870\ub9ac\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub3c4\ub85d \ubbf8\ub9ac \uc190\uc9c8\ud55c \uc2dd\uc7ac\ub8cc\ub2e4. \ud558\ub974\ub098\ud06c \uc7a5\ud130\uc758 \uc138\ucc99 \ucc44\uc18c \uac12\uc740 \uc0ac\ub974\ubca0\ub2c8\uc544 \ub0b4\ud574\uc758 \uc218\uc704\uc640 \ubc00\ub85c\uc138\uc544 \uac00\ub3c4\uc758 \ud1b5\ud589\uc138\uc5d0 \ub530\ub77c \uba3c\uc800 \uc6c0\uc9c1\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: material:young-wine
    inGameDescription: "\uc5b4\ub9b0 \ud3ec\ub3c4\uc8fc\ub294 \uc74c\ub8cc, \uc870\ub9ac\uc640 \uc57d\ud488 \uc81c\uc870\uc5d0 \ub098\ub220 \uc4f0\ub294 \uc561\uccb4 \uc7ac\ub8cc\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc5b4\ub9b0 \ud3ec\ub3c4\uc8fc \ud1b5\uc740 \uc219\uc131 \uc804\uc5d0\ub294 \ud770 \ucc9c\uc73c\ub85c \ub36e\uace0, \ub3d9\uc758\uc758 \uc794\uc5d0 \uc62c\ub9b4 \ub54c\ub9cc \uac80\uc740 \ubd09\uc778\uc744 \ub2e8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:cross-lineage-medium
    inGameDescription: "\uc11c\ub85c \ub2e4\ub978 \uc885\uc871\uc758 \uc870\uc9c1\uc774 \ub9de\ub2ff\uc744 \ub54c \uc0dd\uae30\ub294 \uac70\ubd80 \ubc18\uc751\uc744 \ub0ae\ucd94\ub3c4\ub85d \uc870\uc728\ud55c \uc548\uc815\ud654 \ubc30\uc9c0\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \uad50\ucc28\uacc4\ud1b5 \uc548\uc815\ud654 \ubc30\uc9c0\ub97c \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:fertility-treatment
    inGameDescription: "\uc0dd\uc2dd \uce58\ub8cc\uc81c\ub294 \uc0dd\uc2dd \uae30\ub2a5\uc774\ub098 \ub178\ud654\ub85c \uc57d\ud574\uc9c4 \uc2e0\uccb4 \uc0c1\ud0dc\ub97c \uce58\ub8cc\ud558\ub294 \ub370 \uc4f4\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc0dd\uc2dd \uce58\ub8cc\uc81c\ub97c \uac74\ub124\uae30 \uc804 \ud658\uc790\uac00 \uc9c1\uc811 \ucd08\ub85d \ub9e4\ub4ed\uc744 \ubb36\ub294\ub2e4. \uce58\ub8cc\ub97c \uba48\ucdb0 \ub2ec\ub77c\ub294 \ub73b\uc774\uba74 \ud480\uc5b4 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:isolation-care-kit
    inGameDescription: "\uaca9\ub9ac \uce58\ub8cc \uafb8\ub7ec\ubbf8\uc5d0\ub294 \ud574\ub2f9 \uc0c1\ud669\uc5d0\uc11c \ud658\uc790\ub97c \uc548\uc815\uc2dc\ud0a4\uace0 \uce58\ub8cc\ub97c \uc2dc\uc791\ud560 \ubb3c\uc790\uac00 \ub4e4\uc5b4 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uaca9\ub9ac\uc2e4\uc5d0\uc11c \uc4f0\ub294 \uaca9\ub9ac \uce58\ub8cc \uafb8\ub7ec\ubbf8\uc5d0\ub294 \ubc29\ub9c8\ub2e4 \ub2e4\ub978 \ud3ec\uc790\uc0c9\uc774 \ubc30\uc5b4 \uc788\uc5b4 \ubc16\uc73c\ub85c \uc11e\uc774\uba74 \uace7 \ub4dc\ub7ec\ub09c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:mana-core-case
    inGameDescription: "\ub9c8\ud575 \ucf00\uc774\uc2a4\ub294 \uc77c\ubc18 \ubd95\ub300\uac00 \ub9de\uc9c0 \uc54a\ub294 \ud2b9\uc218 \uc2e0\uccb4 \uad6c\uc870\ub97c \uc548\uc815\uc2dc\ud0a4\ub294 \ucc98\uce58 \ub3c4\uad6c\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uae30\uc5b5\ud310 \uc548\uce58\uc5d0\uc11c\ub294 \ub9c8\ud575 \ucf00\uc774\uc2a4\ub97c \uc190\ubcf4\uae30 \uc804\uc5d0 \uae30\uc5b5\ud310\ubd80\ud130 \ub5bc\uc5b4 \ub0b8\ub2e4. \ubab8\ubcf4\ub2e4 \uc0ac\ub78c\uc774 \uba3c\uc800\ub77c\ub294 \uc624\ub798\ub41c \uc21c\uc11c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:organ-preservation-canister
    inGameDescription: "\uc7a5\uae30 \ubcf4\uc874 \uc6a9\uae30\ub294 \uc2ec\ud55c \uc870\uc9c1 \uc190\uc0c1\uacfc \uc7a5\uae30 \ud68c\ubcf5\uc744 \uc9c0\uc6d0\ud558\ub294 \uace0\uae09 \uc758\ub8cc \uc7ac\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc7a5\uae30 \ubcf4\uc874 \uc6a9\uae30 \ubcd1\uc5d0\ub294 \uc0ac\ub78c\uc758 \uc885\uc871\ubcf4\ub2e4 \ubab8\uc774 \ubcf4\uc778 \ubc18\uc751\uc744 \uba3c\uc800 \ud45c\uc2dc\ud558\ub294 \uc0c9\uc810\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:organ-regeneration-scaffold
    inGameDescription: "\uc7a5\uae30 \uc7ac\uc0dd \uace8\uaca9\uc740 \uc2ec\ud55c \uc870\uc9c1 \uc190\uc0c1\uacfc \uc7a5\uae30 \ud68c\ubcf5\uc744 \uc9c0\uc6d0\ud558\ub294 \uace0\uae09 \uc758\ub8cc \uc7ac\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc7a5\uae30 \uc7ac\uc0dd \uace8\uaca9 \ubcd1\uc5d0\ub294 \uc0ac\ub78c\uc758 \uc885\uc871\ubcf4\ub2e4 \ubab8\uc774 \ubcf4\uc778 \ubc18\uc751\uc744 \uba3c\uc800 \ud45c\uc2dc\ud558\ub294 \uc0c9\uc810\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:regenerative-medium
    inGameDescription: "\uc7ac\uc0dd \ubc30\uc591\uc561\uc740 \uc2ec\ud55c \uc870\uc9c1 \uc190\uc0c1\uacfc \uc7a5\uae30 \ud68c\ubcf5\uc744 \uc9c0\uc6d0\ud558\ub294 \uace0\uae09 \uc758\ub8cc \uc7ac\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \uc7ac\uc0dd \ubc30\uc591\uc561\uc744 \uac74\ub124\uae30 \uc804 \ud658\uc790\uac00 \uc9c1\uc811 \ucd08\ub85d \ub9e4\ub4ed\uc744 \ubb36\ub294\ub2e4. \uce58\ub8cc\ub97c \uba48\ucdb0 \ub2ec\ub77c\ub294 \ub73b\uc774\uba74 \ud480\uc5b4 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:rejuvenation-serum
    inGameDescription: "\ud68c\ucd98 \ud608\uccad\uc740 \uc0dd\uc2dd \uae30\ub2a5\uc774\ub098 \ub178\ud654\ub85c \uc57d\ud574\uc9c4 \uc2e0\uccb4 \uc0c1\ud0dc\ub97c \uce58\ub8cc\ud558\ub294 \ub370 \uc4f4\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ud68c\ucd98 \ud608\uccad\uc744 \uac74\ub124\uae30 \uc804 \ud658\uc790\uac00 \uc9c1\uc811 \ucd08\ub85d \ub9e4\ub4ed\uc744 \ubb36\ub294\ub2e4. \uce58\ub8cc\ub97c \uba48\ucdb0 \ub2ec\ub77c\ub294 \ub73b\uc774\uba74 \ud480\uc5b4 \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:rune-hibernation-catalyst
    inGameDescription: "\ub8ec \ub3d9\uba74 \ucd09\ub9e4\ub294 \uc77c\ubc18 \ubd95\ub300\uac00 \ub9de\uc9c0 \uc54a\ub294 \ud2b9\uc218 \uc2e0\uccb4 \uad6c\uc870\ub97c \uc548\uc815\uc2dc\ud0a4\ub294 \ucc98\uce58 \ub3c4\uad6c\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec \ub3d9\uba74 \ucd09\ub9e4\uc5d0\ub294 \ud658\uc790, \uc9d1\ub3c4\uc758\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ub204\ub978 \uc138 \ubd09\uc778\uc774 \ubaa8\ub450 \uc788\uc5b4\uc57c \ube5b\uc774 \ub3c8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:slime-coagulation-frame
    inGameDescription: "\uc810\uc561 \uc751\uace0\ud2c0\uc740 \uc77c\ubc18 \ubd95\ub300\uac00 \ub9de\uc9c0 \uc54a\ub294 \ud2b9\uc218 \uc2e0\uccb4 \uad6c\uc870\ub97c \uc548\uc815\uc2dc\ud0a4\ub294 \ucc98\uce58 \ub3c4\uad6c\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958 \uce58\ub8cc\uc0ac\ub294 \uc810\uc561 \uc751\uace0\ud2c0\uc744 \ub9d1\uc740 \ubb3c\uc5d0 \ud55c \ubc29\uc6b8 \ud480\uc5b4 \uc0c9\uc774 \ud575 \ucabd\uc73c\ub85c \ubc88\uc9c0\ub294\uc9c0 \uba3c\uc800 \ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:sterile-bandage
    inGameDescription: "\ubb34\uade0 \ubd95\ub300\ub85c \uc0c1\ucc98\uc640 \uc190\uc0c1 \ubd80\uc704\ub97c \ub36e\uac70\ub098 \uace0\uc815\ud574 \uce58\ub8cc\ub97c \ub3d5\ub294\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uaca9\ub9ac\uc2e4\uc5d0\uc11c \uc4f0\ub294 \ubb34\uade0 \ubd95\ub300\uc5d0\ub294 \ubc29\ub9c8\ub2e4 \ub2e4\ub978 \ud3ec\uc790\uc0c9\uc774 \ubc30\uc5b4 \uc788\uc5b4 \ubc16\uc73c\ub85c \uc11e\uc774\uba74 \uace7 \ub4dc\ub7ec\ub09c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:sterile-mycelium-graft
    inGameDescription: "\ubb34\uade0 \uade0\uc0ac \uc774\uc2dd\ud3b8\uc740 \uce58\ub8cc \ub3c4\uad6c\uc640 \uc0c1\ucc98 \uc8fc\ubcc0\uc758 \uc624\uc5fc\uc744 \uc904\uc774\ub294 \ub370 \uc4f4\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ubb34\uade0 \uade0\uc0ac \uc774\uc2dd\ud3b8\uc740 \ubcd1\uc744 \ub2eb\uc740 \ub4a4\uc5d0\ub3c4 \ucc9c\ucc9c\ud788 \uc790\ub780\ub2e4. \uacf5\ub3d9 \uc815\uc6d0\uc740 \uc808\ubc18 \uc774\uc0c1 \ucc44\ucde8\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: witness:mycelial-garden
  - kind: 0
    stableId: medical:trait-analysis-kit
    inGameDescription: "\ud615\uc9c8 \uac80\uc0ac \ud0a4\ud2b8\ub85c \ud658\uc790\uc758 \uc2e0\uccb4 \uacc4\ud1b5\uacfc \uc774\uc2dd \uc801\ud569\uc131\uc744 \uac80\uc0ac\ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \ud615\uc9c8 \uac80\uc0ac \ud0a4\ud2b8\uc5d0\ub294 \uc7ac\ub8cc\ub97c \uae30\ub978 \uc815\uc6d0\uc758 \ud759\uc774 \uc791\uc740 \uc720\ub9ac\uce78\uc5d0 \ud568\uaed8 \ubd09\ud574\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:trauma-care-kit
    inGameDescription: "\ud2b8\ub77c\uc6b0\ub9c8 \uce58\ub8cc \uafb8\ub7ec\ubbf8\uc5d0\ub294 \ud574\ub2f9 \uc0c1\ud669\uc5d0\uc11c \ud658\uc790\ub97c \uc548\uc815\uc2dc\ud0a4\uace0 \uce58\ub8cc\ub97c \uc2dc\uc791\ud560 \ubb3c\uc790\uac00 \ub4e4\uc5b4 \uc788\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ud2b8\ub77c\uc6b0\ub9c8 \uce58\ub8cc \uafb8\ub7ec\ubbf8\ub97c \uc4f4 \ub4a4 \ud1b5\uc99d\uc774 \uac00\ub77c\uc549\uc544\ub3c4 \ud658\uc790\uac00 \uc2a4\uc2a4\ub85c \uac77\uae30 \uc804\uc5d0\ub294 \ud68c\ubcf5\ub410\ub2e4\uace0 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medical:whole-body-regeneration-medium
    inGameDescription: "\uc804\uc2e0 \uc7ac\uc0dd \ubc30\uc9c0\ub294 \uc2ec\ud55c \uc870\uc9c1 \uc190\uc0c1\uacfc \uc7a5\uae30 \ud68c\ubcf5\uc744 \uc9c0\uc6d0\ud558\ub294 \uace0\uae09 \uc758\ub8cc \uc7ac\ub8cc\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc804\uc2e0 \uc7ac\uc0dd \ubc30\uc9c0 \ubcd1\uc5d0\ub294 \uc0ac\ub78c\uc758 \uc885\uc871\ubcf4\ub2e4 \ubab8\uc774 \ubcf4\uc778 \ubc18\uc751\uc744 \uba3c\uc800 \ud45c\uc2dc\ud558\ub294 \uc0c9\uc810\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:advanced
    inGameDescription: "\ub9c8\ub098\uc640 \uc6d4\ud654\ub97c \uc548\uc815\ud654\ud55c \uace0\uae09 \uce58\ub8cc\uc81c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \uace0\uae09 \uc57d\ud488\uc744 \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:anesthetic
    inGameDescription: "\uc218\uc220\uacfc \uc911\uc0c1 \uce58\ub8cc\uc758 \uace0\ud1b5\uc744 \ub0ae\ucd98\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \ub9c8\ucde8\uc81c\ub97c \uc4f4 \ub4a4 \ud1b5\uc99d\uc774 \uac00\ub77c\uc549\uc544\ub3c4 \ud658\uc790\uac00 \uc2a4\uc2a4\ub85c \uac77\uae30 \uc804\uc5d0\ub294 \ud68c\ubcf5\ub410\ub2e4\uace0 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:antidote
    inGameDescription: "\ub3c5\uc18c\uc640 \uacfc\ub2e4 \ubcf5\uc6a9 \uc99d\uc0c1\uc744 \uc644\ud654\ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \ud574\ub3c5\uc81c\ub294 \ub3c5\uc758 \uacc4\ud1b5\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc57d\ubcd1\uc758 \ud3ec\uc790\uc810\ubd80\ud130 \uac80\uac8c \ubcc0\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:antiseptic
    inGameDescription: "\uac10\uc5fc \uc704\ud5d8\uc744 \ub0ae\ucd94\ub294 \uc678\uc6a9 \uc57d\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc678\uc6a9 \uc18c\ub3c5\uc81c\ub294 \ud53c\ubd80\uc5d0 \ub2ff\uc73c\uba74 \uc605\uc740 \ucd08\ub85d\ube5b\uc774 \ub3c8\ub2e4. \ube5b\uc774 \uac80\uc5b4\uc9c0\uba74 \uace7\ubc14\ub85c \uc53b\uc5b4 \ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:blood-pack
    inGameDescription: "\ucd9c\ud608 \uc704\ud5d8\uc774 \ud070 \uc774\uc2dd\uacfc \uc751\uae09 \uc218\uc220\uc5d0 \uc0ac\uc6a9\ud55c\ub2e4. \ud558\ub974\ub098\ud06c \ubc24\uad81\uc815\uc758 \uc218\ud608 \ud329\uc5d0\ub294 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uac80\uc740 \uc2e4\uacfc \ud658\uc790\uc758 \ud770 \uc2e4\uc774 \ud568\uaed8 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:blood-seal-kit
    inGameDescription: "\ubc40\ud30c\uc774\uc5b4 \ud608\uc561\ub0ad\uacfc \ud608\ub85c\ub97c \uc784\uc2dc \ubd09\ud569\ud55c\ub2e4. \ud558\ub974\ub098\ud06c \ubc24\uad81\uc815\uc758 \ud608\uc561 \ubd09\ud569 \ud0a4\ud2b8\uc5d0\ub294 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uac80\uc740 \uc2e4\uacfc \ud658\uc790\uc758 \ud770 \uc2e4\uc774 \ud568\uaed8 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:disinfectant
    inGameDescription: "\uc218\uc220\uc2e4 \uc138\uc815\uacfc \uac10\uc5fc \uc5b5\uc81c\uc5d0 \uc4f0\ub294 \uc57d\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uae30\uad6c \uc18c\ub3c5\uc81c\ub294 \ub9c8\ub974\uba74 \ud770 \ud3ec\uc790\ub9c9\uc744 \ub0a8\uae34\ub2e4. \ub2e6\uc774\uc9c0 \uc54a\uc740 \ud2c8\uc744 \ub208\uc73c\ub85c \ucc3e\uae30 \uc704\ud55c \ud754\uc801\uc774\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:field-emergency-kit
    inGameDescription: "\uc0dd\ubb3c\ud615 \ubd80\uc704\ub97c \uadc0\ud658 \uac00\ub2a5\ud55c \uc218\uc900\uc73c\ub85c \uac00\uace0\uc815\ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc57c\uc804 \uc751\uae09 \ud0a4\ud2b8 \ud3ec\uc7a5\ub048\uc740 \uc0c1\ucc98 \uc885\ub958\ub9c8\ub2e4 \ub9e4\ub4ed\uc774 \ub2ec\ub77c \uc5b4\ub450\uc6b4 \uc6d0\uc815\uae38\uc5d0\uc11c\ub3c4 \uc190\ub05d\uc73c\ub85c \uace0\ub97c \uc218 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:herbal-poultice
    inGameDescription: "\uac00\ubcbc\uc6b4 \ubd80\uc0c1\uc5d0 \uc4f0\ub294 \uae30\ubcf8 \uc57d\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \uc57d\ucd08 \ucc1c\uc9c8\uc57d\uc744 \uc4f4 \ub4a4 \ud1b5\uc99d\uc774 \uac00\ub77c\uc549\uc544\ub3c4 \ud658\uc790\uac00 \uc2a4\uc2a4\ub85c \uac77\uae30 \uc804\uc5d0\ub294 \ud68c\ubcf5\ub410\ub2e4\uace0 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:immunosuppressant
    inGameDescription: "\uc774\uc885 \uc7a5\uae30 \uac70\ubd80 \ubc18\uc751\uc744 \ub0ae\ucd94\uc9c0\ub9cc \uac10\uc5fc \uc800\ud56d\ub3c4 \ub0ae\ucd98\ub2e4. \ubbc0\ub124\uc2e4\ub77c \uce58\ub8cc\uc0ac\ub294 \uba74\uc5ed\uc5b5\uc81c\uc81c\ub97c \uc4f4 \ub4a4 \ud658\uc790\uac00 \ub2e4\uc2dc \uba39\uace0 \uac77\uace0 \uc77c\ud560 \ub54c\uae4c\uc9c0 \uc57d\ubcd1\uc744 \uce58\uc6b0\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:mana-core-restraint
    inGameDescription: "\ubd88\uc548\uc815\ud55c \ub9c8\ud575\uc744 \ubd09\uc778\ud574 \uadc0\ud658 \uc911 \ud3ed\uc8fc\ub97c \uc5b5\uc81c\ud55c\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uae30\uc5b5\ud310 \uc548\uce58\uc5d0\uc11c\ub294 \ub9c8\ud575 \uad6c\uc18d\uad6c\ub97c \uc190\ubcf4\uae30 \uc804\uc5d0 \uae30\uc5b5\ud310\ubd80\ud130 \ub5bc\uc5b4 \ub0b8\ub2e4. \ubab8\ubcf4\ub2e4 \uc0ac\ub78c\uc774 \uba3c\uc800\ub77c\ub294 \uc624\ub798\ub41c \uc21c\uc11c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:mycelial-culture-pack
    inGameDescription: "\uc190\uc0c1\ub41c \uade0\uc0ac \uc5f0\uacb0\uc744 \uadc0\ud658 \uc804\uae4c\uc9c0 \uc720\uc9c0\ud55c\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uade0\uc0ac \ubc30\uc591 \ud329\uc740 \ubcd1\uc744 \ub2eb\uc740 \ub4a4\uc5d0\ub3c4 \ucc9c\ucc9c\ud788 \uc790\ub780\ub2e4. \uacf5\ub3d9 \uc815\uc6d0\uc740 \uc808\ubc18 \uc774\uc0c1 \ucc44\ucde8\ud558\uc9c0 \uc54a\ub294\ub2e4."
    worldBranchTag: witness:mycelial-garden
  - kind: 0
    stableId: medicine:rune-slime-patch
    inGameDescription: "\uc2ac\ub77c\uc784 \uc678\ub9c9\uacfc \uc751\uc9d1\ud575\uc758 \ub204\ucd9c\uc744 \uc784\uc2dc \ubd09\ud569\ud55c\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958 \uce58\ub8cc\uc0ac\ub294 \ub8ec \uc810\uc561 \ud328\uce58\ub97c \ub9d1\uc740 \ubb3c\uc5d0 \ud55c \ubc29\uc6b8 \ud480\uc5b4 \uc0c9\uc774 \ud575 \ucabd\uc73c\ub85c \ubc88\uc9c0\ub294\uc9c0 \uba3c\uc800 \ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:standard
    inGameDescription: "\uce58\ub8cc \ud6a8\uc728\uacfc \ud68c\ubcf5 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \uc57d\ud488\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \ud45c\uc900 \uc57d\ud488 \ubcd1\uc5d0\ub294 \uc0ac\ub78c\uc758 \uc885\uc871\ubcf4\ub2e4 \ubab8\uc774 \ubcf4\uc778 \ubc18\uc751\uc744 \uba3c\uc800 \ud45c\uc2dc\ud558\ub294 \uc0c9\uc810\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:temporary-power-bypass
    inGameDescription: "\ud30c\uc190\ub41c \uad6c\uc131\uccb4 \ud575\uacfc \uc11c\ubcf4\ub97c \uc784\uc2dc \ud68c\ub85c\ub85c \uc6b0\ud68c\ud55c\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uae30\uc5b5\ud310 \uc548\uce58\uc5d0\uc11c\ub294 \uc784\uc2dc \ub3d9\ub825 \ubc14\uc774\ud328\uc2a4\ub97c \uc190\ubcf4\uae30 \uc804\uc5d0 \uae30\uc5b5\ud310\ubd80\ud130 \ub5bc\uc5b4 \ub0b8\ub2e4. \ubab8\ubcf4\ub2e4 \uc0ac\ub78c\uc774 \uba3c\uc800\ub77c\ub294 \uc624\ub798\ub41c \uc21c\uc11c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:blood-wasting
    inGameDescription: "\ud608\uc561\uc18c\ubaa8\ubcd1 \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ud558\ub974\ub098\ud06c \ubc24\uad81\uc815\uc758 \ud608\uc561\uc18c\ubaa8\ubcd1 \ubc31\uc2e0\uc5d0\ub294 \ub3d9\uc758\uc758 \uc794\uc5d0\uc11c \ub5bc\uc5b4 \ub0b8 \uac80\uc740 \uc2e4\uacfc \ud658\uc790\uc758 \ud770 \uc2e4\uc774 \ud568\uaed8 \ubb36\uc778\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:cave-flu
    inGameDescription: "\ub3d9\uad74 \ub3c5\uac10 \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \ub3d9\uad74 \ub3c5\uac10 \ubc31\uc2e0 \ubcd1\uc5d0\ub294 \uc811\uc885 \uc2dc\uae30\uc640 \ubcf4\uad00 \uc628\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud3ec\uc790 \uace0\ub9ac\uac00 \ub458\ub7ec\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:gut-rot
    inGameDescription: "\uc7a5\ubd80\ud328\uc99d \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \uc7a5\ubd80\ud328\uc99d \ubc31\uc2e0 \ubcd1\uc5d0\ub294 \uc811\uc885 \uc2dc\uae30\uc640 \ubcf4\uad00 \uc628\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud3ec\uc790 \uace0\ub9ac\uac00 \ub458\ub7ec\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:mana-pox
    inGameDescription: "\ub9c8\ub098\ub450\ucc3d \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub9c8\ub098\ub450\ucc3d \ubc31\uc2e0\uc5d0\ub294 \ud658\uc790, \uc9d1\ub3c4\uc758\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ub204\ub978 \uc138 \ubd09\uc778\uc774 \ubaa8\ub450 \uc788\uc5b4\uc57c \ube5b\uc774 \ub3c8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:red-fever
    inGameDescription: "\uc801\uc5f4\ubcd1 \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \uc801\uc5f4\ubcd1 \ubc31\uc2e0 \ubcd1\uc5d0\ub294 \uc811\uc885 \uc2dc\uae30\uc640 \ubcf4\uad00 \uc628\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud3ec\uc790 \uace0\ub9ac\uac00 \ub458\ub7ec\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:slime-blight
    inGameDescription: "\uc810\uc561\uc5ed\ubcd1 \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958 \uce58\ub8cc\uc0ac\ub294 \uc810\uc561\uc5ed\ubcd1 \ubc31\uc2e0\uc744 \ub9d1\uc740 \ubb3c\uc5d0 \ud55c \ubc29\uc6b8 \ud480\uc5b4 \uc0c9\uc774 \ud575 \ucabd\uc73c\ub85c \ubc88\uc9c0\ub294\uc9c0 \uba3c\uc800 \ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:vaccine:spore-lung
    inGameDescription: "\ud3ec\uc790\ud3d0\uc99d \ubc31\uc2e0\uc740 \ud2b9\uc815 \uac10\uc5fc\uc5d0 \ub300\ube44\ud574 \uba74\uc5ed \ubc18\uc751\uc744 \uc900\ube44\uc2dc\ud0a4\ub294 \uc758\ub8cc \ubb3c\uc790\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc0b0 \ud3ec\uc790\ud3d0\uc99d \ubc31\uc2e0 \ubcd1\uc5d0\ub294 \uc811\uc885 \uc2dc\uae30\uc640 \ubcf4\uad00 \uc628\ub3c4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud3ec\uc790 \uace0\ub9ac\uac00 \ub458\ub7ec\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: medicine:wing-splint-kit
    inGameDescription: "\ud30c\uc190\ub41c \ub0a0\uac1c\uc640 \uaf2c\ub9ac\uae43\uc744 \uc6b4\ubc18 \uac00\ub2a5\ud55c \uc0c1\ud0dc\ub85c \uace0\uc815\ud55c\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uce58\ub8cc\uc0ac\ub294 \ub0a0\uac1c \uace0\uc815 \ud0a4\ud2b8\ub97c \ub304 \ub4a4 \uac77\ub294 \uc790\uc138\uc640 \ube44\ud589 \ub54c\uc758 \uc7a5\ub825\uc744 \ub530\ub85c \uac80\uc0ac\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: offense:appraised-valuables
    inGameDescription: "\ucd9c\ucc98\uc640 \uac00\uce58\ub97c \ud655\uc778\ud55c \uc6d0\uc815 \uadc0\uc911\ud488. \ud310\ub9e4 \uc815\ucc45\uc73c\ub85c \uae08\uace0 \uc790\uae08\ud654\ud560 \uc218 \uc788\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uac10\uc815\uc0ac\ub294 \uac10\uc815\ub41c \uadc0\uc911\ud488\uc5d0 \uc6d0\ub798 \uc8fc\uc778, \ubc1c\uacac\ud55c \uae38\uacfc \ub3cc\ub824\uc904 \uac00\ub2a5\uc131\uc744 \ud568\uaed8 \uc801\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: offense:unappraised-loot
    inGameDescription: "\uc6d0\uc815\uc5d0\uc11c \ud68c\uc218\ud55c \ubd09\uc778 \uc0c1\uc790\uc640 \uadc0\uc911\ud488. \uc804\ub9ac\ud488\uac70\uce58\ub300\uc5d0\uc11c \uac10\uc815\ud574\uc57c \ud310\ub9e4\ud560 \uc218 \uc788\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub294 \ubbf8\uac10\uc815 \uc804\ub9ac\ud488\uc744 \uc2b9\uc790\uc758 \ubaab\uc73c\ub85c \ub098\ub204\uae30 \uc804\uc5d0 \ud53c\ub09c\ubbfc\uacfc \uc2e4\uc885\uc790\uc758 \ud45c\uc2dd\uc744 \uba3c\uc800 \ucc3e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: record:arcane-index
    inGameDescription: "\ub8ec\uacfc \uc8fc\ubb38\uc744 \ud6a8\uacfc, \uc7ac\ub8cc\uc640 \uc704\ud5d8\ubcc4\ub85c \ucc3e\uc544\ubcfc \uc218 \uc788\uac8c \uc815\ub9ac\ud55c \ube44\uc804 \uc0c9\uc778\ucca0\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ube44\uc804 \uc0c9\uc778\ucca0\uc5d0\ub294 \uac19\uc740 \uc8fc\ubb38\uc744 \uc218\ud638\uc6d0\uc740 \ubb34\uae30\ub85c, \ub4f1\uae30\uc6d0\uc740 \uc555\uc218\ubb3c\ub85c, \ud1b5\uc0c1\uc6d0\uc740 \uacfc\uc138\ud488\uc73c\ub85c \ubd84\ub958\ud55c \ud754\uc801\uc774 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: first-accord-record
  - kind: 0
    stableId: record:breeding-ledger
    inGameDescription: "\uac00\ucd95\uc758 \uc9dd\uc9d3\uae30, \ucd9c\uc0b0\uacfc \ud615\uc9c8\uc744 \uc138\ub300\ubcc4\ub85c \uae30\ub85d\ud574 \ub2e4\uc74c \ubc88\uc2dd\uc744 \uacc4\ud68d\ud558\ub294 \uc7a5\ubd80\ub2e4. \uc624\ub974\ub370\ub098\uc758 \ubc88\uc2dd \uc7a5\ubd80\ub294 \uac00\uc871\uc744 \ud608\ud1b5 \uce78\uc5d0 \ub9de\ucd94\uba70 \ub2e4\ub978 \uc885\uc871\uc774 \ud568\uaed8 \uae30\ub978 \uc544\uc774\uc758 \uc591\uc721 \uae30\ub85d\uc744 \uc5ec\ubc31\uc73c\ub85c \ubc00\uc5b4\ub0c8\ub2e4."
    worldBranchTag: first-accord-record
  - kind: 0
    stableId: record:career-ledger
    inGameDescription: "\uc8fc\ubbfc\uc758 \uc5c5\ubb34 \uacbd\ub825\uacfc \uc219\ub828 \ubcc0\ud654\ub97c \uc801\uc5b4 \ubc30\uce58\uc640 \uad50\uc721\uc5d0 \ucc38\uace0\ud558\ub294 \uc7a5\ubd80\ub2e4. \uc624\ub974\ub370\ub098\uc758 \uacbd\ub825 \uc7a5\ubd80\ub294 \ud558\ub974\ub098\ud06c\uc5d0\uc11c \uc775\ud78c \uc219\ub828\uc744 \uc778\uc815\ud558\uc9c0 \uc54a\uc544 \ub3cc\uc544\uc628 \uae30\uc220\uc790\ub97c \ubb34\uacbd\ub825\uc790\ub85c \uae30\ub85d\ud55c\ub2e4."
    worldBranchTag: first-accord-record
  - kind: 0
    stableId: relic:faction:beastkin:1
    inGameDescription: "\ubb34\ub9ac\uc758 \uccab \uacf5\ub3d9 \uc0ac\ub0e5\uc5d0\uc11c \uc2b9\uc790\ub97c \ud45c\uc2dc\ud558\ub358 \uc778\uc7a5\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uccab\ubc1c\ud1b1 \uc778\uc7a5\uc740 \ud608\ud1b5\uc774 \ub2ec\ub77c\ub3c4 \uac19\uc740 \uae38\uc744 \uc9c0\ud0a8 \uc0ac\ub78c\uc744 \ud55c \ubb34\ub9ac\ub85c \ubc1b\uc544\ub4e4\uc778 \uae30\ub85d\uc774\ub2e4."
    worldBranchTag: witness:redclaw-trading-post
  - kind: 0
    stableId: relic:faction:beastkin:2
    inGameDescription: "\ud769\uc5b4\uc9c4 \uc0ac\ub0e5\ub300\ub97c \ud55c \ubc88\ub9cc \ub418\ub3cc\ub824 \ubd80\ub974\ub294 \ud638\uac01\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubb34\ub9ac\ubf08 \ud638\uac01\uc740 \ud53c\ub09c \ud589\ub82c\uc5d0\uc11c \uac00\uc7a5 \ub290\ub9b0 \uc0ac\ub78c\uc758 \uc18d\ub3c4\uc5d0 \ub9de\ucdb0 \uc6b8\ub838\ub2e4."
    worldBranchTag: witness:redclaw-trading-post
  - kind: 0
    stableId: relic:faction:beastkin:3
    inGameDescription: "\ubb34\ub9ac\uc758 \ubcf4\ud638\ub97c \ubc1b\uc740 \uc678\ubd80\uc778\uc5d0\uac8c\ub9cc \uc8fc\ub294 \ud540\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \ubd89\uc740\uc0ac\ub0e5 \ub9dd\ud1a0\ud540\uc5d0\ub294 \uc0ac\ub0e5\ud55c \uc9d0\uc2b9\ubcf4\ub2e4 \ud568\uaed8 \ub3cc\uc544\uc628 \uc0ac\ub78c\uc758 \uc218\uac00 \uba3c\uc800 \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: witness:redclaw-trading-post
  - kind: 0
    stableId: relic:faction:demon:1
    inGameDescription: "\uc138 \ub2f9\uc0ac\uc790\uac00 \uac19\uc740 \uc758\ubb34\ub97c \uc778\uc815\ud588\ub2e4\ub294 \uc778\uc7a5\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc0bc\uc911\uacc4\uc57d \uc778\uc7a5\uc740 \uc57d\uc18d\ud55c \uc0ac\ub78c, \ub300\uac00\ub97c \ub0b8 \uc0ac\ub78c\uacfc \ucc45\uc784\uc9c8 \uc0ac\ub78c\uc744 \ub530\ub85c \uae30\ub85d\ud55c\ub2e4."
    worldBranchTag: witness:ashen-contract-court
  - kind: 0
    stableId: relic:faction:demon:2
    inGameDescription: "\uac70\uc9d3 \uc11c\uba85\uc744 \ud0dc\uc6b8 \ub54c\ub9cc \ubd89\uac8c \ud0c0\ub294 \uc791\uc740 \ubd88\uc528\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc7ac\ud310\uad00\uc758 \ubd88\uc528\ub294 \uac15\uc694\ub41c \uacc4\uc57d\uc744 \ud0dc\uc6cc \uc5c6\uc564 \ud310\uacb0 \ub4a4\uc5d0\ub3c4 \uaebc\uc9c0\uc9c0 \uc54a\uc558\ub2e4\uace0 \uc804\ud574\uc9c4\ub2e4."
    worldBranchTag: witness:ashen-contract-court
  - kind: 0
    stableId: relic:faction:demon:3
    inGameDescription: "\ud55c \ubc88\uc758 \ubd80\ub2f9\ud55c \uc138\ub825 \uc758\ubb34\ub97c \ubb34\ud6a8\ud654\ud558\ub294 \uc6d0\ubcf8 \ubb38\uc11c\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ubb34\ud6a8\uc870\ud56d \ub450\ub8e8\ub9c8\ub9ac\ub294 \ub2f9\uc0ac\uc790\uac00 \ub9c8\uc74c\uc744 \ubc14\uafc0 \uad8c\ub9ac\ub97c \uacc4\uc57d\ubcf4\ub2e4 \uc55e\uc5d0 \ub454\ub2e4."
    worldBranchTag: witness:ashen-contract-court
  - kind: 0
    stableId: relic:faction:golem:1
    inGameDescription: "\ud0c0\uc778\uc774 \ub36e\uc5b4\uc4f8 \uc218 \uc5c6\ub294 \uac1c\uc778 \uc778\uaca9 \uac01\uc778 \uc870\uac01\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uc790\uae30\uac01\uc778 \ud575\ud3b8\uc740 \uace8\ub818\uc774 \uc81c\uc791 \ubc88\ud638 \ub300\uc2e0 \uc2a4\uc2a4\ub85c \uace0\ub978 \uc774\ub984\uc744 \ucc98\uc74c \uc0c8\uae34 \uc870\uac01\uc774\ub2e4."
    worldBranchTag: witness:stonevein-foundry
  - kind: 0
    stableId: relic:faction:golem:2
    inGameDescription: "\ud750\ud2b8\ub7ec\uc9c4 \ud575 \uacf5\uba85\uc744 \ud55c \ubc88 \uc548\uc815\uc2dc\ud0a4\ub294 \uc870\uc728\uc1e0\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \ub3cc\ub9e5 \uc870\uc728\uc1e0\ub294 \ud55c \uace8\ub818\uc758 \uae30\uc5b5\uc774 \uc5ec\ub7ec \ubc88 \uc218\ub9ac\ub41c \ubab8\uc744 \uc774\uc5b4 \uac19\uc740 \uc0ac\ub78c\uc73c\ub85c \ub0a8\uacbc\uc74c\uc744 \ubcf4\uc5ec \uc900\ub2e4."
    worldBranchTag: witness:stonevein-foundry
  - kind: 0
    stableId: relic:faction:golem:3
    inGameDescription: "\uac15\uc81c \uba85\ub839\uc744 \uac70\ubd80\ud55c \uccab \uace8\ub818\uc758 \uad00\uc808\uc5d0\uc11c \ub098\uc628 \ud540\uc774\ub2e4. \uc81c4\uc8fc\uc870\ub3c4\uc2dc\uc758 \uccab\uc790\uc720 \uad00\uc808\ud540\uc5d0\ub294 \uc18c\uc720\uc790\uc758 \uc778\uc7a5 \ub300\uc2e0 \uad00\uc808\uc744 \uc120\ud0dd\ud55c \uace8\ub818\uc758 \uc190\uc790\uad6d\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: witness:stonevein-foundry
  - kind: 0
    stableId: relic:faction:harpy:1
    inGameDescription: "\uc678\ubd80\uc778\uc5d0\uac8c \ud558\ub298\uae38 \ud1b5\ud589\uc744 \ud5c8\uac00\ud558\ub294 \uae43\uc778\uc7a5\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uccab\ubc14\ub78c \uae43\uc778\uc7a5\uc740 \ud558\ub298\uae38\uc744 \uc5f0 \uc0ac\ub78c\uc758 \uc774\ub984\uc744 \ub178\ub798\uc640 \ubb38\uc11c \uc591\ucabd\uc5d0 \ub0a8\uae34\ub2e4."
    worldBranchTag: witness:storm-nest
  - kind: 0
    stableId: relic:faction:harpy:2
    inGameDescription: "\uac00\uc7a5 \ud070 \ud3ed\ud48d\uc758 \ucc9c\ub465\uc744 \uae30\ub85d\ud55c \uacf5\uba85 \uae08\uc18d\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud3ed\ud48d\uc74c \uc1f3\uc870\uac01\uc5d0\ub294 \uc624\ub974\ub370\ub098 \ubd09\uc1c4\uc120\uc758 \uad50\ub300 \uc2dc\uac01\uc774 \uc0c8\ubcbd \ud569\ucc3d\uc758 \uc74c\ub192\uc774\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: witness:storm-nest
  - kind: 0
    stableId: relic:faction:harpy:3
    inGameDescription: "\uc2e4\uc885 \uc804\ub839\uc758 \uadc0\ud658 \ub178\ub798\ub97c \uae30\uc5b5\ud558\ub294 \uc791\uc740 \ubc29\uc6b8\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \uadc0\ud658\ub178\ub798 \ubc29\uc6b8\uc740 \ub3cc\uc544\uc628 \uc0ac\ub78c\ubcf4\ub2e4 \ub3cc\uc544\uc624\uc9c0 \ubabb\ud55c \uc0ac\ub78c\uc758 \uc774\ub984\uc744 \uba3c\uc800 \uc6b8\ub9b0\ub2e4."
    worldBranchTag: witness:storm-nest
  - kind: 0
    stableId: relic:faction:kobold:1
    inGameDescription: "\uc124\uacc4\uc790\uac00 \uc9c1\uc811 \uac80\uc0ac\ud588\uc74c\uc744 \uc99d\uba85\ud558\ub294 \ub300\uac00\ub3c4\uc7a5\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uae4a\uc740\ud1b1\ub2c8 \ub300\uac00\ub3c4\uc7a5\uc740 \uacf5\ubc29 \uc18c\uc720\uad8c\uc774 \uc528\uc871\uc5d0\uc11c \uc2e4\uc81c \uc81c\uc791\uc790\uc5d0\uac8c \ub118\uc5b4\uac04 \uc2dc\uc808\uc744 \uc99d\uba85\ud55c\ub2e4."
    worldBranchTag: witness:deep-cog-den
  - kind: 0
    stableId: relic:faction:kobold:2
    inGameDescription: "\uc624\ub798 \uc6c0\uc9c1\uc5ec\ub3c4 \uc624\ucc28\uac00 \uc313\uc774\uc9c0 \uc54a\ub294 \ud76c\uadc0 \ud0dc\uc5fd\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ubb34\uacb0\uc810 \ud0dc\uc5fd\uc5d0\ub294 \uc624\ub974\ub370\ub098 \uad70\uc218 \uaddc\uaca9\uacfc \uc9c0\uc6cc\uc9c4 \ucf54\ubcfc\ud2b8 \uc81c\uc791\uc790 \uc774\ub984\uc774 \uac19\uc740 \uae4a\uc774\ub85c \uc0c8\uaca8\uc838 \uc788\ub2e4."
    worldBranchTag: witness:deep-cog-den
  - kind: 0
    stableId: relic:faction:kobold:3
    inGameDescription: "\uc9c0\uc6cc\uc9c4 \ub3c4\uc81c\uc758 \uc774\ub984\uc744 \ubcf5\uad6c\ud55c \uccab \uba85\ud310\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \ub3c4\uc81c\uba85\ud310 \uc6d0\ubcf8\uc740 \uccab \ub3c4\uad6c \uc774\ub984\uc9d3\uae30 \ub4a4 \uc0ac\ub78c\uc774 \uacf5\ubc29\uc758 \uad8c\ub9ac\uc790\uac00 \ub418\uc5c8\uc74c\uc744 \uae30\ub85d\ud55c\ub2e4."
    worldBranchTag: witness:deep-cog-den
  - kind: 0
    stableId: relic:faction:myconid:1
    inGameDescription: "\ub9d0 \uc5c6\uc774 \uc804\ub2ec\ub41c \uccab \ub3d9\ub9f9 \uae30\uc5b5\uc744 \ub2f4\uc740 \ubcd1\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uccab\ud3ec\uc790 \uae30\uc5b5\ubcd1\uc5d0\ub294 \uc778\uac04\uad70\uc774 \ubd88\ud0dc\uc6b4 \uc815\uc6d0\uacfc \uadf8\uacf3\uc5d0\uc11c \ud53c\uc2e0\uc2dc\ud0a8 \uc0ac\ub78c\ub4e4\uc758 \ub0c4\uc0c8 \uae30\uc5b5\uc774 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: relic:faction:myconid:2
    inGameDescription: "\ubcd1\ub4e0 \uade0\uc0ac\ub9cc \uacf5\uba85\uc73c\ub85c \uad6c\ubd84\ud574 \uc790\ub974\ub294 \uce7c\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uade0\ub9e5 \uc808\ub2e8\uce7c\uc5d0\ub294 \ubcd1\ub4e0 \uade0\uc0ac\ub9cc \ub04a\uc5c8\ub2e4\ub294 \uce58\ub8cc\uc0ac\uc758 \ud45c\uc2dd\uacfc \uc0ac\ub78c\uc744 \ud574\ucce4\ub2e4\ub294 \uc624\ub974\ub370\ub098 \uc555\uc218\ud45c\uac00 \ud568\uaed8 \ubd99\uc5b4 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: relic:faction:myconid:3
    inGameDescription: "\uc870\uc0c1\uade0\uacfc \ubd84\ub9ac\ub41c \uc0c8 \uacf5\ub3d9\uccb4\uc758 \uccab \ubc30\uc591\ud3b8\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc758 \uc0c8\uc815\uc6d0 \ubc30\uc591\ud3b8\uc740 \ud53c\ub09c\ubbfc\uc774 \uac00\uc838\uc628 \ud759\uc5d0\uc11c\ub3c4 \uacf5\ub3d9 \uae30\uc5b5\uc774 \ub2e4\uc2dc \uc790\ub784 \uc218 \uc788\uc74c\uc744 \ubcf4\uc5ec \uc900\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6101
    inGameDescription: "\uc5f0\ud68c \uc2dd\ub2f9\uacfc \uc804\ubb38 \uc81c\uc791\uc744 \uc704\ud55c 2\ub2e8\uacc4 \uc0c1\uc5c5 \ud30c\uce20\ub97c \uc989\uc2dc \ud574\uae08\ud55c\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc0c1\uc5c5 \ud655\uc7a5 \uc124\uacc4\ub3c4\ub294 \uace0\uc815 \uc0c1\uc810\ubcf4\ub2e4 \ud53c\ub09c \ud589\ub82c\uacfc \uc774\ub3d9 \uc7a5\ud130\uac00 \uba3c\uc800 \uc9c0\ub098\uac08 \uc790\ub9ac\ub97c \ub0a8\uae34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6102
    inGameDescription: "\uacbd\ube44 \ub3d9\uc120\uacfc \ubcd1\uc601\uc744 \uac15\ud654\ud558\ub294 \uc804\uc220\u00b7\ubcf4\uc548 \ud30c\uce20\ub97c \uc989\uc2dc \ud574\uae08\ud55c\ub2e4. \uc624\ub974\ub370\ub098\uc758 \uc694\uc0c8\ud654 \uc124\uacc4\ub3c4\ub294 \ubc29\uc5b4\uc120 \uc548\ucabd\uc758 \uc8fc\ubbfc\ubcf4\ub2e4 \uc6b0\ub974\ub2e8 \uad00\ubb38\uc5d0\uc11c \ub4e4\uc5b4\uc624\ub294 \uc801\uc758 \ub3d9\uc120\uc744 \uba3c\uc800 \uadf8\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6103
    inGameDescription: "\uc219\uc18c\u00b7\uc704\uc0dd\u00b7\uc2dd\uc7ac\ub8cc \ubb3c\ub958\ub97c \uac1c\uc120\ud558\ub294 2\ub2e8\uacc4 \uc0dd\ud65c \ud30c\uce20\ub97c \uc989\uc2dc \ud574\uae08\ud55c\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \uc0dd\ud65c \uc9c0\uc6d0 \uc124\uacc4\ub3c4\ub294 \uc11c\ub85c \ub2e4\ub978 \ubab8\uc774 \uac19\uc740 \ubb3c\uacfc \uce68\uc0c1\uc744 \uc4f0\uc9c0 \ubabb\ud560 \ub54c\uc758 \uc6b0\ud68c \uc124\ube44\ub97c \ud568\uaed8 \uadf8\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6104
    inGameDescription: "\uc804\ubb38 \uc5f0\uad6c\uc640 \uc758\uc2dd\u00b7\ub9c8\ub825 \ubb3c\ub958\ub97c \uc704\ud55c 2\ub2e8\uacc4 \ube44\uc804 \ud30c\uce20\ub97c \uc989\uc2dc \ud574\uae08\ud55c\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ube44\uc804 \uc5f0\uad6c \uc124\uacc4\ub3c4\uc5d0\ub294 \ubc1c\uacac\uc758 \uc18c\uc720\uad8c\uacfc \ub9c8\ub098 \uc0ac\uace0\uc758 \ubc30\uc0c1 \ucc45\uc784\uc744 \uc801\ub294 \ube48\uce78\uc774 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6191
    inGameDescription: "\uc9c4\uc5f4\uacfc \ubcf4\uad00 \ubd80\ud488\uc744 \uacb0\ud569\ud574 \uc7a0\uae08\uc9c4\uc5f4\uc7a5\uc73c\ub85c \uac1c\uc870\ud558\ub294 \ud76c\uadc0 \uc870\ud569\uc2dd\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc758 \uc0c1\uad8c \ud1b5\ud569 \uc124\uacc4\ub3c4\ub294 \uc0c1\uc778 \uc870\ud569\uacfc \ub09c\ubbfc \ubc30\uae09\uc18c\uac00 \uac19\uc740 \ucc3d\uace0\ub97c \uc4f0\ub294 \uc2dc\uac04\uc744 \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6192
    inGameDescription: "\uc21c\ucc30 \uccb4\uacc4\uc640 \uc138\ub825 \ud45c\uc2dd\uc744 \uacb0\ud569\ud574 \uc804\ud22c\uae43\ubc1c\uc744 \ub9cc\ub4dc\ub294 \ud76c\uadc0 \uc870\ud569\uc2dd\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc758 \uc804\uc220 \uc9c0\ud718 \uc124\uacc4\ub3c4\ub294 \uc218\ud638\uc6d0, \uac1c\ucc99\uc6d0\uacfc \uc6a9\ubcd1\ub300\uac00 \uc11c\ub85c \ub2e4\ub978 \uba85\ub839\uc744 \ub0b4\ub9b4 \ub54c\uc758 \uc6b0\uc120\uad8c\uc744 \ud45c\uc2dc\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: research-blueprint:6193
    inGameDescription: "\ub8ec \uc548\uc815\uacfc \uc758\uc2dd \uc870\uba85\uc744 \uacb0\ud569\ud574 \uc758\uc2dd\ucd08\uc810\uc11d\uc744 \uc870\uc728\ud558\ub294 \ud76c\uadc0 \uc870\ud569\uc2dd\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ube44\uc804 \uacf5\uba85 \uc124\uacc4\ub3c4\ub294 \uc5ec\ub7ec \uacc4\uc57d\uc790\uc758 \ub9c8\ub098\uac00 \ud55c \uc2dc\uc124\uc5d0\uc11c \ucda9\ub3cc\ud560 \ub54c \ub04a\uc744 \ud68c\ub85c\ub97c \ub530\ub85c \ub454\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:blood
    inGameDescription: "\uc57d\ud488, \ucd09\uc9c4\uc81c\uc640 \uc758\uc2dd \uc7ac\ub8cc\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ud53c\ub294 \uc81c\uacf5\uc790\uc640 \uc6a9\ub3c4\ub97c \uc801\uc740 \uc720\ub9ac\ubcd1\uc5d0 \ub530\ub85c \ub2f4\uace0, \ub3d9\uc758\uc758 \uc794 \uc55e\uc5d0\uc11c \ud655\uc778\ud55c \ubcd1\uc5d0\ub9cc \uac80\uc740 \ubd09\uc778\uc744 \ub2e8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:bloodleaf
    inGameDescription: "\uc18c\ub3c5\uc81c\uc640 \uc804\ud22c \ucd09\uc9c4\uc81c\uc5d0 \uc4f0\ub294 \ubd89\uc740 \uc57d\ucd08\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ud608\uc5fd\uc758 \ubd89\uc740 \uc78e\ub9e5\uc774 \ub0a8\uc544 \uc788\uc744 \ub54c\ub9cc \uc57d\uc7ac\ub85c \ubc1b\uace0, \ube5b\uc774 \ubc14\ub79c \uc78e\uc740 \ud1f4\ube44\ub85c \ub3cc\ub9b0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:bone
    inGameDescription: "\ubb34\uae30 \uc7ac\uc9c8, \uc7a5\uc2e0\uad6c, \ud1f4\ube44\uc640 \uc5f0\uae08 \uc7ac\ub8cc\uc774\ub2e4. \ub77c\uce74\uc26c \uc138\uac08\ub798\uae38\uc5d0\uc11c\ub294 \ubf08\uc758 \uace8\uc218\ub97c \ube80 \ub4a4 \uae38\uc774\uc640 \ud718\uc5b4\uc9d0\uc744 \ubcf4\uace0 \ubb34\uae30\uc6a9\u00b7\uc7a5\uc2e0\uad6c\uc6a9\u00b7\ubd84\uc1c4\uc6a9\uc73c\ub85c \ub098\ub208\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:cave-mushroom
    inGameDescription: "\uc2dd\ubb3c\uc131 \ub2e8\ubc31\uc9c8\uacfc \uc57d\ud6a8 \uc131\ubd84\uc744 \uac00\uc9c4 \uade0\ub958\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ub3d9\uad74\ubc84\uc12f\uc758 \uac13\uc740 \uc74c\uc2dd\uacfc \uc57d\uc7ac\ub85c \uc4f0\uace0, \uc9c8\uae34 \ubc11\ub3d9\uc740 \uc798\uac8c \ucc22\uc5b4 \ub2e4\uc74c \uc7ac\ubc30\uc0c1\uc5d0 \uc11e\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: resource:clean-water
    inGameDescription: "\uae68\ub057\ud55c \ubb3c\uc740 \uc74c\uc6a9\uacfc \uc870\ub9ac, \uc138\ucc99 \ubc0f \uc5ec\ub7ec \uc0dd\uc0b0 \uacf5\uc815\uc5d0 \uacf5\uae09\ud55c\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ub9d1\uc740\ubb3c \ud569\ub958\uac00 \uc5f4\ub9ac\ub294 \ub0a0\uc5d0\ub294 \uae68\ub057\ud55c \ubb3c \uc218\uc870 \uac00\uc7a5\uc790\ub9ac\uc5d0 \uc11c\ub85c \ub2e4\ub978 \uc2ac\ub77c\uc784\uc758 \uc0c9\uc774 \ub465\uae00\uac8c \ub0a8\ub294\ub2e4."
