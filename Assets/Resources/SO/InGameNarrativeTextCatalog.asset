    inGameDescription: "\uc758\ub8cc \ubd84\ub958\ub300\uc5d0\uc11c \ud658\uc790\ub97c \uc0b4\ud53c\uace0 \ud544\uc694\ud55c \ucc98\uce58\ub97c \uc774\uc5b4 \uac08 \uc218 \uc788\uac8c \uafb8\ub9b0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ubbc0\ub124\uc2e4\ub77c\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
