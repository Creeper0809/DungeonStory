    stableId: facility-kit:1047
    inGameDescription: "\uc804\uc220\uc9c0\ub3c4\ud0c1\uc790\uc5d0\uc11c \ucd9c\uc785\uacfc \uc704\ud5d8 \uc9d5\ud6c4\ub97c \uac10\uc2dc\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1048
    inGameDescription: "\uc804\ud22c\uae43\ubc1c\uc5d0\uc11c \ucd9c\uc785\uacfc \uc704\ud5d8 \uc9d5\ud6c4\ub97c \uac10\uc2dc\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc758 \uc2dc\uc124\uacfc\ub3c4 \uccb4\uacb0 \uaddc\uaca9\uc774 \ub9de\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1049
    inGameDescription: "\ud68c\uc218\ud55c \ubb34\uae30\uc640 \uc804\ub9ac\ud488\uc744 \ubd84\ub958\ud574 \ub193\uace0 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uac70\uce58\ub300 \uc124\uce58 \ubd80\ud488\uc774\uba70, \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c\ub3c4 \uac19\uc740 \uaddc\uaca9\uc73c\ub85c \uc870\ub9bd\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1050
    inGameDescription: "\ub300\ud615\ubcf4\uad00\uc120\ubc18\uc5d0 \uc7ac\uace0\ub97c \ubaa8\uc544 \ub450\uace0 \ubc18\ucd9c \uc21c\uc11c\ub97c \uad00\ub9ac\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \ub300\ud615\ubcf4\uad00\uc120\ubc18\uc758 \uac01 \uce78\uc740 \uc528\uc871\ub9c8\ub2e4 \ud1b1\ub2c8 \ubaa8\uc591\uc774 \ub2ec\ub77c \ube4c\ub9b0 \uacf5\uad6c\uac00 \ub3cc\uc544\uac08 \uc790\ub9ac\ub97c \uc190\uc73c\ub85c\ub3c4 \ucc3e\ub294\ub2e4."
