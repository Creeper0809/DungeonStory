    inGameDescription: "\uc0ac\uaca9\uacfc\ub141\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc804\ud22c \ub3d9\uc791\uacfc \uc7a5\ube44 \uc0ac\uc6a9\uc744 \uc5f0\uc2b5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\uba70, \uc544\uc77c\ub77c\uc138\ub77c\uc5d0\uc11c\ub3c4 \uc774 \ubd80\ud488\uc758 \uce58\uc218\ub97c \uc54c\uc544\ubcf8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: facility-kit:1042
    inGameDescription: "\uc911\ub7c9\ud6c8\ub828\uc11d\uc5d0\uc11c \uc8fc\ubbfc\uc774 \uc804\ud22c \ub3d9\uc791\uacfc \uc7a5\ube44 \uc0ac\uc6a9\uc744 \uc5f0\uc2b5\ud558\ub3c4\ub85d \ub9cc\ub4e0 \uc124\uce58 \ubd80\ud488\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc2dd \uc911\ub7c9\ud6c8\ub828\uc11d\uc758 \ubc14\ub2e5\uc5d0\ub294 \uac77\ub294 \uc804\uc0ac\uc640 \ub098\ub294 \uc804\uc0ac\uac00 \uac19\uc740 \ubaa9\ud45c\uc5d0 \ub2ff\ub294 \ub450 \ud6c8\ub828\uc120\uc774 \uadf8\ub824\uc838 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
