    stableId: resource:manure
    inGameDescription: "\ud1f4\ube44, \uc2e4\ub0b4 \uc7ac\ubc30 \uc601\uc591\uc81c\uc640 \uc800\uae09 \uc5f0\ub8cc\uc758 \uc6d0\ub8cc\uc774\ub2e4. \ubbc0\ub124\uc2e4\ub77c\uc5d0\uc11c\ub294 \ubd84\ub1e8\ub97c \ubc14\ub85c \ubc2d\uc5d0 \uc4f0\uc9c0 \uc54a\uace0, \uc5f4\uc774 \uac00\ub77c\uc549\uc744 \ub54c\uae4c\uc9c0 \ub9c8\ub978 \ud480\uacfc \ubc88\uac08\uc544 \uc313\uc544 \ubc1c\ud6a8\uc2dc\ud0a8\ub2e4."
    worldBranchTag: 
