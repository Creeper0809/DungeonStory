    inGameDescription: "\uade0\uc5f4\uc774 \uc0dd\uae30\ub294 \uc9c0\uc810\uc744 \ucc3e\uc544 \uc0c8 \uacb0\ub85c \ub367\ub304 \uc801\ub3d9 \ubd84\ub9d0\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc758 \uc870\uc728\uc0ac\ub294 \uad8c\uc704 \ucd09\ub9e4 \uc9c4\ud589 12 \u00b7 3\ub4f1\uae09\uc744 \uba85\ub839 \uc778\uc7a5\uc744 \uc0c8\uae30\ub294 \uad8c\uc704 \uacc4\ud1b5\uc758 3\ub4f1\uae09 \uac1c\uc870\uc5d0 \uc4f4\ub2e4."
    worldBranchTag: 
  - kind: 0
