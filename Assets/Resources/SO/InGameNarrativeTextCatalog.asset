%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 91f5ac8634284c64aa024a2238bab740, type: 3}
  m_Name: InGameNarrativeTextCatalog
  m_EditorClassIdentifier: DungeonStory.Content::InGameNarrativeTextCatalogSO
  entries:
  - kind: 0
    stableId: ammo:armor-piercing-cartridge
    inGameDescription: "\ub2e8\ub2e8\ud55c \ud0c4\uc790\ub97c \ub123\uc5b4 \ud310\uae08\uacfc \ub450\uaebc\uc6b4 \ubc29\ud638\uad6c\ub97c \ub6ab\ub294 \ub370 \ub9de\ucd98 \ucca0\uac11 \ud0c4\uc57d\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc5d0\uc11c \uc9c0\uae09\ud55c \ucca0\uac11 \ud0c4\uc57d\uc740 \ud0c4\ud53c \ubc11\uba74\uc5d0 \uad70\uc601 \ubc88\ud638\uac00 \ucc0d\ud600 \uc788\ub2e4. \ud0c8\uc601\ubcd1\uc740 \uadf8 \ubc88\ud638\ubd80\ud130 \uae01\uc5b4\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:arrow
    inGameDescription: "\ud65c\uc5d0 \uba54\uaca8 \uc3d8\ub294 \uae30\ubcf8 \ud654\uc0b4\ub85c, \ubc1c\uc0ac\ud55c \ub4a4\uc5d0\ub294 \ud68c\uc218\ud560 \uc218 \uc5c6\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc81c \ud654\uc0b4\uc5d0\ub294 \ud6a1\ud48d \ucabd\uc73c\ub85c \ud55c \uce58 \ube44\uaef4 \uc7a1\ub294 \uc190\uc790\uad6d\uc774 \ub2f3\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:arrow-bone
    inGameDescription: "\ubf08\ub97c \uae4e\uc740 \uac00\ubcbc\uc6b4 \ucd09\uc744 \ub2ec\uc544 \uac12\uc740 \ub0ae\ucdc4\uc9c0\ub9cc \uad00\ud1b5\ub825\ub3c4 \ub0ae\uc740 \ud654\uc0b4\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc758 \ud478\ub978 \uae43\ub9e4\ub4ed\uc740 \ubf08\ucd09 \ud654\uc0b4\uc774 \ubc14\ub78c \uc808\ubcbd\uc758 \uc138 \ud6a1\ud48d\uc744 \ubc84\ud17c\ub2e4\ub294 \ud45c\uc2dc\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:arrow-iron
    inGameDescription: "\ucca0\ucd09\uc758 \ubb34\uac8c\uc640 \ub0a0\uac01\uc744 \ud45c\uc900\uc5d0 \ub9de\ucdb0 \ud53c\ud574\uc640 \uad00\ud1b5\uc758 \uade0\ud615\uc744 \uc7a1\uc740 \ud654\uc0b4\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c \uc0ac\uc218\ub294 \ucca0\ucd09 \ud654\uc0b4\uc744 \uc3d8\uae30 \uc804 \ubc14\ub78c\uc758 \ubc29\ud5a5\uc744 \uc9e7\uac8c \ub178\ub798\ud55c\ub2e4. \ub9c8\uc9c0\ub9c9 \uc74c\uc774 \ubc1c\uc0ac \uc2e0\ud638\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:arrow-rune
    inGameDescription: "\ubfd4\ub85c \ub9cc\ub4e0 \ucd09\uacfc \ub9c8\ub098 \uac01\uc778\uc744 \uacb0\ud569\ud574 \ube44\uc804 \ud45c\uc801\uc744 \uaca8\ub204\ub294 \ud654\uc0b4\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec\ucd09 \ud654\uc0b4 \uc790\ub8e8 \ub05d\uc5d0\ub294 \uc0ac\uc6a9\uc790\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ud558\ub098\uc529 \ub204\ub978 \uc30d\uc778\uc7a5\uc774 \ub0a8\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:arrow-steel
    inGameDescription: "\uac15\ucca0\ucd09\uc744 \ub2e8\ub2e8\ud788 \uace0\uc815\ud574 \uc911\uc7a5\uac11\uc758 \ud2c8\uc744 \ub178\ub9ac\ub294 \uace0\uad00\ud1b5 \ud654\uc0b4\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c \uc0ac\uc218\ub294 \uac15\ucca0\ucd09 \ud654\uc0b4\uc744 \uc3d8\uae30 \uc804 \ubc14\ub78c\uc758 \ubc29\ud5a5\uc744 \uc9e7\uac8c \ub178\ub798\ud55c\ub2e4. \ub9c8\uc9c0\ub9c9 \uc74c\uc774 \ubc1c\uc0ac \uc2e0\ud638\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:blacksteel-bolt
    inGameDescription: "\ud751\uac15 \ucd09\uc758 \ubb34\uac8c\ub97c \uad75\uc740 \uc790\ub8e8\uac00 \ubc1b\uccd0 \ub2e8\ub2e8\ud55c \ud45c\uc801\uc744 \uaff0\ub6ab\ub294 \uc11d\uad81 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \ud751\uac15 \ubcfc\ud2b8\ub294 \uc881\uc740 \uac31\ub3c4\uc5d0\uc11c\ub3c4 \uaebc\ub0b4\uae30 \uc27d\ub3c4\ub85d \uc790\ub8e8\uc640 \uaf2c\ub9ac\uae43\uc744 \uc9e7\uac8c \ub9de\ucd98\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:blasting-charge
    inGameDescription: "\uc554\ubc18\uacfc \uad6c\uc870\ubb3c\uc744 \uae68\ub728\ub9ac\ub3c4\ub85d \ud654\uc57d\uc744 \ud55c \ubc88\uc758 \ud3ed\ubc1c\ub7c9\uc73c\ub85c \ubc00\ubd09\ud55c \uc7a5\uc57d\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc5d0\uc11c \uc9c0\uae09\ud55c \ubc1c\ud30c \uc7a5\uc57d \ud3ec\uc7a5\uc5d0\ub294 \ud3ed\uc57d\ub7c9\uacfc \uc548\uc804 \uac70\ub9ac\uac00 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:bolt
    inGameDescription: "\uc11d\uad81\uc758 \uc9e7\uace0 \uac15\ud55c \uc2dc\uc704\uc5d0 \ub9de\ucd98 \uad75\uace0 \ubb34\uac70\uc6b4 \uae30\ubcf8 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \ubcfc\ud2b8\ub294 \uc881\uc740 \uac31\ub3c4 \ubcbd\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \uc790\ub8e8\uc640 \uaf2c\ub9ac\uae43\uc744 \uc9e7\uac8c \ub9cc\ub4e0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:bolt-bone
    inGameDescription: "\uac00\ubcbc\uc6b4 \ubf08\ucd09\uc744 \ub2ec\uc544 \uc11d\uad81 \uc7a5\uc804\uacfc \uc0ac\uaca9\uc744 \uc775\ud790 \ub54c \uc4f0\ub294 \uc5f0\uc2b5\uc6a9 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uc740 \ubf08\ucd09 \ubcfc\ud2b8\uac00 \ubc1c\uc0ac \uc2dc\ud5d8\uc744 \ubc84\ud17c\ub2e4\ub294 \ud45c\uc2dc\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:bolt-iron
    inGameDescription: "\ucca0\ucd09\uacfc \uc9e7\uc740 \uc790\ub8e8\uc758 \ubb34\uac8c\ub97c \ub9de\ucd98 \ud45c\uc900 \uc11d\uad81 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc2dd \ucca0\ucd09 \ubcfc\ud2b8\ub294 \uc881\uc740 \uac31\ub3c4 \ubcbd\uc5d0 \uac78\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \uc790\ub8e8\uc640 \uaf2c\ub9ac\uae43\uc744 \uc9e7\uac8c \ub9cc\ub4e0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:bolt-rune
    inGameDescription: "\ucd09\uc5d0 \uc0c8\uae34 \ub8ec\uc774 \ube44\uc804 \ubc29\ud638\ub97c \ud750\ud2b8\ub7ec\ub728\ub9ac\ub3c4\ub85d \uc870\uc728\ud55c \uc11d\uad81 \ubcfc\ud2b8\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub8ec\ucd09 \ubcfc\ud2b8 \uc790\ub8e8 \ub05d\uc5d0\ub294 \uc0ac\uc6a9\uc790\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ud558\ub098\uc529 \ub204\ub978 \uc30d\uc778\uc7a5\uc774 \ub0a8\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:bolt-steel
    inGameDescription: "\uac15\ucca0\ucd09\uacfc \uad75\uc740 \uc790\ub8e8\ub85c \uc911\uc7a5\uac11\uc744 \uaca8\ub204\ub294 \uace0\uad00\ud1b5 \uc11d\uad81 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \uac15\ucca0\ucd09 \ubcfc\ud2b8\ub294 \uc881\uc740 \uac31\ub3c4\uc5d0\uc11c\ub3c4 \uaebc\ub0b4\uae30 \uc27d\ub3c4\ub85d \uc790\ub8e8\uc640 \uaf2c\ub9ac\uae43\uc744 \uc9e7\uac8c \ub9de\ucd98\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:incendiary-arrow
    inGameDescription: "\ucd09 \ub4a4\uc758 \uc18c\uc774\uc81c\ub97c \ucda9\ub3cc\uacfc \ud568\uaed8 \ud130\ub728\ub824 \ubd88\uc744 \uc62e\uae30\ub294 \ud654\uc0b4\uc774\ub2e4. \uc544\uc77c\ub77c\uc138\ub77c\uc81c \uc18c\uc774 \ud654\uc0b4\uc5d0\ub294 \ud6a1\ud48d \ucabd\uc73c\ub85c \ud55c \uce58 \ube44\uaef4 \uc7a1\ub294 \uc190\uc790\uad6d\uc774 \ub2f3\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:incendiary-bolt
    inGameDescription: "\uc11d\uad81\uc758 \ud798\uc73c\ub85c \uc18c\uc774\uc81c\ub97c \ud45c\uc801 \uae4a\uc219\uc774 \ubc15\uc544 \ub123\ub294 \uc810\ud654 \ubcfc\ud2b8\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc758 \uc77c\uacf1 \ud1b1\ub2c8 \uc790\uad6d\uc740 \uc18c\uc774 \ubcfc\ud2b8\uac00 \ubc1c\uc0ac \uc2dc\ud5d8\uc744 \ubc84\ud17c\ub2e4\ub294 \ud45c\uc2dc\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:mana-disruptor-bolt
    inGameDescription: "\uac01\uc778\ub41c \ucd09\uc774 \ub9de\uc740 \uc790\ub9ac\uc758 \ub9c8\ub098 \ud750\ub984\uc744 \ud754\ub4e4\ub3c4\ub85d \ub9cc\ub4e0 \ud2b9\uc218 \ubcfc\ud2b8\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \ub9c8\ub098 \ucc28\ub2e8 \ubcfc\ud2b8 \uc790\ub8e8 \ub05d\uc5d0\ub294 \uc0ac\uc6a9\uc790\uc640 \ub9c8\ub098 \uc81c\uacf5\uc790\uac00 \ud558\ub098\uc529 \ub204\ub978 \uc30d\uc778\uc7a5\uc774 \ub0a8\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:paper-cartridge
    inGameDescription: "\ud654\uc57d\uacfc \ud0c4\uc790\ub97c \uc885\uc774 \ud55c \ubd09\uc5d0 \ub2f4\uc544 \ud654\uc2b9\ucd1d\uc758 \uc7ac\uc7a5\uc804\uc744 \uc904\uc774\ub294 \ud0c4\uc57d\ud1b5\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc2dd \uc885\uc774 \ud0c4\uc57d\ud1b5\uc740 \uc811\uc740 \ub05d\uc5d0 \uad70\uc601 \ubc88\ud638\ub97c \ucc0d\uc5b4 \uc816\uac70\ub098 \ucc22\uc5b4\uc9c4 \ubb3c\ub7c9\uc744 \uac00\ub824\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:rune-cartridge
    inGameDescription: "\ud0c4\uc790\uc640 \ud654\uc57d \uc0ac\uc774\uc5d0 \ub8ec \ub9e4\uac1c\uc7ac\ub97c \ub123\uc5b4 \ube44\uc804 \ubc18\uc751\uc744 \uc77c\uc73c\ud0a4\ub294 \ud0c4\uc57d\ud1b5\uc774\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \ub8ec \ud0c4\uc57d\ud1b5\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:scatter-cartridge
    inGameDescription: "\uc791\uc740 \ud0c4\uc790\ub97c \uc5ec\ub7ec \uac1c \ub123\uc5b4 \uac00\uae4c\uc6b4 \ubc94\uc704\uc5d0 \ud37c\ub728\ub9ac\ub294 \uc0b0\ud0c4 \ud0c4\uc57d\uc774\ub2e4. \uc624\ub974\ub370\ub098 \uad70\uc601\uc5d0\uc11c \ud480\ub9b0 \uc0b0\ud0c4 \ud0c4\uc57d\uc5d0\ub294 \ubd89\uc740 \ubd09\ub78d\uacfc \uc9c0\uc6cc\uc9c4 \uc9c0\uae09 \ubc88\ud638\uac00 \ub098\ub780\ud788 \ub0a8\uc544 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:signal-flare
    inGameDescription: "\ubc1d\uc740 \ubd88\ube5b\uacfc \uc5f0\uae30\ub97c \ub192\uc774 \uc62c\ub824 \uba3c \uacbd\ube44\ub300\uc640 \uc6d0\uc815\ub300\uc5d0 \uc704\uce58\ub97c \uc54c\ub9b0\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c\ub294 \uc2e0\ud638\ud0c4 \ud3ec\uc7a5\uc0c9\uc73c\ub85c \ubd88\uae38, \uce68\uc785\uacfc \uad6c\uc870 \uc694\uccad\uc744 \uad6c\ubd84\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:smoke-cartridge
    inGameDescription: "\ub9de\uc740 \uc790\ub9ac\uc5d0 \uc9d9\uc740 \uc5f0\ub9c9\uc744 \ud3bc\uccd0 \uc2dc\uc57c\uc640 \uc0ac\uc120\uc744 \ub04a\ub294 \ud0c4\uc57d\uc774\ub2e4. \uc624\ub974\ub370\ub098\uc5d0\uc11c \uc9c0\uae09\ud55c \uc5f0\ub9c9 \ud0c4\uc57d \uac89\uba74\uc5d0\ub294 \uc5f0\ub9c9\uc774 \ud37c\uc9c0\ub294 \uac70\ub9ac\uc640 \uc9c0\uc18d \uc2dc\uac04\uc774 \ucc0d\ud600 \uc788\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:tranquilizer-dart
    inGameDescription: "\uc57d\ubb3c\uc744 \ub123\uc740 \uac00\ub294 \uce68\uc73c\ub85c \uc57c\uc0dd\ub3d9\ubb3c\uacfc \ud3ec\ud68d \ub300\uc0c1\uc744 \uc9c4\uc815\uc2dc\ud0a4\ub294 \ub2e4\ud2b8\ub2e4. \ubb34\uae30 \ucca0\uc57c\ub97c \uc9c0\ud0a4\ub294 \ud558\ub974\ub098\ud06c \uc0ac\ub0e5\uafbc\uc740 \uc9c4\uc815 \ub2e4\ud2b8\uc758 \uae43 \uc0c9\uc73c\ub85c \uc57d\ubb3c\uc758 \uc138\uae30\uc640 \uc0ac\uc6a9 \ub300\uc0c1\uc744 \uad6c\ubd84\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: ammo:trap-canister
    inGameDescription: "\ud568\uc815 \uc7a5\uce58 \uc548\uc5d0 \ub07c\uc6cc \uc811\uadfc\ud55c \uc801\uc5d0\uac8c \uc0b0\ud0c4\uc744 \ud37c\ubd93\ub294 \ubc00\ud3d0 \ud0c4\ud1b5\uc774\ub2e4. \ud558\ub974\ub098\ud06c\uc758 \ubb34\uae30 \ucca0\uc57c\uc5d0\uc11c\ub294 \ud568\uc815 \uc0b0\ud0c4\ud1b5\uc758 \ud648 \uc218\ub85c \uc7a5\uc804 \ubc29\ud5a5\uacfc \ud37c\uc9c0\ub294 \ubc94\uc704\ub97c \ud655\uc778\ud55c\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:apron
    inGameDescription: "\uc637\uc790\ub77d \uc55e\uc744 \ub36e\uc5b4 \uc74c\uc2dd\ubb3c\uacfc \uc791\uc5c5 \ucc0c\uaebc\uae30\uac00 \uc548\ucabd \uc637\uc5d0 \ub2ff\ub294 \uac83\uc744 \uc904\uc778\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \uc55e\uce58\ub9c8\ub294 \uad11\uc11d \uac00\ub8e8\uc640 \ubd88\ud2f0\uac00 \uc637 \uc548\uc73c\ub85c \uc2a4\ubbf8\uc9c0 \uc54a\ub3c4\ub85d \uc55e\uc136\uc744 \ub450\uaecd\uac8c \uc9e0\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:belt
    inGameDescription: "\ud5c8\ub9ac\ub97c \uc870\uc774\uace0 \uc791\uc740 \ub3c4\uad6c\ub098 \uc8fc\uba38\ub2c8\ub97c \uac78 \uc218 \uc788\ub294 \ud2bc\ud2bc\ud55c \ub760\ub2e4. \ud06c\ub9ad \uc81c7\uad74\uc5d0\uc11c \ub9cc\ub4e0 \ud5c8\ub9ac\ub760\ub294 \ub9dd\uce58\uc640 \ub4f1\ubd88\uc744 \ud568\uaed8 \uac78\uc5b4\ub3c4 \ud480\ub9ac\uc9c0 \uc54a\ub3c4\ub85d \uace0\ub9ac\ub97c \ub450 \ubc88 \ubc15\ub294\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:blouse
    inGameDescription: "\ubaa9\uacfc \uc190\ubaa9\uc5d0 \uc5ec\uc720\ub97c \ub454 \uac00\ubcbc\uc6b4 \uc717\uc637\uc73c\ub85c, \uc77c\uc0c1\ubcf5 \uc548\ud30e\uc5d0 \uacb9\uccd0 \uc785\ub294\ub2e4. \ud558\ub974\ub098\ud06c\uc5d0\uc11c \ub9cc\ub4e0 \ube14\ub77c\uc6b0\uc2a4\ub294 \ub0a0\uac1c\uc640 \ub113\uc740 \uc5b4\uae68\uc5d0 \ub9de\ucdb0 \ub4f1\uc194\uae30\ub97c \uace0\uce58\uae30 \uc27d\ub3c4\ub85d \uc5ec\uc720 \ucc9c\uc744 \ub0a8\uae34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:boots
    inGameDescription: "\uc9c4\ud759\uacfc \uac70\uce5c \ubc14\ub2e5\uc744 \ubc1f\uc744 \ub54c \ubc1c\ubaa9\uae4c\uc9c0 \uac10\uc2f8\ub294 \uc7a5\ud654\ub2e4. \ud558\ub974\ub098\ud06c\uc5d0\uc11c \ub9cc\ub4e0 \uc7a5\ud654\ub294 \ubc1c\ub05d\uacfc \ubc1c\ubaa9 \ub458\ub808\ub97c \ub367\ub300\uae30 \uc27d\ub3c4\ub85d \uc5ec\uc720 \ucc9c\uc744 \ub0a8\uae34\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:ceremonial-dress
    inGameDescription: "\uacf5\ub3d9\uccb4\uc758 \ud070 \uc758\uc2dd\uc5d0\uc11c \uc785\ub294 \uae34 \ub4dc\ub808\uc2a4\ub85c, \uc6c0\uc9c1\uc784\ubcf4\ub2e4 \uaca9\uc2dd\uc744 \uc55e\uc138\uc6b4 \uc7ac\ub2e8\uc774\ub2e4. \ubca0\ub974\uc0ac\ub514\uc628\uc758 \uc608\ubcf5 \ub4dc\ub808\uc2a4\ub294 \ub9e4\ub4ed \uc218\ub85c \uacc4\uc57d \ub2f9\uc0ac\uc790\ub97c, \uc548\uac10 \uc0c9\uc73c\ub85c \uc99d\uc778\uacfc \uc560\ub3c4 \uae30\uac04\uc744 \ub4dc\ub7ec\ub0b8\ub2e4."
    worldBranchTag: 
  - kind: 0
    stableId: apparel:chest-wrap
