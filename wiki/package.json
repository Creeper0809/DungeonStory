{
  "name": "wiki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "model": "python -X utf8 ../Tools/Wiki/generate_wiki_model.py --repo-root .. --game-version 0.0.1v",
    "validate:model": "python -X utf8 ../Tools/Wiki/validate_wiki_model.py --repo-root .. --game-version 0.0.1v",
    "validate:authority": "python -X utf8 ../Tools/Wiki/validate_document_authority.py --repo-root .. --game-version 0.0.1v",
    "validate:coverage": "python -X utf8 ../Tools/Wiki/validate_source_coverage.py --repo-root .. --game-version 0.0.1v",
    "verify:determinism": "python -X utf8 ../Tools/Wiki/verify_wiki_determinism.py --repo-root .. --game-version 0.0.1v",
    "test:markdown": "node --test ./tests/guide-markdown.test.mjs",
    "audit": "npm run validate:model && npm run validate:authority && npm run validate:coverage && npm run test:markdown && npm run check",
    "check": "astro check",
    "build": "python -X utf8 ../Tools/Wiki/build_wiki.py --repo-root .. --game-version 0.0.1v",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "astro": "^7.2.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3"
  }
}
