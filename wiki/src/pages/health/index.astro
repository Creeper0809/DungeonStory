---
import BaseLayout from '../../components/BaseLayout.astro';
import AnatomyIndexContent from '../../components/AnatomyIndexContent.astro';
import { getAnatomyReferences, getCurrentVersion } from '../../lib/wiki-data';

const version = getCurrentVersion();
const references = getAnatomyReferences(version);
---

<BaseLayout title="신체 구조" description="부위·장기·출혈과 치료를 다루는 건강 세부 문서" version={version}>
  <AnatomyIndexContent references={references} version={version} />
</BaseLayout>
