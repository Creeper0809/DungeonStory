  branch: 'M6 4v16 M6 8h6a4 4 0 0 1 4 4v8 M12 8V4',
  camp: 'M3 19 12 4l9 15 M6 19h12 M12 4v15',
  compass: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm3 6-2 5-5 2 2-5 5-2Z',
  crate: 'M4 7 12 3l8 4v10l-8 4-8-4Z M4 7l8 4 8-4 M12 11v10',
  flow: 'M4 7h9l-2-2 M13 7l-2 2 M20 17h-9l2-2 M11 17l2 2',
  grid: 'M4 4h6v6H4z M14 4h6v6h-6z M4 14h6v6H4z M14 14h6v6h-6z',
  hammer: 'm14 5 5 5-3 3-5-5 M13 6 5 14l5 5 8-8',
  history: 'M4 12a8 8 0 1 0 2-5.3 M4 4v5h5 M12 7v5l3 2',
  home: 'm3 11 9-8 9 8v9h-6v-6H9v6H3z',
  people: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8-1a2.5 2.5 0 1 0 0-5 M2 20a6 6 0 0 1 12 0 M14 20a5 5 0 0 1 7-3',
  health: 'M10 4h4l1 5 5 1v4l-5 1-1 5h-4l-1-5-5-1v-4l5-1Z',
  research: 'M9 3h6 M10 3v6l-4 7a4 4 0 0 0 3.5 5h5A4 4 0 0 0 18 16l-4-7V3 M8 16h8',
  resource: 'M5 5h14v14H5z M8 8h8 M8 12h8 M8 16h5',
  search: 'm20 20-4.5-4.5 M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z',
  signal: 'M12 3v12 M8 19h8 M5 7a10 10 0 0 1 14 0 M2 4a14 14 0 0 1 20 0',
  sword: 'm6 3 6 6 M10 5 4-2 2 4 M12 9 4 4-9 9-4-4 9-9 M4 20l3-3',
};
const path = paths[name] ?? paths.grid;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {label && <title>{label}</title>}
  <path d={path} />
</svg>
