---
import { entityHref, type Relation, type WikiEntity } from '../lib/wiki-data';

interface Props {
  context: Pick<WikiEntity, 'kind' | 'slug'>;
  recipes: WikiEntity[];
  version?: string;
}

interface RecipeView {
  facts: WikiEntity['facts'];
  inputs: Relation[];
  outputs: Relation[];
  recipe: WikiEntity;
  research: Relation[];
  role: string | null;
}

const { context, recipes, version } = Astro.props;
const visibleRecipes = recipes.filter((recipe) => recipe.spoiler_tier === 'none');
const hiddenCount = recipes.length - visibleRecipes.length;

const roleFor = (recipe: WikiEntity): string | null => {
  if (context.kind === 'recipe') return null;
  const relation = recipe.relations.find((candidate) =>
    candidate.target_kind === context.kind && candidate.target_slug === context.slug
  );
  if (!relation) return null;
  if (relation.type === 'produces-or-unlocks') return context.kind === 'research' ? '이 연구를 해금' : '이 항목을 생산';
  if (relation.type === 'requires') return context.kind === 'research' ? '이 연구가 필요' : '이 항목을 재료로 사용';
  return null;
};

const views: RecipeView[] = visibleRecipes.map((recipe) => {
  if (recipe.kind !== 'recipe') throw new Error(`RecipeSection only accepts recipe entities: ${recipe.kind}/${recipe.slug}`);
  return {
    facts: recipe.facts.filter((fact) => fact.label !== '필요 연구'),
    inputs: recipe.relations.filter((relation) => relation.type === 'requires' && relation.target_kind !== 'research'),
    outputs: recipe.relations.filter((relation) => relation.type === 'produces-or-unlocks' && relation.target_kind !== 'research'),
    recipe,
    research: recipe.relations.filter((relation) => relation.type === 'requires' && relation.target_kind === 'research'),
    role: roleFor(recipe),
  };
});

const relationHref = (relation: Relation) => entityHref({ kind: relation.target_kind, slug: relation.target_slug }, version);
const amountText = (relation: Relation) => relation.amount ? `${relation.amount}개` : '';
---

<section class="recipe-section" aria-labelledby="recipe-section-title">
  <div class="section-heading section-heading--inline">
    <h2 id="recipe-section-title">조합식</h2>
    <span>{visibleRecipes.length}개</span>
  </div>
  <div class="recipe-list">
    {views.map(({ facts, inputs, outputs, recipe, research, role }) => (
      <article class="recipe-card">
        {context.kind !== 'recipe' && (
          <header class="recipe-card__header">
            <h3><a href={entityHref(recipe, version)}>{recipe.title}</a></h3>
            {role && <span>{role}</span>}
          </header>
        )}
        <div class="recipe-flow" aria-label={`${recipe.title} 재료와 결과`}>
          <div class="recipe-flow__side">
            <strong>재료</strong>
            {inputs.length > 0
              ? <ul>{inputs.map((input) => <li><a href={relationHref(input)}>{input.target_title}</a><span>{amountText(input)}</span></li>)}</ul>
              : <p>소모 재료 없음</p>}
          </div>
          <span class="recipe-flow__arrow" aria-hidden="true">→</span>
          <div class="recipe-flow__side">
            <strong>결과</strong>
            {outputs.length > 0
              ? <ul>{outputs.map((output) => <li><a href={relationHref(output)}>{output.target_title}</a><span>{amountText(output)}</span></li>)}</ul>
              : <p>남는 결과물 없음</p>}
          </div>
        </div>
        {(facts.length > 0 || research.length > 0) && (
          <dl class="recipe-card__facts">
            {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
            {research.length > 0 && <div><dt>필요 연구</dt><dd>{research.map((entry, index) => <>{index > 0 && ', '}<a href={relationHref(entry)}>{entry.target_title}</a></>)}</dd></div>}
          </dl>
        )}
      </article>
    ))}
  </div>
  {hiddenCount > 0 && <p class="spoiler-hint">스포일러가 될 수 있는 조합식 {hiddenCount}개는 기본 표시에서 숨긴다.</p>}
</section>
